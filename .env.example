NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=sb_secret_server-only

# Supabase Auth - Discord login
# Zet Discord in supabase/config.toml pas op enabled = true wanneer deze waarden ingevuld zijn.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# YouTube OAuth (server-only)
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
CRON_SECRET=replace-with-a-long-random-value

# Meta Business OAuth voor Facebook en Instagram (server-only)
META_APP_ID=
META_APP_SECRET=
# Vul bewust de actieve Graph API-versie uit het Meta-dashboard in, bijvoorbeeld vXX.X
META_GRAPH_API_VERSION=

# Threads OAuth (afzonderlijke appgegevens, server-only)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Twitch OAuth (server-only)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AI Gateway (optioneel; server-only)
AI_GATEWAY_API_KEY=

# Google Workspace (server-only; nooit NEXT_PUBLIC_ gebruiken)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_USER_EMAIL=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_TEMPLATE_MINUTES_ID=
GOOGLE_TEMPLATE_SPONSOR_REPORT_ID=
GOOGLE_TEMPLATE_EVENT_ID=
GOOGLE_TEMPLATE_SPONSOR_PITCHDECK_ID=

# Alleen-lezen social export (server-only; aparte sleutel van minimaal 32 tekens)
SOCIAL_EXPORT_API_KEY=
SOCIAL_EXPORT_ORGANIZATION_ID=

# ChatGPT MCP + OAuth (server-only; uit tot configuratie en database-migratie klaar zijn)
SOCIAL_MCP_ENABLED=false
SOCIAL_MCP_ORIGIN=https://cc-dev.belgianstreamerscommunity.be
SOCIAL_MCP_SIGNING_KEY=
# Exacte callback-URL uit ChatGPT; meerdere expliciete URLs scheiden met komma, geen wildcards
SOCIAL_MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
