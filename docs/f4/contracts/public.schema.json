          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sponsor",
              "esports",
              "community",
              "event",
              "education",
              "social_impact"
            ]
          }
        },
        "website_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "logo": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "public_media_id",
                "alt",
                "credit"
              ],
              "properties": {
                "public_media_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "credit": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
