{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:besc:f4:public-proposal:v1",
  "title": "F4 public DTO proposal; authorization and sanitization remain server obligations",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "public_id",
        "revision",
        "slug",
        "locale",
        "published_at",
        "valid_until",
        "display_name",
        "bio",
        "platform_links",
        "disciplines",
        "languages",
        "avatar"
      ],
      "properties": {
        "schema_version": {
          "const": "besc-platform-publication-v1"
        },
        "type": {
          "const": "creator"
        },
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "slug": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "locale": {
          "enum": [
            "nl-BE",
            "fr-BE",
            "en"
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "platform_links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "url"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "twitch",
                  "youtube",
                  "kick",
                  "tiktok"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              }
            }
          }
        },
        "disciplines": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        },
        "avatar": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "public_media_id",
                "alt",
                "credit"
              ],
              "properties": {
                "public_media_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "credit": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
