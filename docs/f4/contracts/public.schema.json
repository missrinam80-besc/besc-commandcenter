        "public_id",
        "revision",
        "slug",
        "locale",
        "published_at",
        "valid_until",
        "name",
        "description",
        "roles",
        "website_url",
        "logo"
      ],
      "properties": {
        "schema_version": {
          "const": "besc-platform-publication-v1"
        },
        "type": {
          "const": "partner"
        },
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
