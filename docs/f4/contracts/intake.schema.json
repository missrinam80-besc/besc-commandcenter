{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:besc:f4:intake-proposal:v1",
  "title": "Private application envelopes; actor and organization are server-derived",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "category",
        "profile_proposal",
        "purpose_version_id",
        "privacy_notice_version"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "const": "creator_profile"
        },
        "profile_proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_name",
            "bio",
            "platform_links"
          ],
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "bio": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "platform_links": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "platform",
                  "url"
                ],
                "properties": {
                  "platform": {
                    "enum": [
                      "twitch",
                      "youtube",
                      "kick",
                      "tiktok"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        "purpose_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "privacy_notice_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "category",
        "organization_name",
        "requested_roles",
        "message",
        "privacy_notice_version"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "const": "partnership"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "requested_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sponsor",
              "esports",
              "community",
              "event",
              "education",
              "social_impact"
            ]
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "privacy_notice_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "category",
        "vacancy_public_id",
        "motivation",
        "availability",
        "privacy_notice_version"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "const": "volunteer_application"
        },
        "vacancy_public_id": {
          "type": "string",
          "format": "uuid"
        },
        "motivation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "availability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "privacy_notice_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  ]
}
