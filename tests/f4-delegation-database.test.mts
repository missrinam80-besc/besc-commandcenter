import test from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {f1Database,q,j} from './helpers/f1-database.mts';
import {delegationOwnSchema} from '../src/lib/delegation-contract.ts';
test('Delegation: exact partner/account scope, private proposal, independent publication and revocation',async()=>{
 const f=await f1Database();try{
 const sessions=new Map<string,string>();for(const u of [f.ids.chair,f.ids.member,f.ids.reviewer]){const id=randomUUID();sessions.set(u,id);await f.owner();await f.db.exec(`update auth.users set email_confirmed_at=now()where id=${q(u)};insert into auth.sessions(id,user_id)values(${q(id)},${q(u)});`);}
 const actor=async(u:string)=>{await f.owner();await f.actor(u);await f.db.exec(`select set_config('request.jwt.claims',${q(JSON.stringify({sub:u,role:'authenticated',session_id:sessions.get(u)}))},false)`);};
 const site=randomUUID(),until=new Date(Date.now()+3600000).toISOString(),key='TESTFIXTURE delegation key never live';await f.owner();await f.db.exec(`update public.partners set status='active',website='https://example.invalid',email='PRIVATE@example.invalid',notes='PRIVATE CONTRACT'where id=${q(f.ids.partner)};insert into public.publication_sites(id,organization_id,host,active,key_sha256,created_by)values(${q(site)},${q(f.ids.org)},'website-dev.belgianstreamerscommunity.be',true,${q(createHash('sha256').update(key).digest('hex'))},${q(f.ids.chair)});update public.organization_members set status='pending'where user_id=${q(f.ids.member)}and organization_id=${q(f.ids.org)};`);
 const workflow=async(name:string,op:string,data:unknown,id=randomUUID())=>(await f.db.query<{v:{id:string}}>(`select public.${name}(${q(site)},${q(op)},${j(data)},${q(id)})v`)).rows[0].v;
 const call=(op:string,data:unknown,id=randomUUID())=>workflow('f4_delegation_workflow',op,data,id);
 const me=async(id?:string)=>delegationOwnSchema.parse((await f.db.query<{v:unknown}>(`select public.f4_delegation_me(${q(site)},${id?q(id):'null'})v`)).rows[0].v);
 await actor(f.ids.chair);const grant=await workflow('f4_workflow','access.assign',{person_id:f.ids.otherPerson,proof_document_id:f.ids.proof,valid_until:until,may_view:false});await call('site.configure',{enabled:true,reason:'TESTFIXTURE'});
 const d=await call('delegation.assign',{partner_id:f.ids.partner,person_id:f.ids.otherPerson,proof_document_id:f.ids.policyDoc,valid_until:new Date(Date.now()+1800000).toISOString()});
 await actor(f.ids.member);const own=await me();assert.equal(own.delegations.length,1);assert(!JSON.stringify(own).includes('PRIVATE'));assert(!JSON.stringify(own).includes('partner_id'));assert(!JSON.stringify(own).includes('proof_document_id'));await assert.rejects(me(randomUUID()),/not_authorized/);await assert.rejects(f.db.query('select * from private.partner_delegations'),/permission denied/);
 const payload={name:own.delegations[0].partner.name,website_url:own.delegations[0].partner.website_url,description:'TESTFIXTURE NIET PUBLICEREN'};
 const request=randomUUID(),p=await call('proposal.save',{delegation_id:d.id,expected_revision:0,payload},request);assert.deepEqual(await call('proposal.save',{delegation_id:d.id,expected_revision:0,payload},request),p);await assert.rejects(call('proposal.save',{delegation_id:d.id,expected_revision:0,payload}),/version_conflict/);
 const state=await me(d.id),hash=state.proposals[0].payload_sha256;await call('proposal.submit',{id:p.id,expected_hash:hash});await assert.rejects(call('proposal.prepare',{id:p.id,expected_hash:hash,expected_partner_revision:0,slug:'testfixture',locale:'nl-BE',role_ids:[randomUUID()],proof_document_id:f.ids.policyDoc}),/not_authorized/);
 await actor(f.ids.reviewer);await assert.rejects(me(d.id),/not_authorized/);
 await actor(f.ids.chair);const role=await f.call('partner.role',{partner_id:f.ids.partner,role:'esports',proof_document_id:f.ids.policyDoc});await workflow('f4_partner_workflow','site.configure',{enabled:true,reason:'TESTFIXTURE'});
 await call('proposal.prepare',{id:p.id,expected_hash:hash,expected_partner_revision:0,slug:'testfixture',locale:'nl-BE',role_ids:[role.id],proof_document_id:f.ids.policyDoc});
 const admin=(await f.db.query<{v:{revisions:{id:string;payload_sha256:string}[]}}>(`select public.f4_partner_admin(${q(site)})v`)).rows[0].v,r=admin.revisions[0];assert(r);await workflow('f4_partner_workflow','partner.submit',{id:r.id,expected_hash:r.payload_sha256});
 await f.owner();await f.db.exec(`update public.organization_members set status='active'where user_id=${q(f.ids.member)}and organization_id=${q(f.ids.org)}`);await actor(f.ids.chair);await f.call('identity.assign',{user_id:f.ids.member,role:'publication_reviewer'});await actor(f.ids.member);await assert.rejects(workflow('f4_partner_workflow','partner.review',{id:r.id,expected_hash:r.payload_sha256,decision:'approved',reason:'TESTFIXTURE self review denied',rights_confirmed:true}),/independent_review_required/);await f.owner();await f.db.exec(`update public.organization_members set status='pending'where user_id=${q(f.ids.member)}and organization_id=${q(f.ids.org)}`);
 await actor(f.ids.reviewer);await workflow('f4_partner_workflow','partner.review',{id:r.id,expected_hash:r.payload_sha256,decision:'approved',reason:'TESTFIXTURE independent',rights_confirmed:true});await actor(f.ids.chair);await workflow('f4_partner_workflow','partner.release',{id:r.id,expected_hash:r.payload_sha256,expected_epoch:0,reason:'TESTFIXTURE',published_at:null,valid_until:null});
 await actor(f.ids.member);assert.equal((await me(d.id)).proposals[0].status,'prepared');await call('proposal.withdraw',{id:p.id,expected_hash:hash});
 await f.owner();assert.equal((await f.db.query<{n:number}>(`select count(*)::int n from private.partner_publication_entries where withdrawn_at is null`)).rows[0].n,0);
 await actor(f.ids.chair);await workflow('f4_workflow','access.revoke',{id:grant.id,reason:'TESTFIXTURE'});await actor(f.ids.member);await assert.rejects(me(d.id),/not_authorized/);await assert.rejects(call('proposal.save',{delegation_id:d.id,expected_revision:0,payload},request),/not_authorized/);
 await actor(f.ids.chair);await workflow('f4_workflow','access.assign',{person_id:f.ids.otherPerson,proof_document_id:f.ids.proof,valid_until:until,may_view:false});await actor(f.ids.member);assert.equal((await me()).delegations.length,0);
 await actor(f.ids.chair);const expired=await call('delegation.assign',{partner_id:f.ids.partner,person_id:f.ids.otherPerson,proof_document_id:f.ids.policyDoc,valid_until:new Date(Date.now()+1800000).toISOString()});await f.owner();await f.db.exec(`update private.partner_delegations set valid_until=clock_timestamp()-interval'1 second'where id=${q(expired.id)}`);await actor(f.ids.member);await assert.rejects(me(expired.id),/not_authorized/);await actor(f.ids.chair);await call('delegation.revoke',{id:expired.id,reason:'TESTFIXTURE expired'});
 const proofBound=await call('delegation.assign',{partner_id:f.ids.partner,person_id:f.ids.otherPerson,proof_document_id:f.ids.policyDoc,valid_until:new Date(Date.now()+1800000).toISOString()});await actor(f.ids.member);assert.equal((await me(proofBound.id)).delegations.length,1);await f.owner();const oldLabel=(await f.db.query<{label:string}>(`select label from public.document_registry where id=${q(f.ids.policyDoc)}`)).rows[0].label;await f.db.exec(`update public.document_registry set label='TESTFIXTURE changed proof'where id=${q(f.ids.policyDoc)};update public.document_registry set label=${q(oldLabel)}where id=${q(f.ids.policyDoc)}`);await actor(f.ids.member);await assert.rejects(me(proofBound.id),/not_authorized/);
 }finally{await f.db.close();}
});
