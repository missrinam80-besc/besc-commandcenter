import assert from 'node:assert/strict';
import test from 'node:test';
import {hashBotKey,BotRateLimiter,type BotClient} from '../src/lib/bot-api.ts';
import {handleDiscordConfigRequest,canonical} from '../src/lib/discord-config-api.ts';
const guild='1067893182387474432',actor='111111111111111111',parent='1558853872766689382',app='1558542661265129474',id='20000000-0000-4000-8000-000000000001',org='10000000-0000-4000-8000-000000000001';
const key=`bb_config-fixture.${'a'.repeat(43)}`;
const client:BotClient={id:'config-fixture',organizationId:org,guildId:guild,keyHash:hashBotKey(key),scopes:['bot-config:read','bot-config:report','bot-config:deliver','tickets:create'],ticketParentChannelId:parent,expiresAt:'2099-01-01',revoked:false};
function fixture(patch:Partial<BotClient>={},verified=true){const calls:unknown[][]=[];const identity={async findAccount(){return verified?{userId:id,verifiedDiscordId:actor,banned:false}:{userId:id,verifiedDiscordId:parent,banned:false}},async findMembership(){return{organization_id:org,role:'member',finance_role:'none',status:'active'}}};const deps={clients:[{...client,...patch}],limiter:new BotRateLimiter(999),identity,store:{async operation(...args:unknown[]){calls.push(args);return{recorded:true}}}};const run=(path:string,data:object|undefined,headers:Record<string,string>={},method=data?'POST':'GET')=>handleDiscordConfigRequest(new Request('https://example.invalid/api/v1/bot/'+path,{method,headers:{authorization:'Bearer '+key,'content-type':'application/json','idempotency-key':actor,...headers},...(data?{body:JSON.stringify(data)}:{})}),deps);return{run,calls,deps};}
const intent={guild_id:guild,discord_user_id:actor,type_revision_id:id,source:'slash'};
for(const [name,patch,status] of [['revoked',{revoked:true},401],['expired',{expiresAt:'2000-01-01'},401],['scope',{scopes:['identity:read']},403]] as const)test('Config auth refuses '+name,async()=>{const f=fixture(patch as Partial<BotClient>);assert.equal((await f.run('ticket-config?guild_id='+guild,undefined)).status,status);assert.equal(f.calls.length,0);});
test('Config rejects guild, duplicate params, arbitrary management and actor overrides',async()=>{for(const[route,data]of [['ticket-config?guild_id='+actor,undefined],['ticket-config?guild_id='+guild+'&guild_id='+guild,undefined],['ticket-intents',{...intent,organization_id:org}],['ticket-intents',{...intent,verified_user_id:id}],['bot-runtime/report',{guild_id:guild,application_id:app,installed:true,runtime_version:'2',features:[],channels:[],users:['private']}]] as [string,object|undefined][]){const f=fixture();assert.ok([400,403].includes((await f.run(route,data)).status));assert.equal(f.calls.length,0)}});
test('Intent identity uses current Auth identity and membership; unlinked receives no verified grant',async()=>{for(const linked of[true,false]){const f=fixture({},linked);assert.equal((await f.run('ticket-intents',intent)).status,201);assert.deepEqual(f.calls[0].slice(0,4),[org,client.id,guild,'intent']);assert.equal((f.calls[0][4] as Record<string,unknown>).verified_user_id,linked?id:undefined);}});
test('Canonical payload hashing is recursive and excludes server-derived grant',async()=>{assert.equal(canonical({answers:{b:'b',a:'a'},x:1}),canonical({x:1,answers:{a:'a',b:'b'}}));const f=fixture();await f.run('ticket-intents',intent);await f.run('ticket-intents',{source:'slash',type_revision_id:id,discord_user_id:actor,guild_id:guild});assert.equal((f.calls[0][4] as Record<string,unknown>).request_hash,(f.calls[1][4] as Record<string,unknown>).request_hash)});
test('Intake rejects 128KiB chunked data and cancels stalled response body before any write',async()=>{for(const stalled of[false,true]){let cancelled=false;const f=fixture();const stream=new ReadableStream({start(c){if(!stalled)c.enqueue(new Uint8Array(131073))},cancel(){cancelled=true}});const r=new Request('https://example.invalid/api/v1/bot/tickets/intake',{method:'POST',headers:{authorization:'Bearer '+key,'content-type':'application/json'},body:stream,duplex:'half'} as RequestInit);const response=await handleDiscordConfigRequest(r,f.deps);assert.equal(response.status,stalled?408:413);assert.equal(cancelled,true);assert.equal(f.calls.length,0)}});
test('Config delivery accepts only known effects, bounded errors and empty permission evidence',async()=>{const f=fixture();for(const patch of[{kind:'arbitrary_discord_route'},{kind:'check_channel',channel_id:parent,channel_type:0,permissions_ok:true,missing_permissions:['manage_threads']}]){const response=await f.run('bot-config-deliveries/'+id+'/complete',{guild_id:guild,worker_id:'worker_123',lease_token:id,application_id:app,payload_hash:'a'.repeat(64),...patch});assert.equal(response.status,400)}assert.equal(f.calls.length,0)});
test('Shared schema-2 fixtures are accepted by the actual boundary and contain no removed media/team fields',async()=>{const {readFileSync}=await import('node:fs');const f=JSON.parse(readFileSync(new URL('../docs/contracts/ticketing-v2.fixtures.json',import.meta.url),'utf8')) as {requests:{name:string;path:string;method:string;body?:object}[]};for(const req of f.requests){const api=fixture();assert.ok([200,201].includes((await api.run(req.path,req.body,{},req.method)).status),req.name);assert.equal(api.calls.length,1);}assert.equal(/imageUrl|teamId|mediaAssetId/.test(JSON.stringify(f)),false)});
