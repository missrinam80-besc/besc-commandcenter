import test from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {f1Database,q,j} from './helpers/f1-database.mts';
import {pagePublicationSchema,pageNavigationSchema,redirectResolutionSchema} from '../src/lib/site-content-contract.ts';
test('Information pages: provenance, independent review, private media, exact redirects, closed targets and withdrawal',async()=>{
 const f=await f1Database();try{
 const sessions=new Map<string,string>();for(const u of[f.ids.chair,f.ids.member,f.ids.reviewer]){const id=randomUUID();sessions.set(u,id);await f.owner();await f.db.exec(`update auth.users set email_confirmed_at=now()where id=${q(u)};insert into auth.sessions(id,user_id)values(${q(id)},${q(u)});`);}
 const actor=async(u:string)=>{await f.owner();await f.actor(u);await f.db.exec(`select set_config('request.jwt.claims',${q(JSON.stringify({sub:u,role:'authenticated',session_id:sessions.get(u)}))},false)`);};
 const site=randomUUID(),media=randomUUID(),key='TESTFIXTURE information-page key never used live';await f.owner();await f.db.exec(`insert into public.publication_sites(id,organization_id,host,active,key_sha256,created_by)values(${q(site)},${q(f.ids.org)},'website-dev.belgianstreamerscommunity.be',true,${q(createHash('sha256').update(key).digest('hex'))},${q(f.ids.chair)});insert into public.publication_media(public_media_id,organization_id,site_id,document_id,storage_path,sha256,mime,bytes,width,height,created_by)values(${q(media)},${q(f.ids.org)},${q(site)},${q(f.ids.policyDoc)},${q(f.ids.org+'/'+media+'.png')},${q('a'.repeat(64))},'image/png',100,10,10,${q(f.ids.chair)});update public.organization_members set status='pending'where user_id=${q(f.ids.member)}and organization_id=${q(f.ids.org)};`);
 const call=async(op:string,data:unknown,id=randomUUID())=>(await f.db.query<{v:{id:string}}>(`select public.f4_content_workflow(${q(site)},${q(op)},${j(data)},${q(id)})v`)).rows[0].v;
 const list=async()=>(await f.db.query<{v:unknown[]}>(`select public.f4_pages(${q(site)})v`)).rows[0].v;
 const resolve=async(path:string,query='')=>(await f.db.query<{v:unknown}>(`select public.f4_redirect_resolve(${q(site)},'www.belgianstreamerscommunity.be',${q(path)},${q(query)})v`)).rows[0].v;
 await actor(f.ids.chair);await f.db.query(`select public.f4_workflow(${q(site)},'access.assign',${j({person_id:f.ids.otherPerson,proof_document_id:f.ids.proof,valid_until:new Date(Date.now()+3600000).toISOString(),may_view:true})},${q(randomUUID())})`);await call('site.configure',{pages_enabled:true,redirects_enabled:true,reason:'TESTFIXTURE'});
 const record={batch_id:'b'.repeat(64),record_id:'URL-001',source_url:'https://www.belgianstreamerscommunity.be/old',source_sha256:'c'.repeat(64),snapshot_date:'2026-10-03',classification:'page',source_title:'TESTFIXTURE',source_excerpt:'TESTFIXTURE PRIVATE PROVENANCE',proposed_destination:'/over-besc',source_file:'testfixture.txt',blockers:['TESTFIXTURE no actual approval']};const source=await call('migration.stage',{record});await assert.rejects(call('migration.stage',{record:{...record,source_excerpt:'changed'}}),/source_conflict/);
 const publish=async(kind:string,payload:unknown)=>{await actor(f.ids.chair);const saved=await call('content.draft',{kind,dossier_id:null,expected_revision:0,payload,proof_document_id:f.ids.policyDoc,migration_record_id:source.id});const state=(await f.db.query<{v:{revisions:{id:string;dossier_id:string;payload_sha256:string}[]}}>(`select public.f4_content_admin(${q(site)})v`)).rows[0].v,r=state.revisions.find(r=>r.id===saved.id)!;await call('content.submit',{id:r.id,expected_hash:r.payload_sha256});await actor(f.ids.reviewer);await call('content.review',{id:r.id,expected_hash:r.payload_sha256,decision:'approved',reason:'TESTFIXTURE independent',facts_confirmed:true,rights_confirmed:true});await actor(f.ids.chair);await call('content.release',{id:r.id,expected_hash:r.payload_sha256,expected_epoch:0,reason:'TESTFIXTURE',published_at:null,valid_until:null});return r;};
 const page=await publish('page',{slug:'over-besc',locale:'nl-BE',title:'TESTFIXTURE NIET PUBLICEREN',summary:'TESTFIXTURE',body:{format:'plain_text',value:'TESTFIXTURE <script>literal</script>'},navigation:true,links:[{label:'TESTFIXTURE',href:'/events'}],hero:{public_media_id:media,alt:'TESTFIXTURE',credit:''}});
 await actor(f.ids.member);const p=pagePublicationSchema.parse((await list())[0]);assert.equal(p.slug,'over-besc');assert(!JSON.stringify(p).includes('PRIVATE PROVENANCE'));assert(!JSON.stringify(p).includes('proof_document_id'));const nav=pageNavigationSchema.parse((await f.db.query<{v:unknown}>(`select public.f4_content_navigation(${q(site)})v`)).rows[0].v);assert.equal(nav.items.length,1);assert(!JSON.stringify(nav).includes('body'));await assert.rejects(f.db.query('select * from private.site_content_revisions'),/permission denied/);
 const locate=async()=>(await f.db.query<{v:unknown}>(`select public.f4_page_media_locator(${q(site)},${q(media)},${q(key)})v`)).rows[0].v;assert(await locate());
 await publish('redirect',{old_host:'www.belgianstreamerscommunity.be',old_path:'/oude-over',old_query:'',mode:'redirect',target_path:'/over-besc'});await actor(f.ids.member);assert.equal(redirectResolutionSchema.parse(await resolve('/oude-over')).status,307);assert.equal(await resolve('/oude-over','max-results=5'),null);await assert.rejects(resolve('/oude-over','token=PRIVATE'),/invalid_input/);
 await assert.rejects(publish('redirect',{old_host:'www.belgianstreamerscommunity.be',old_path:'/chain',old_query:'',mode:'redirect',target_path:'/oude-over'}),/target_or_chain_invalid/);
 await assert.rejects(publish('redirect',{old_host:'www.belgianstreamerscommunity.be',old_path:'/over-besc',old_query:'',mode:'redirect',target_path:'/nieuws'}),/target_or_chain_invalid/);
 await publish('redirect',{old_host:'www.belgianstreamerscommunity.be',old_path:'/vervallen',old_query:'',mode:'gone',target_path:null});await actor(f.ids.member);assert.equal(redirectResolutionSchema.parse(await resolve('/vervallen')).status,410);
 await publish('redirect',{old_host:'www.belgianstreamerscommunity.be',old_path:'/'+ 'x'.repeat(1700),old_query:'max-results='+ '1'.repeat(1000),mode:'redirect',target_path:'/nieuws'});await actor(f.ids.member);assert.equal(redirectResolutionSchema.parse(await resolve('/'+'x'.repeat(1700),'max-results='+'1'.repeat(1000))).status,307);
 await actor(f.ids.chair);await call('content.withdraw',{dossier_id:page.dossier_id,reason:'TESTFIXTURE'});await actor(f.ids.member);assert.deepEqual(await list(),[]);assert.equal(await locate(),null);assert.equal(await resolve('/oude-over'),null);
 await actor(f.ids.reviewer);await call('migration.resolve',{id:source.id,expected_reviews:0,decision:'retain_reference',reason:'TESTFIXTURE source remains historical',proof_document_id:f.ids.policyDoc});await assert.rejects(call('migration.resolve',{id:source.id,expected_reviews:0,decision:'mapped',reason:'TESTFIXTURE stale',proof_document_id:f.ids.policyDoc}),/review_conflict/);
 const records=(await f.db.query<{v:{records:{reviews:unknown[];review_count:number}[]}}>(`select public.f4_content_admin(${q(site)},'records')v`)).rows[0].v.records;assert.equal(records[0].reviews.length,1);assert.equal(records[0].review_count,1);
 await f.owner();await f.db.exec(`update public.publication_media set revoked_at=clock_timestamp()where public_media_id=${q(media)};update public.document_registry set url='https://example.invalid/changed-proof'where id=${q(f.ids.policyDoc)}`);await actor(f.ids.member);assert.equal(await resolve('/vervallen'),null);
 }finally{await f.db.close();}
});
