import test,{before,after,beforeEach,afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {f1Database,q,j} from './helpers/f1-database.mts';
import {operationsSchema,currentStatus,attentionCount} from '../src/lib/operations-status.ts';
let f:Awaited<ReturnType<typeof f1Database>>,session:string;
const snapshot={metrics:{disk_free_kib:900000},checks:[{code:'disk',level:'warning'}]};
async function service(){await f.owner();await f.actor(f.ids.admin,'service_role');}
async function admin(){await f.owner();await f.actor(f.ids.admin);await f.db.exec(`select set_config('request.jwt.claims',${j({sub:f.ids.admin,role:'authenticated',session_id:session})}::text,false)`);}
async function record(data:unknown=snapshot,target='web',org=f.ids.org,at=new Date().toISOString()){return(await f.db.query<{r:unknown}>(`select public.ops_record_snapshot(${q(org)},${q(target)},${q(at)},${j(data)}) r`)).rows[0].r;}
async function read(org=f.ids.org){return(await f.db.query<{r:unknown}>(`select public.ops_read_status(${q(org)}) r`)).rows[0].r;}
async function denied(fn:()=>Promise<unknown>){await f.db.exec('savepoint denied');await assert.rejects(fn,/ops_|permission denied/);await f.db.exec('rollback to denied');}
before(async()=>{f=await f1Database();await f.owner();session=randomUUID();await f.db.exec(`update auth.users set email_confirmed_at=clock_timestamp() where id=${q(f.ids.admin)};insert into auth.sessions(id,user_id)values(${q(session)},${q(f.ids.admin)})`);});
after(async()=>{await f?.db.close();});beforeEach(async()=>{await f.owner();await f.db.exec('begin');});afterEach(async()=>{await f.db.exec('rollback');await f.owner();});

test('OP01 service records bounded state; authenticated admin reads it with explicit missing targets',async()=>{await service();await record();await admin();const rows=operationsSchema.parse(await read());assert.equal(rows.find(r=>r.target==='web')?.status,'warning');assert.equal(rows.find(r=>r.target==='bot')?.status,'pending');assert.equal(attentionCount(rows),3);});
test('OP01 stale or unavailable sources cannot appear healthy',async()=>{await service();await record({metrics:{},checks:[{code:'disk',level:'ok'}]},'web',f.ids.org,new Date(Date.now()-20*60000).toISOString());await admin();const row=operationsSchema.parse(await read()).find(r=>r.target==='web')!;assert.equal(row.status,'stale');assert.equal(currentStatus(row),'stale');assert.equal(currentStatus({...row,observed_at:null,status:'ok'}),'pending');});
test('OP01 member, other tenant, removed admin and revoked session cannot read operations',async()=>{await admin();await denied(()=>read(f.ids.otherOrg));await f.owner();await f.actor(f.ids.member);await denied(()=>read());await f.owner();await f.db.exec(`update public.organization_members set role='member' where user_id=${q(f.ids.admin)}`);await admin();await denied(()=>read());await f.owner();await f.db.exec(`update public.organization_members set role='admin' where user_id=${q(f.ids.admin)};delete from auth.sessions where user_id=${q(f.ids.admin)}`);await admin();await denied(()=>read());});
test('OP01 browser roles cannot forge snapshots or read raw private state',async()=>{for(const role of ['authenticated','anon']){await f.owner();await f.actor(f.ids.admin,role);await denied(()=>record());await denied(()=>f.db.query('select * from private.operations_state'));}await service();await denied(()=>f.db.query('select * from private.operations_state'));});
test('OP01 rejects raw logs, strings, unknown keys/codes, duplicates and oversized snapshots',async()=>{await service();for(const value of [{...snapshot,logs:'PRIVATE'}, {...snapshot,metrics:{password:'PRIVATE'}},{...snapshot,metrics:{disk_free_kib:-1}},{metrics:{},checks:[{code:'unknown',level:'ok'}]},{metrics:{},checks:[{code:null,level:'ok'}]},{metrics:{},checks:[{code:'disk',level:'ok'},{code:'disk',level:'ok'}]},{metrics:{disk_free_kib:1},checks:[{code:'disk',level:'ok',raw:'PRIVATE'}]},{metrics:{},checks:[{code:'disk',level:'ok',raw:'x'.repeat(9000)}]}])await denied(()=>record(value));await denied(()=>record(snapshot,'unknown'));});
test('OP01 rejects out-of-order updates and caps transition history at twenty',async()=>{await service();const start=Date.now()-60000;for(let n=0;n<30;n++)await record({metrics:{},checks:[{code:'disk',level:n%2?'ok':'warning'}]},'web',f.ids.org,new Date(start+n*1000).toISOString());await denied(()=>record(snapshot,'web',f.ids.org,new Date(start-1000).toISOString()));await admin();const row=operationsSchema.parse(await read()).find(r=>r.target==='web')!;assert.equal(row.transitions.length,20);assert.equal(row.status,'ok');});
test('OP01 input presentation rejects malformed and duplicated target data',()=>{assert.equal(operationsSchema.safeParse([{target:'web',status:'ok'}]).success,false);});
