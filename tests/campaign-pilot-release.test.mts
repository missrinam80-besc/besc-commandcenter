import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync, readdirSync } from 'node:fs';
import { createHash } from 'node:crypto';
test('F3 release: exact additive migration, historical SQL unchanged and live gates retained', () => {
  const root = new URL('../', import.meta.url);
  const manifest = JSON.parse(readFileSync(new URL('ops/f3-release-manifest.json', root), 'utf8'));
  assert.equal(manifest.synthetic_build_authorized, true); assert.equal(manifest.live_cloud_apply_authorized, false); assert.equal(manifest.runtime_default, 'off');
  assert.equal(manifest.migrations.length, 1); assert.equal(manifest.historical_migrations.length, 125);
  const completion = JSON.parse(readFileSync(new URL('ops/f3-completion-release-manifest.json', root), 'utf8'));
  assert.deepEqual(completion.historical_migrations, [...manifest.historical_migrations, ...manifest.migrations]);
  assert.equal(completion.migrations.length, 1);
  assert.equal(completion.live_cloud_apply_authorized, false);
  assert.equal(completion.runtime_default, 'off');
  assert.equal(completion.first_platform, 'twitch');
  assert.deepEqual(completion.excluded_history, manifest.excluded_history);
  assert.equal(completion.expected_history_if_same_baseline_and_applied, 126);
  const creator = JSON.parse(readFileSync(new URL('ops/f4-creator-release-manifest.json', root), 'utf8'));
  assert.deepEqual(creator.historical_migrations, [...completion.historical_migrations, ...completion.migrations]);
  assert.equal(creator.migrations.length, 1);
  assert.equal(creator.live_cloud_apply_authorized, false);
  assert.equal(creator.runtime_default, 'off');
  assert.equal(creator.expected_history_if_same_baseline_and_applied, 127);
  assert.deepEqual(creator.excluded_history, manifest.excluded_history);
  const intake = JSON.parse(readFileSync(new URL('ops/f4-intake-release-manifest.json', root), 'utf8'));
  assert.deepEqual(intake.historical_migrations, [...creator.historical_migrations, ...creator.migrations]);
  assert.equal(intake.migrations.length, 1);assert.equal(intake.live_cloud_apply_authorized, false);
  assert.equal(intake.runtime_default, 'off');assert.equal(intake.required_history_before, 127);
  assert.equal(intake.last_verified_cloud_history, 126);assert.equal(intake.expected_history_if_same_baseline_and_applied, 128);
  const partner = JSON.parse(readFileSync(new URL('ops/f4-partner-release-manifest.json', root), 'utf8'));
  assert.deepEqual(partner.historical_migrations, [...intake.historical_migrations, ...intake.migrations]);
  assert.equal(partner.migrations.length, 1);assert.equal(partner.runtime_default, 'off');
  assert.equal(partner.live_cloud_apply_authorized, false);assert.equal(partner.required_history_before, 128);
  assert.equal(partner.last_verified_cloud_history, 126);assert.equal(partner.expected_history_if_same_baseline_and_applied, 129);
  const vacancy = JSON.parse(readFileSync(new URL('ops/f4-vacancy-release-manifest.json', root), 'utf8'));
  assert.deepEqual(vacancy.historical_migrations, [...partner.historical_migrations,...partner.migrations]);
  assert.equal(vacancy.required_history_before,129);assert.equal(vacancy.expected_history_if_same_baseline_and_applied,130);assert.equal(vacancy.live_cloud_apply_authorized,false);assert.equal(vacancy.runtime_default,'off');
  const delegation = JSON.parse(readFileSync(new URL('ops/f4-delegation-release-manifest.json', root), 'utf8'));
  assert.deepEqual(delegation.historical_migrations,[...vacancy.historical_migrations,...vacancy.migrations]);
  assert.equal(delegation.required_history_before,130);assert.equal(delegation.expected_history_if_same_baseline_and_applied,131);assert.equal(delegation.live_cloud_apply_authorized,false);assert.equal(delegation.runtime_default,'off');
  const content = JSON.parse(readFileSync(new URL('ops/f4-content-release-manifest.json', root), 'utf8'));
  assert.deepEqual(content.historical_migrations,[...delegation.historical_migrations,...delegation.migrations]);
  assert.equal(content.required_history_before,131);assert.equal(content.expected_history_if_same_baseline_and_applied,132);assert.equal(content.live_cloud_apply_authorized,false);assert.equal(content.runtime_default,'off');
  const contact = JSON.parse(readFileSync(new URL('ops/f4-contact-release-manifest.json', root), 'utf8'));
  assert.deepEqual(contact.historical_migrations,[...content.historical_migrations,...content.migrations]);
  assert.equal(contact.required_history_before,132);assert.equal(contact.expected_history_if_same_baseline_and_applied,133);assert.equal(contact.live_cloud_apply_authorized,false);assert.equal(contact.runtime_default,'off');
  const f5 = JSON.parse(readFileSync(new URL('ops/f5-completion-release-manifest.json', root), 'utf8'));
  assert.deepEqual(f5.historical_migrations.map(({ file, sha256_lf }: {file:string;sha256_lf:string}) => ({ file, sha256_lf })), [...contact.historical_migrations, ...contact.migrations].map(({ file, sha256_lf }: {file:string;sha256_lf:string}) => ({ file, sha256_lf })));
  assert.deepEqual(f5.new_migrations.map((f: {file:string}) => f.file), ['20261024150408_f5_own_campaigns_bot.sql','20261024161428_f5_campaign_extensions_and_reconciliation.sql']);
  assert.equal(f5.cloud_apply_authorized,false);assert.equal(f5.server_deploy_authorized,false);assert.equal(f5.runtime_activation_authorized,false);
  assert.equal(f5.expected_history_only_if_same_baseline_and_both_applied,135);
  assert.deepEqual(f5.excluded_history,manifest.excluded_history);
  const f6 = JSON.parse(readFileSync(new URL('ops/f6-public-read-release-manifest.json', root), 'utf8'));
  assert.deepEqual(f6.historical_migrations,[...f5.historical_migrations,...f5.new_migrations]);
  assert.deepEqual(f6.new_migrations.map((f:{file:string})=>f.file),['20261025092249_f6_explicit_public_read_channels.sql']);
  assert.equal(f6.required_history_before,135);assert.equal(f6.expected_history_only_if_same_baseline_and_applied,136);
  assert.equal(f6.cloud_apply_authorized,false);assert.equal(f6.server_deploy_authorized,false);assert.equal(f6.runtime_activation_authorized,false);
  assert.equal(f6.runtime_default,'off');assert.deepEqual(f6.excluded_history,manifest.excluded_history);
  const files = [...f6.historical_migrations, ...f6.new_migrations];
  assert.deepEqual(readdirSync(new URL('supabase/migrations/', root)).filter(f => f.endsWith('.sql')).sort(), files.map(f => f.file).sort());
  for (const f of files) assert.equal(createHash('sha256').update(readFileSync(new URL('supabase/migrations/' + f.file, root), 'utf8').replaceAll('\r\n', '\n')).digest('hex'), f.sha256_lf, f.file);
  assert.deepEqual(manifest.excluded_history, ['20261001110000_seed_operational_guidelines.sql']);
});
