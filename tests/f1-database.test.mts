test('R04: replay is één effect en gewijzigde payload onder request-ID is conflict',async()=>{const key=randomUUID();const data={user_id:f.ids.admin,role:'partner_editor'};const a=await f.call('identity.assign',data,key);assert.deepEqual(await f.call('identity.assign',data,key),a);await f.db.exec('savepoint denied');await assert.rejects(f.call('identity.assign',{...data,role:'consent_registrar'},key),/f1_request_conflict/);await f.db.exec('rollback to denied');});
test('E01/E02: alle nieuwe tabellen hebben RLS en geen directe clientwrites',async()=>{await f.owner();const r=await f.db.query<{relname:string;relrowsecurity:boolean;canwrite:boolean}>("select c.relname,c.relrowsecurity,has_table_privilege('authenticated',c.oid,'INSERT') canwrite from pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname='public' and c.relname in('association_identity_verifications','workflow_assignments','governance_evidence_versions','governance_reviews','governance_decisions','processing_purposes','consent_records','consent_withdrawals','partner_roles','publication_revisions')");assert.equal(r.rows.length,10);assert.ok(r.rows.every(x=>x.relrowsecurity&&!x.canwrite));assert.equal(f.migrationCount,124);});
