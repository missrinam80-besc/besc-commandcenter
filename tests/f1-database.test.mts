import assert from 'node:assert/strict';
import test,{before,after,beforeEach,afterEach} from 'node:test';
import { randomUUID } from 'node:crypto';
import { f1Database,q,j } from './helpers/f1-database.mts';
let f:Awaited<ReturnType<typeof f1Database>>;
before(async()=>{f=await f1Database();});after(async()=>{await f?.db.close();});
beforeEach(async()=>{await f.db.exec('begin');await f.actor(f.ids.chair);});
afterEach(async()=>{await f.db.exec('rollback');await f.owner();});
async function fails(op:string,data:unknown,pattern=/f1_|permission denied|invalid|violates/){await f.db.exec('savepoint denied');await assert.rejects(f.call(op,data),pattern);await f.db.exec('rollback to denied');}
async function sqlFails(sql:string,pattern=/f1_|permission denied|violates/){await f.db.exec('savepoint denied');await assert.rejects(f.db.exec(sql),pattern);await f.db.exec('rollback to denied');}
async function evidence(type='official_rule',doc=f.ids.ruleDoc){const r=await f.call('governance.evidence',{document_id:doc,source_version:'TESTFIXTURE versie 1',preserved_reference:'https://example.invalid/preserved-v1',evidence_type:type});await f.call('governance.evidence_check',{id:r.id,reason:'TESTFIXTURE bronversie en beschikbaarheid gecontroleerd'});return r.id;}
const source=()=>({source_type:'deadline',source_id:f.ids.deadline,expected_revision:1});
async function reviews(){const e=await evidence();const x=await evidence('execution',f.ids.executionDoc);const rule=await f.call('governance.review',{...source(),dimension:'rule',outcome:'verified',evidence_id:e,reason:'TESTFIXTURE officiële bron gecontroleerd',conflict_declared:false});const applicability=await f.call('governance.review',{...source(),dimension:'applicability',outcome:'applicable',reason:'TESTFIXTURE van toepassing',conflict_declared:false});const execution=await f.call('governance.review',{...source(),dimension:'execution',outcome:'demonstrated',evidence_id:x,reason:'TESTFIXTURE uitvoering gecontroleerd',conflict_declared:false});return {e,x,rule_review_id:rule.id,applicability_review_id:applicability.id,execution_review_id:execution.id};}
async function decision(){const r=await reviews();const answer=await f.call('governance.decide',{...source(),rule_review_id:r.rule_review_id,applicability_review_id:r.applicability_review_id,execution_review_id:r.execution_review_id,body:'TESTFIXTURE uitvoering aangetoond',authority_basis:'TESTFIXTURE benoemingsgrond',governing_body:'TESTFIXTURE bestuur',conflict_declared:false});return {...r,id:answer.id};}
async function purpose(){const p=await f.call('consent.purpose',{purpose_code:'public_profile',text_version:1,title:'TESTFIXTURE publiek profiel',body:'TESTFIXTURE — NIET PUBLICEREN — specifieke verklaringstekst',allowed_scope:{fields:['display_name']},legal_basis:'TESTFIXTURE expliciet beoordeeld',retention_policy:'TESTFIXTURE vastgestelde behandeling',policy_document_id:f.ids.policyDoc});await f.call('consent.activate_purpose',{id:p.id,policy_confirmed:true});return p.id;}
async function consent(){const p=await purpose();return(await f.call('consent.give',{purpose_id:p,scope:{fields:['display_name']},accepted:true})).id;}
const payload=()=>({title:'TESTFIXTURE — NIET PUBLICEREN',summary:'Uitsluitend synthetische proef',slug:'testfixture-niet-publiceren',locale:'nl-BE',body:{format:'sanitized_html',value:'<p>Uitsluitend test.</p>'},media:[]});

test('I06/I07: toekomstig of dubbel voorzitterschap en ingetrokken lidmaatschap blokkeren beslissingen',async()=>{
 await f.owner();await f.db.exec(`update public.governance_mandates set start_date=current_date+1 where member_id=${q(f.ids.association)}`);await f.actor(f.ids.chair);await fails('identity.assign',{user_id:f.ids.admin,role:'partner_editor'});
 await f.owner();await f.db.exec(`update public.governance_mandates set start_date=current_date-1 where member_id=${q(f.ids.association)};insert into public.governance_mandates(organization_id,member_id,role,start_date,created_by) values(${q(f.ids.org)},${q(f.ids.association)},'chair',current_date-1,${q(f.ids.chair)})`);await f.actor(f.ids.chair);await fails('identity.assign',{user_id:f.ids.admin,role:'partner_editor'});
 await f.owner();await f.db.exec(`update public.organization_members set status='pending' where organization_id=${q(f.ids.org)} and user_id=${q(f.ids.chair)}`);await f.actor(f.ids.chair);await fails('consent.purpose',{});
});

test('C04/C08/C09: extern bewijs herkenbaar; nieuwe doelversie maakt oude verklaring niet ruimer',async()=>{
 const p=await purpose();const ext=await f.call('consent.record_external',{purpose_id:p,person_id:f.ids.otherPerson,scope:{fields:['display_name']},external_evidence_id:f.ids.policyDoc});
 await f.actor(f.ids.member);const own=await f.db.query<{s:{records:{id:string;method:string}[]}}>(`select public.f1_own_consent(${q(f.ids.org)}) s`);assert.equal(own.rows[0].s.records.find(r=>r.id===ext.id)?.method,'external_evidence');await fails('consent.record_external',{purpose_id:p,person_id:f.ids.person,scope:{fields:['display_name']},external_evidence_id:f.ids.policyDoc});
 await f.actor(f.ids.chair);const newer=await f.call('consent.purpose',{purpose_code:'public_profile',text_version:2,title:'TESTFIXTURE versie twee',body:'TESTFIXTURE nieuwe tekst en scope',allowed_scope:{fields:['display_name','bio']},legal_basis:'TESTFIXTURE',retention_policy:'TESTFIXTURE',policy_document_id:f.ids.policyDoc});await f.call('consent.activate_purpose',{id:newer.id,policy_confirmed:true});assert.equal((await f.db.query<{ok:boolean}>(`select private.f1_consent_valid(${q(f.ids.org)},${q(ext.id)}) ok`)).rows[0].ok,false);
 await fails('consent.activate_purpose',{id:p,policy_confirmed:true});
});

test('D02/D03/D05: financiële en governancebevoegdheid zijn doorsnede; koppelen geeft geen bewijs-URL vrij',async()=>{
 await evidence();await f.owner();await f.db.exec(`update public.document_registry set restricted_finance=true where id=${q(f.ids.ruleDoc)}`);await f.actor(f.ids.member);assert.equal((await f.db.query<{n:number}>(`select count(*)::int n from public.document_registry where id=${q(f.ids.ruleDoc)}`)).rows[0].n,0);
 await f.actor(f.ids.admin);await sqlFails(`insert into public.record_links(organization_id,entity_type,entity_id,label,url,document_id,created_by) values(${q(f.ids.org)},'event',${q(f.ids.event)},'TESTFIXTURE koppeling','https://example.invalid/ruleDoc',${q(f.ids.ruleDoc)},${q(f.ids.admin)})`,/document_unavailable|permission denied/);
 await sqlFails(`insert into public.record_links(organization_id,entity_type,entity_id,label,url,created_by) values(${q(f.ids.org)},'event',${q(f.ids.event)},'TESTFIXTURE koppeling','https://example.invalid/ruleDoc',${q(f.ids.admin)})`,/document_unavailable|permission denied/);
});

test('P06/P07: rol beëindigen stopt nieuwe bijdragen en verleent geen portaaltoegang',async()=>{
 const r=await f.call('partner.role',{partner_id:f.ids.partner,role:'esports'});await f.call('partner.relate',{partner_id:f.ids.partner,source_type:'event',source_id:f.ids.event,contribution_role:'esports'});await f.call('partner.revoke',{id:r.id});await fails('partner.relate',{partner_id:f.ids.partner,source_type:'event',source_id:f.ids.event,contribution_role:'esports'});
 assert.equal((await f.db.query<{n:number}>(`select count(*)::int n from public.portal_access where organization_id=${q(f.ids.org)}`)).rows[0].n,0);
});

test('U08/U09: eventtijden komen exact uit de bron; private inzichten zijn geen toestemming tot publicatie',async()=>{
 const eventPayload={...payload(),starts_at:'2030-01-01T12:00:00Z',ends_at:'2030-01-01T13:00:00Z',timezone:'Europe/Brussels'};
 await f.call('publication.draft',{source_type:'event',source_id:f.ids.event,expected_revision:1,payload:eventPayload});
 await fails('publication.draft',{source_type:'event',source_id:f.ids.event,expected_revision:1,payload:{...eventPayload,ends_at:'2030-01-01T14:00:00Z'}});
 await f.owner();await f.db.exec(`update public.events set end_at=null where id=${q(f.ids.event)}`);await f.actor(f.ids.chair);await fails('publication.draft',{source_type:'event',source_id:f.ids.event,expected_revision:2,payload:eventPayload});
 const p=await f.call('consent.purpose',{purpose_code:'private_platform_insights',text_version:1,title:'TESTFIXTURE privédoel',body:'TESTFIXTURE uitsluitend privéinzichten',allowed_scope:{fields:['display_name']},legal_basis:'TESTFIXTURE',retention_policy:'TESTFIXTURE',policy_document_id:f.ids.policyDoc});await f.call('consent.activate_purpose',{id:p.id,policy_confirmed:true});const c=await f.call('consent.give',{purpose_id:p.id,scope:{fields:['display_name']},accepted:true});await fails('publication.draft',{source_type:'news',source_id:f.ids.content,expected_revision:1,payload:payload(),consent_id:c.id});
 const choices=await f.db.query<{s:unknown[]}>(`select public.f1_publication_consents(${q(f.ids.org)}) s`);assert.deepEqual(choices.rows[0].s,[]);
});
async function publication(extra:Record<string,unknown>={}){const r=await f.call('publication.draft',{source_type:'news',source_id:f.ids.content,expected_revision:1,payload:payload(),...extra});const row=await f.db.query<{payload_sha256:string}>(`select payload_sha256 from public.publication_revisions where id=${q(r.id)}`);return {...r,expected_hash:row.rows[0].payload_sha256};}

