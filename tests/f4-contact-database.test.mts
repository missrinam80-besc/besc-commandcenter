import test from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {f1Database,q,j} from './helpers/f1-database.mts';
import {intakeOwnSchema,intakeDetailSchema} from '../src/lib/f4-intake-contract.ts';
test('Contact: selected policy, current handler, own receipt, private reply and permanent policy closure',async()=>{
 const f=await f1Database();try{
 const sessions=new Map<string,string>();for(const u of[f.ids.chair,f.ids.member,f.ids.reviewer]){const id=randomUUID();sessions.set(u,id);await f.owner();await f.db.exec(`update auth.users set email_confirmed_at=now()where id=${q(u)};insert into auth.sessions(id,user_id)values(${q(id)},${q(u)});`);}
 const actor=async(u:string)=>{await f.owner();await f.actor(u);await f.db.exec(`select set_config('request.jwt.claims',${q(JSON.stringify({sub:u,role:'authenticated',session_id:sessions.get(u)}))},false)`);};
 const site=randomUUID(),until=new Date(Date.now()+3600000).toISOString(),key='TESTFIXTURE contact never used live';await f.owner();await f.db.exec(`insert into public.publication_sites(id,organization_id,host,active,key_sha256,created_by)values(${q(site)},${q(f.ids.org)},'website-dev.belgianstreamerscommunity.be',true,${q(createHash('sha256').update(key).digest('hex'))},${q(f.ids.chair)});update public.organization_members set status='pending'where user_id=${q(f.ids.member)}and organization_id=${q(f.ids.org)};`);
 const call=async(op:string,data:unknown,id=randomUUID())=>(await f.db.query<{v:{id:string}}>(`select public.f4_intake_workflow(${q(site)},${q(op)},${j(data)},${q(id)})v`)).rows[0].v;
 const configure=async(data:unknown,id=randomUUID())=>(await f.db.query<{v:{id:string}}>(`select public.f4_contact_configure(${q(site)},${j(data)},${q(id)})v`)).rows[0].v;
 const me=async()=>intakeOwnSchema.parse((await f.db.query<{v:unknown}>(`select public.f4_intake_me(${q(site)})v`)).rows[0].v),detail=async(id:string)=>intakeDetailSchema.parse((await f.db.query<{v:unknown}>(`select public.f4_intake_application(${q(site)},${q(id)})v`)).rows[0].v);
 await actor(f.ids.chair);await f.db.query(`select public.f4_workflow(${q(site)},'access.assign',${j({person_id:f.ids.otherPerson,proof_document_id:f.ids.proof,valid_until:until,may_view:false})},${q(randomUUID())})`);
 const formData={category:'general_contact',slug:'testfixture-contact',version:1,title:'TESTFIXTURE NIET PUBLICEREN',notice_version:'TEST-v1',notice_body:'TESTFIXTURE contactbehandeling zonder marketing',legal_basis:'TESTFIXTURE nog vast te stellen',retention_policy:'TESTFIXTURE geen echte bewaartermijn',policy_document_id:f.ids.policyDoc,opens_at:new Date(Date.now()-1000).toISOString(),closes_at:until};
 const form=await call('form.create',formData);await call('form.open',{id:form.id,policy_confirmed:true,reason:'TESTFIXTURE'});await assert.rejects(configure({form_id:form.id,expected_version:0,enabled:true,reason:'TESTFIXTURE'}),/handler_required/);
 const handler=await call('handler.assign',{form_id:form.id,user_id:f.ids.reviewer,proof_document_id:f.ids.proof,valid_until:until});await configure({form_id:form.id,expected_version:0,enabled:true,reason:'TESTFIXTURE'});await assert.rejects(configure({form_id:form.id,expected_version:0,enabled:false,reason:'TESTFIXTURE stale'}),/version_conflict/);
 await actor(f.ids.member);assert.equal((await me()).forms.length,1);await assert.rejects(configure({form_id:form.id,expected_version:1,enabled:false,reason:'TESTFIXTURE'}),/not_authorized/);await assert.rejects(f.db.query('select * from private.contact_settings'),/permission denied/);
 const data={form_id:form.id,notice_version:'TEST-v1',notice_acknowledged:true,payload:{subject:'TESTFIXTURE subject',message:'TESTFIXTURE PRIVATE CONTACT'}};
 await assert.rejects(call('application.submit',{...data,notice_acknowledged:false}),/invalid_input/);const request=randomUUID(),app=await call('application.submit',data,request);assert.deepEqual(await call('application.submit',data,request),app);const saved=await detail(app.id);assert.equal(saved.category,'general_contact');assert.equal(saved.form.notice_version,'TEST-v1');assert(!JSON.stringify(await me()).includes('PRIVATE CONTACT'));
 await actor(f.ids.chair);await assert.rejects(f.db.query(`select public.f4_intake_admin_application(${q(site)},${q(app.id)})`),/not_authorized/);
 await actor(f.ids.reviewer);await call('application.claim',{id:app.id,expected_version:1});await call('application.update',{id:app.id,expected_version:2,status:'needs_information',own_message:'TESTFIXTURE visible question',internal_note:'TESTFIXTURE INTERNAL'});await actor(f.ids.member);const own=await detail(app.id);assert(!JSON.stringify(own).includes('INTERNAL'));await call('application.reply',{id:app.id,expected_version:3,message:'TESTFIXTURE answer'});
 await actor(f.ids.chair);await call('handler.revoke',{id:handler.id,reason:'TESTFIXTURE'});await actor(f.ids.member);assert.equal((await me()).forms.length,0);await assert.rejects(call('application.submit',data),/contact_not_open/);assert.equal((await detail(app.id)).version,4);
 await actor(f.ids.chair);await call('handler.assign',{form_id:form.id,user_id:f.ids.reviewer,proof_document_id:f.ids.proof,valid_until:until});await actor(f.ids.member);assert.equal((await me()).forms.length,1);
 await f.owner();const original=(await f.db.query<{label:string}>(`select label from public.document_registry where id=${q(f.ids.policyDoc)}`)).rows[0].label;await f.db.exec(`update public.document_registry set label='TESTFIXTURE changed policy'where id=${q(f.ids.policyDoc)};update public.document_registry set label=${q(original)}where id=${q(f.ids.policyDoc)}`);
 await actor(f.ids.member);assert.equal((await me()).forms.length,0);await assert.rejects(call('application.submit',data),/contact_not_open/);assert.deepEqual(await call('application.submit',data,request),app);await call('application.withdraw',{id:app.id,expected_version:4});assert.equal((await detail(app.id)).status,'withdrawn');
 await actor(f.ids.chair);const cfg=(await f.db.query<{v:{contact:{enabled:boolean;version:number}}}>(`select public.f4_intake_admin(${q(site)})v`)).rows[0].v.contact;assert.equal(cfg.enabled,false);assert.equal(cfg.version,2);
 }finally{await f.db.close();}
});
