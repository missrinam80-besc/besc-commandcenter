import assert from "node:assert/strict";import test from "node:test";
import {handleSlotBotRequest} from "../src/lib/event-slot-bot-api.ts";import {hashBotKey,type BotClient} from "../src/lib/bot-api.ts";
const org="10000000-0000-4000-8000-000000000001",guild="100000000000000001",discord="200000000000000001",id="30000000-0000-4000-8000-000000000001",lease="40000000-0000-4000-8000-000000000001",key=`bb_slot-fixture.${"x".repeat(43)}`;
const client:BotClient={id:"slot-fixture",organizationId:org,guildId:guild,keyHash:hashBotKey(key),scopes:["slots:deliver"],expiresAt:"2099-01-01T00:00Z",revoked:false};
function fixture(){const ops:{op:string;data:Record<string,unknown>}[]=[];let verified=true;const deps={clients:[client],identity:{findAccount:async()=>({userId:"account",verifiedDiscordId:verified?discord:null,banned:false})},store:{operation:async(op:string,data:Record<string,unknown>)=>{ops.push({op,data});return {id,lease_token:lease,recipient:discord,account_user_id:"account",subject:"TESTFIXTURE",body:"TESTFIXTURE",email:"private@example.com",verification_hash:"never-expose"};}}};const run=(op="claim",body:Record<string,unknown>={},c:BotClient=client)=>handleSlotBotRequest(new Request(`https://example.invalid/api/v1/bot/slot-messages/${op}`,{method:"POST",headers:{authorization:`Bearer ${key}`,"content-type":"application/json"},body:JSON.stringify({guild_id:guild,worker_id:"fixture-worker",...body})}),{...deps,clients:[c]});return {run,ops,unlink:()=>{verified=false;}};}
test("DMclaim is scope- en servergebonden en geeft geen e-mail, account-id of verificatiehash vrij",async()=>{const f=fixture();const response=await f.run();assert.equal(response.status,200);const body=await response.text();assert.ok(body.includes(discord));assert.doesNotMatch(body,/private@example|verification_hash|account_user_id/);assert.equal(f.ops[0].data.organization_id,org);assert.equal((await f.run("claim",{guild_id:"999999999999999999"})).status,403);assert.equal((await f.run("claim",{}, {...client,scopes:["events:read"]})).status,403);});
test("actuele Discordidentity wordt bij claim én dispatch gecontroleerd; ontkoppeling valt terug op mail",async()=>{const f=fixture();f.unlink();assert.equal((await f.run()).status,200);assert.deepEqual(f.ops.map(x=>x.op),["claim","fallback"]);f.ops.length=0;assert.equal((await f.run("dispatch",{id,lease_token:lease})).status,409);assert.deepEqual(f.ops.map(x=>x.op),["inspect","fallback"]);});
test("geen willekeurige ontvanger, ingetrokken sleutel, of extra payloadvelden",async()=>{const f=fixture();assert.equal((await f.run("claim",{discord_user_id:discord})).status,400);assert.equal((await f.run("claim",{}, {...client,revoked:true})).status,401);assert.equal(f.ops.length,0);});
