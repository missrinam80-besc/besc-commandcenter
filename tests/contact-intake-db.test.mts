import assert from "node:assert/strict";
import test from "node:test";
import { readFileSync } from "node:fs";
import { PGlite } from "@electric-sql/pglite";
const org="10000000-0000-4000-8000-000000000001",other="10000000-0000-4000-8000-000000000002";
const uid=(n:number)=>`20000000-0000-4000-8000-${String(n).padStart(12,"0")}`;
const migration=(name:string)=>readFileSync(`supabase/migrations/${name}`,"utf8");

test("contactintake koppelt wachtende accounts en centrale personen aan sponsorbedrijven zonder toegang te wijzigen",async()=>{
 const db=new PGlite();try{
  await db.exec(`create role authenticated;create role anon;create schema auth;create schema private;
   create function auth.uid() returns uuid language sql stable as $$select nullif(current_setting('request.jwt.claim.sub',true),'')::uuid$$;
   create table auth.users(id uuid primary key,email text,email_confirmed_at timestamptz);
   create table public.organizations(id uuid primary key);create table public.profiles(id uuid primary key,display_name text);
   create table public.organization_members(organization_id uuid,user_id uuid references public.profiles(id),role text,status text,primary key(organization_id,user_id));
   create function private.is_active_member(o uuid) returns boolean language sql stable security definer set search_path='' as $$select exists(select 1 from public.organization_members where organization_id=o and user_id=auth.uid() and status='active')$$;
   create function private.is_org_admin(o uuid) returns boolean language sql stable security definer set search_path='' as $$select exists(select 1 from public.organization_members where organization_id=o and user_id=auth.uid() and status='active' and role='admin')$$;
   create function private.is_org_manager(o uuid) returns boolean language sql stable security definer set search_path='' as $$select exists(select 1 from public.organization_members where organization_id=o and user_id=auth.uid() and status='active' and role in('admin','board'))$$;
   grant usage on schema auth,private to authenticated;
   grant select,update on public.organization_members to authenticated;
   alter table public.organization_members enable row level security;
   create policy members_read on public.organization_members for select to authenticated using(private.is_org_manager(organization_id) or user_id=auth.uid());
   create policy admin_write on public.organization_members for update to authenticated using(private.is_org_admin(organization_id)) with check(private.is_org_admin(organization_id));
   insert into public.organizations values('${org}'),('${other}');`);
  const community=migration("20260722100000_add_operational_modules.sql").match(/create table public\.community_people \([\s\S]*?\n\);/)![0];
  await db.exec(community+`alter table public.community_people enable row level security;grant select,insert,update,delete on public.community_people to authenticated;
   create policy people_read on public.community_people for select to authenticated using(private.is_active_member(organization_id));
   create policy people_write on public.community_people for all to authenticated using(private.is_org_manager(organization_id)) with check(private.is_org_manager(organization_id));
   create table public.portal_access(id uuid primary key default gen_random_uuid(),organization_id uuid,user_id uuid,access_type text,status text,community_person_id uuid references public.community_people(id));
   alter table public.portal_access enable row level security;grant select,insert,update on public.portal_access to authenticated;
   create policy portal_admin on public.portal_access for all to authenticated using(private.is_org_admin(organization_id)) with check(private.is_org_admin(organization_id));`);
  await db.exec(migration("20260803133000_add_central_person_roles_and_account_link.sql"));
  await db.exec(migration("20261003100000_add_streamteam_person_role.sql"));
  for(let n=1;n<=12;n++)await db.query(`insert into auth.users values($1,$2,$3);`,[uid(n),`fixture${n}@example.com`,n===7?null:"2026-10-01T00:00:00Z"]);
  for(let n=1;n<=12;n++)await db.query(`insert into public.profiles values($1,$2);`,[uid(n),n===10?"x":`TESTFIXTURE account ${n}`]);
  for(let n=1;n<=12;n++)await db.query(`insert into public.organization_members values($1,$2,$3,$4)`,[org,uid(n),n===1?"admin":n===3?"board":"volunteer",n<=3||n===6||n===7||n===8||n===10?"active":"pending"]);
  const person=async(name:string,email:string|null=null,account:string|null=null,organization=org)=>
   (await db.query<{id:string}>(`insert into public.community_people(organization_id,display_name,email,account_user_id,notes,created_by) values($1,$2,$3,$4,'Bestaande afspraken',$5) returning id`,[organization,name,email,account,uid(1)])).rows[0].id;
  const explicit=await person("Bestaande naam",null,uid(2));
  const byEmail=await person("Bestaand bestuurslid"," FIXTURE3@EXAMPLE.COM ");
  const ambiguous1=await person("Dubbel A","fixture6@example.com"),ambiguous2=await person("Dubbel B","fixture6@example.com");
  const unverified=await person("Niet bevestigd","fixture7@example.com");
  const deleted=await person("Verwijderd",null,uid(8));await db.query(`update public.community_people set deleted_at=now() where id=$1`,[deleted]);
  const sameName=await person("TESTFIXTURE account 11");
  const streamer=await person("Bestaande streamer");
  await db.query(`insert into public.portal_access(organization_id,user_id,access_type,status,community_person_id) values($1,$2,'streamer','active',$3)`,[org,uid(4),streamer]);
  await db.query(`insert into public.portal_access(organization_id,user_id,access_type,status) values($1,$2,'sponsor','active')`,[org,uid(5)]);
  await db.exec(migration("20261008065014_account_community_contacts.sql"));
  const linked=async(n:number)=>(await db.query<{id:string;display_name:string;notes:string;person_type:string;status:string}>(`select * from public.community_people where organization_id=$1 and account_user_id=$2 and deleted_at is null`,[org,uid(n)])).rows;
  assert.equal((await linked(2))[0].id,explicit);assert.equal((await linked(2))[0].display_name,"Bestaande naam");
  assert.equal((await linked(3))[0].id,byEmail);assert.equal((await linked(3))[0].notes,"Bestaande afspraken");
  assert.equal((await linked(4))[0].id,streamer);assert.equal((await linked(5))[0].person_type,"external");
  assert.equal((await linked(6)).length,0);assert.notEqual((await linked(7))[0].id,unverified);
  assert.equal((await linked(8)).length,0);assert.equal((await linked(9)).length,0);assert.equal((await linked(10))[0].display_name,"Naamloos account");
  await db.exec(`set role authenticated;set request.jwt.claim.sub='${uid(1)}';update public.organization_members set status='active',role='member' where user_id='${uid(9)}';`);
  const first=(await linked(9))[0];assert.equal(first.person_type,"crew");
  await db.exec(`update public.organization_members set status='active' where user_id='${uid(11)}';`);
  assert.equal((await linked(11)).length,0);
  assert.equal((await db.query(`select id from public.community_people where id=$1`,[sameName])).rows.length,1);
  await db.query(`insert into public.portal_access(organization_id,user_id,access_type,status) values($1,$2,'sponsor','active')`,[org,uid(12)]);
  assert.equal((await linked(12))[0].person_type,"external");
  await db.exec(`update public.portal_access set status='revoked' where user_id='${uid(12)}';`);
  assert.equal((await linked(12)).length,1);
  await db.exec(`update public.organization_members set status='suspended' where user_id='${uid(9)}';update public.organization_members set status='active' where user_id='${uid(9)}';`);
  assert.equal((await linked(9))[0].id,first.id);assert.equal((await linked(9)).length,1);
  await db.query(`select public.link_account_contact($1,$2,$3)`,[org,uid(6),ambiguous1]);assert.equal((await linked(6))[0].id,ambiguous1);
  await assert.rejects(db.query(`select public.link_account_contact($1,$2,$3)`,[org,uid(6),ambiguous2]));
  await assert.rejects(db.query(`select public.link_account_contact($1,$2,$3)`,[org,uid(11),explicit]));
  // A suspended linked account does not make ordinary contact editing fail.
  await db.exec(`update public.organization_members set status='suspended' where user_id='${uid(9)}';`);
  await db.query(`select public.save_community_person_bundle($1,$2::jsonb,$3::text[],$4)`,[org,JSON.stringify({display_name:"Bijgewerkte afspraken",account_user_id:uid(9)}),["member","contact"],first.id]);
  await assert.rejects(db.query(`select public.save_community_person_bundle($1,$2::jsonb,$3::text[],$4)`,[org,JSON.stringify({account_user_id:uid(12)}),[],first.id]));
  await db.exec(`set request.jwt.claim.sub='${uid(3)}';`);await assert.rejects(db.query(`select public.link_account_contact($1,$2,$3)`,[org,uid(11),ambiguous2]));
  await db.exec(`set request.jwt.claim.sub='${uid(1)}';`);await assert.rejects(db.query(`select public.link_account_contact($1,$2,$3)`,[other,uid(11),ambiguous2]));
  await assert.rejects(db.query(`select private.ensure_account_contact($1,$2)`,[org,uid(11)]));
  const security=await db.query<{safe:boolean}>(`select not has_function_privilege('anon','public.link_account_contact(uuid,uuid,uuid)','EXECUTE') and not has_function_privilege('authenticated','private.ensure_account_contact(uuid,uuid)','EXECUTE') and not prosecdef as safe from pg_proc where oid='public.link_account_contact(uuid,uuid,uuid)'::regprocedure`);
  assert.equal(security.rows[0].safe,true);
  await db.exec(`reset role;`);const foreignPerson=await person("Andere organisatie",null,null,other);
  await db.exec(`set role authenticated;set request.jwt.claim.sub='${uid(1)}';`);await assert.rejects(db.query(`select public.link_account_contact($1,$2,$3)`,[org,uid(11),foreignPerson]));

  await db.exec(`reset role;create table public.partners(id uuid primary key,organization_id uuid,deleted_at timestamptz);grant select,update on public.partners to authenticated;alter table public.partners enable row level security;create policy partner_scope on public.partners for all to authenticated using(private.is_org_manager(organization_id)) with check(private.is_org_manager(organization_id));`);
  const table=migration("20260723100000_deepen_operational_modules.sql").match(/create table public\.partner_contacts \([\s\S]*?\n\);/)![0];
  await db.exec(table+`grant select,insert,update on public.partner_contacts to authenticated;alter table public.partner_contacts enable row level security;create policy crm_scope on public.partner_contacts for all to authenticated using(private.is_org_manager(organization_id)) with check(private.is_org_manager(organization_id));create unique index partner_contacts_one_primary_idx on public.partner_contacts(partner_id) where is_primary;`);
  await db.exec(migration("20261008070508_contact_account_intake.sql"));
  await db.query(`insert into public.profiles values($1,'TESTFIXTURE intake pending')`,[uid(13)]);
  await db.query(`insert into public.organization_members values($1,$2,'volunteer','pending')`,[org,uid(13)]);
  const partnerA=uid(101),partnerB=uid(102),partnerForeign=uid(103);
  await db.query(`insert into public.partners values($1,$4,null),($2,$4,null),($3,$5,null)`,[partnerA,partnerB,partnerForeign,org,other]);
  await db.exec(`set role authenticated;set request.jwt.claim.sub='${uid(1)}';`);
  const intake=async(partner:string,values:object,id:string|null=null)=>(await db.query<{id:string}>(`select public.save_partner_contact_intake($1,$2,$3::jsonb,$4) id`,[org,partner,JSON.stringify(values),id])).rows[0].id;
  const sponsor=await intake(partnerA,{name:"TESTFIXTURE sponsorcontact",account_user_id:uid(13),is_primary:true});
  assert.equal((await db.query<{status:string}>(`select status from public.organization_members where user_id=$1`,[uid(13)])).rows[0].status,"pending");
  const pendingPerson=(await db.query<{id:string}>(`select public.save_community_person_bundle($1,$2::jsonb,$3::text[]) id`,[org,JSON.stringify({display_name:"Intake vrijwilliger",account_user_id:uid(13)}),["contact"]])).rows[0].id;
  await assert.rejects(intake(partnerA,{community_person_id:pendingPerson}));
  await intake(partnerA,{account_user_id:null},sponsor);
  const central=await intake(partnerA,{community_person_id:pendingPerson});
  const secondCompany=await intake(partnerB,{community_person_id:pendingPerson});
  await assert.rejects(intake(partnerA,{community_person_id:pendingPerson,is_primary:true}));
  await assert.rejects(intake(partnerA,{name:"Conflicterend account",community_person_id:pendingPerson,account_user_id:uid(1),is_primary:true}));
  await assert.rejects(intake(partnerA,{name:"Duplicaat account",account_user_id:uid(13),is_primary:true}));
  assert.equal((await db.query<{id:string}>(`select id from public.partner_contacts where partner_id=$1 and is_primary`,[partnerA])).rows[0].id,sponsor);
  await assert.rejects(intake(partnerForeign,{name:"Andere organisatie"}));
  await assert.rejects(intake(partnerA,{community_person_id:foreignPerson}));
  await assert.rejects(intake(partnerA,{name:"Verwijderde persoon",community_person_id:deleted}));
  await assert.rejects(intake(partnerA,{name:"Geschorst account",account_user_id:uid(9)}));
  await assert.rejects(intake(partnerA,{account_user_id:uid(13)},uid(999)));
  await intake(partnerA,{account_user_id:null},sponsor);
  assert.equal((await db.query<{name:string}>(`select name from public.partner_contacts where id=$1`,[sponsor])).rows[0].name,"TESTFIXTURE sponsorcontact");
  await assert.rejects(db.query(`update public.partner_contacts set partner_id=$1 where id=$2`,[partnerB,central]));
  await db.exec(`set request.jwt.claim.sub='${uid(2)}';`);
  await assert.rejects(intake(partnerA,{name:"Vrijwilliger mag niet schrijven"}));
  await db.exec(`set request.jwt.claim.sub='${uid(3)}';`);
  await intake(partnerB,{role_title:"Bestuur intake"},secondCompany);
  await db.exec(`reset role;update public.partners set deleted_at=now() where id='${partnerB}';set role authenticated;set request.jwt.claim.sub='${uid(1)}';`);
  await assert.rejects(intake(partnerB,{name:"Verwijderd bedrijf"}));
  assert.equal((await db.query<{status:string}>(`select status from public.portal_access where user_id=$1`,[uid(12)])).rows[0].status,"revoked");
  assert.equal((await db.query<{safe:boolean}>(`select not prosecdef and not has_function_privilege('anon',oid,'EXECUTE') as safe from pg_proc where oid='public.save_partner_contact_intake(uuid,uuid,jsonb,uuid)'::regprocedure`)).rows[0].safe,true);
 }finally{await db.close();}
});
