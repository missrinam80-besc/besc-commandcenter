import test,{afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {randomBytes,randomUUID} from 'node:crypto';
import {mkdtemp,readdir,readFile,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import path from 'node:path';
import {loadCreatorModule} from './helpers/creator-youtube-local-modules.mjs';
import type {CreatorYouTubePorts} from '../src/lib/creator-youtube-kernel.ts';
const kernelModule=loadCreatorModule('creator-youtube-kernel.ts') as typeof import('../src/lib/creator-youtube-kernel.ts');
const {CreatorYouTubeGoogle}=loadCreatorModule('creator-youtube-google.ts',{'./creator-youtube-kernel':kernelModule}) as typeof import('../src/lib/creator-youtube-google.ts');
const {CreatorYouTubeUserFlow}=loadCreatorModule('creator-youtube-user-flow.ts') as typeof import('../src/lib/creator-youtube-user-flow.ts');
const {CreatorYouTubeOAuthAttempt}=loadCreatorModule('creator-youtube-oauth-attempt.ts') as typeof import('../src/lib/creator-youtube-oauth-attempt.ts');
const {CreatorYouTubeFileStore}=loadCreatorModule('creator-youtube-file-store.ts') as typeof import('../src/lib/creator-youtube-file-store.ts');
const {CreatorYouTubeKeyring}=loadCreatorModule('creator-youtube-keyring.ts') as typeof import('../src/lib/creator-youtube-keyring.ts');
const {CreatorYouTubeProviderInbox}=loadCreatorModule('creator-youtube-provider-inbox.ts') as typeof import('../src/lib/creator-youtube-provider-inbox.ts');
const origin='https://fixture.invalid',channel='UC'+'A'.repeat(22),video='A'.repeat(11),roots:string[]=[];
afterEach(async()=>{for(const root of roots.splice(0)){assert.equal(path.dirname(path.resolve(root)),path.resolve(tmpdir()));assert(path.basename(root).startsWith('besc-ca03-userflow-'));await rm(root,{recursive:true,force:true});}});
async function fixture(){
 const root=await mkdtemp(path.join(tmpdir(),'besc-ca03-userflow-'));roots.push(root);
 const store=await CreatorYouTubeFileStore.create(path.join(root,'attempts')),receiptStore=await CreatorYouTubeFileStore.create(path.join(root,'receipts')),keyStore=await CreatorYouTubeFileStore.create(path.join(root,'keys')),wrappingKey=randomBytes(32),ringId=randomUUID();
 const ring=await CreatorYouTubeKeyring.initialize(keyStore,wrappingKey,ringId),receipts=new CreatorYouTubeProviderInbox(receiptStore,ring,true);
 const link=randomUUID(),owner=randomUUID(),organizationId=randomUUID();let principal={userId:owner,organizationId,sessionId:randomUUID()},now=Date.now(),authenticated=true,active=false,credential:Record<string,unknown>|null=null,finishes=0,ownerCalls=0,revocations=0,exchanges=0,channels=0,revokeStatus=200;
 let channelReply=channel,onChannel:()=>Promise<void>=async()=>undefined;
 const jobs=new Map<string,Record<string,unknown>>();
 const ownerPort:CreatorYouTubePorts['owner']=async(op,id,data)=>{
  ownerCalls++;if(principal.userId!==owner||principal.organizationId!==organizationId)throw Error('Not owner');
  if(op==='consent')return{id:link};if(id!==link)throw Error('Wrong link');
  if(op==='withdraw'){active=false;if(!credential)return{id:link,job_id:null};const jobId=randomUUID();jobs.set(jobId,{id:jobId,kind:'revoke',credentials:credential});return{id:link,job_id:jobId};}
  if(op==='read')return{id:link};
  if(data.kind!=='authorize'&&!active)throw Error('Inactive');
  const jobId=randomUUID();jobs.set(jobId,{id:jobId,kind:data.kind,state_hash:data.state_hash??null,channel_id:channel,video_ids:[video],start_date:'2026-11-01',end_date:'2026-11-06',credentials:credential});return{id:jobId};
 };
 const server:CreatorYouTubePorts['server']=async(jobId,op,data)=>{
  if(!jobs.has(jobId))throw Error('Unknown job');
  if(op==='read')return jobs.get(jobId);
  if(op==='quarantine'){if(active||data.channel_id!==channel)throw Error('No quarantine');credential=data;return{id:link};}
  if(op==='revocation'){if(data.success===true)credential=null;return{id:link};}
  finishes++;if(data.access_token){credential=data;active=true;}return{id:link};
 };
 const google=new CreatorYouTubeGoogle({clientId:'MOCK.apps.googleusercontent.com',clientSecret:'MOCK-SECRET',redirectUri:origin+'/auth/creator-youtube/callback',isolatedProject:true},async(url,init)=>{
  if(url==='https://oauth2.googleapis.com/token'){exchanges++;assert.equal(init.redirect,'error');return Response.json({access_token:'MOCK-ACCESS',refresh_token:'MOCK-REFRESH',token_type:'Bearer',scope:kernelModule.creatorYouTubeScopes.join(' '),expires_in:3600});}
  if(url.startsWith('https://www.googleapis.com/youtube/v3/channels?')){channels++;await onChannel();return Response.json({items:[{id:channelReply}]});}
  if(url==='https://oauth2.googleapis.com/revoke'){revocations++;return new Response(null,{status:revokeStatus});}
  if(url.startsWith('https://youtubeanalytics.googleapis.com/v2/reports?'))return Response.json({columnHeaders:[{name:'video',columnType:'DIMENSION',dataType:'STRING'},...['views','estimatedMinutesWatched','averageViewDuration'].map(name=>({name,columnType:'METRIC',dataType:name==='views'?'INTEGER':'FLOAT'}))],rows:[[video,0,1.5,20]]});
  throw Error('No external transport');
 },()=>now,true,10000); // Normal deadline: the dedicated adapter tests exercise short timeouts separately.
 const kernel=new kernelModule.CreatorYouTubeKernel({owner:ownerPort,server,provider:google},true);
 const makeAttempts=(cipher=ring,responses=receipts)=>new CreatorYouTubeOAuthAttempt({store,kernel,principal:async()=>principal,now:()=>now,responses},cipher,origin+'/auth/creator-youtube/callback',true);
 const make=(enabled=true,attempts=makeAttempts())=>new CreatorYouTubeUserFlow({authenticate:async()=>{if(!authenticated)throw Error('Unauthenticated');},kernel,attempts,google},origin,enabled);
 let flow=make(),cookie='';
 const post=async(body:unknown,options:{headers?:Record<string,string>;cookie?:string;method?:string}={})=>{
  const response=await flow.action(new Request(origin+'/api/creator-youtube',{method:options.method??'POST',headers:{Origin:origin,'Content-Type':'application/json',Cookie:options.cookie??cookie,...options.headers},body:JSON.stringify(body)}));
  const next=response.headers.get('Set-Cookie');if(next)cookie=next.includes('Max-Age=0')?'':next.split(';')[0];return response;
 };
 const consent={accepted:true as const,purpose:'TESTFIXTURE - NIET PUBLICEREN',channel_id:channel,video_ids:[video],start_date:'2026-11-01',end_date:'2026-11-06',valid_until:new Date(now+86400000).toISOString(),retain_until:new Date(now+172800000).toISOString()};
 const start=async()=>{const response=await post({action:'start',consent});assert.equal(response.status,200);const data=await response.json();return{response,data,state:new URL(data.authorizationUrl).searchParams.get('state')!};};
 const callback=async(state:string,query='code=MOCK-CODE',overrideCookie=cookie)=>{
  const response=await flow.callback(new Request(origin+'/auth/creator-youtube/callback?state='+state+'&'+query,{headers:{Cookie:overrideCookie}}));const next=response.headers.get('Set-Cookie');if(next)cookie=next.includes('Max-Age=0')?'':next.split(';')[0];return response;
 };
 return{root,link,kernel,google,make,start,callback,post,consent,flow:()=>flow,cookie:()=>cookie,active:()=>active,counts:()=>({ownerCalls,exchanges,channels,revocations,finishes}),setAuth:(v:boolean)=>{authenticated=v;},setPrincipal:(p:Partial<typeof principal>)=>{principal={...principal,...p};},setNow:(v:number)=>{now=v;},now:()=>now,setChannel:(v:string)=>{channelReply=v;},onChannel:(fn:()=>Promise<void>)=>{onChannel=fn;},setRevoke:(v:number)=>{revokeStatus=v;},restart:async()=>{const reopened=await CreatorYouTubeKeyring.open(keyStore,wrappingKey,ringId);flow=make(true,makeAttempts(reopened,new CreatorYouTubeProviderInbox(receiptStore,reopened,true)));}};
}
test('CA03 user flow: defaults off before authentication, storage or owner use',async()=>{const f=await fixture(),off=new CreatorYouTubeUserFlow({authenticate:async()=>{throw Error('Unexpected auth');},kernel:f.kernel,attempts:{} as never,google:f.google},origin);const response=await off.action(new Request(origin+'/api/creator-youtube',{method:'POST'}));assert.equal(response.status,503);assert.equal(f.counts().ownerCalls,0);});
test('CA03 user flow: start requires exact explicit consent and sets only secure HttpOnly browser ticket',async()=>{const f=await fixture();assert.equal((await f.post({action:'start',consent:{...f.consent,accepted:false}})).status,400);const {response,data}=await f.start(),cookie=response.headers.get('Set-Cookie')!;for(const flag of ['__Host-besc-creator-youtube=','Secure','HttpOnly','SameSite=Lax','Path=/'])assert(cookie.includes(flag));for(const secret of ['MOCK-SECRET','MOCK-ACCESS','MOCK-REFRESH','browserNonce','codeVerifier'])assert(!JSON.stringify(data).includes(secret));assert(!cookie.includes('MOCK'));assert.equal(f.counts().exchanges,0);assert.equal(response.headers.get('Cache-Control'),'no-store, private');assert.equal(response.headers.get('Referrer-Policy'),'no-referrer');});
test('CA03 user flow: missing origin, cross-site origin/fetch metadata and wrong content type cause no owner changes',async()=>{for(const headers of ([{Origin:''},{Origin:'https://evil.invalid'},{'Sec-Fetch-Site':'cross-site'},{'Content-Type':'text/plain'}] as Record<string,string>[])){const f=await fixture();assert.equal((await f.post({action:'start',consent:f.consent},{headers})).status,400);assert.equal(f.counts().ownerCalls,0);}});
test('CA03 user flow: unauthenticated actions/callbacks cannot use provider or owner',async()=>{const f=await fixture();f.setAuth(false);assert.equal((await f.post({action:'start',consent:f.consent})).status,400);assert.match((await f.callback('a'.repeat(64))).headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().ownerCalls,0);});
test('CA03 user flow: full mocked authorize, collect, refresh, disconnect uses captured adapter chain',async()=>{const f=await fixture(),start=await f.start();assert.match((await f.callback(start.state)).headers.get('Location')!,/completed$/);assert(f.active());assert.equal(f.cookie(),'');assert.equal(f.counts().exchanges,1);assert.equal((await f.post({action:'collect',link:f.link})).status,200);assert.equal((await f.post({action:'prepare-refresh',link:f.link})).status,200);assert.equal(f.counts().exchanges,1);assert(f.cookie());assert.equal((await f.post({action:'refresh'})).status,200);assert.equal(f.counts().exchanges,2);assert.equal(f.cookie(),'');assert.equal((await f.post({action:'disconnect',link:f.link})).status,200);assert(!f.active());assert.equal(f.counts().revocations,1);});
test('CA03 user flow: callback binds actual session, state and browser before exchanging code',async()=>{for(const variant of ['session','owner','organization','state','cookie']){const f=await fixture(),start=await f.start();if(variant==='session')f.setPrincipal({sessionId:randomUUID()});if(variant==='owner')f.setPrincipal({userId:randomUUID()});if(variant==='organization')f.setPrincipal({organizationId:randomUUID()});const response=await f.callback(variant==='state'?'0'.repeat(64):start.state,'code=MOCK-CODE',variant==='cookie'?'':f.cookie());assert.match(response.headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().exchanges,0);assert(!f.active());}});
test('CA03 user flow: repeated callback cannot exchange again even with copied old cookie',async()=>{const f=await fixture(),start=await f.start(),oldCookie=f.cookie();await f.callback(start.state);assert.match((await f.callback(start.state,'code=MOCK-CODE',oldCookie)).headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().exchanges,1);});
test('CA03 user flow: duplicate callbacks, code+error and cookie shadowing cannot consume valid request',async()=>{const f=await fixture(),start=await f.start(),cookie=f.cookie();for(const query of ['code=MOCK&code=OTHER','code=MOCK&error=access_denied','code=MOCK&state='+start.state])assert.match((await f.callback(start.state,query)).headers.get('Location')!,/not_confirmed$/);assert.match((await f.callback(start.state,'code=MOCK',cookie+'; '+cookie)).headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().exchanges,0);assert.match((await f.callback(start.state)).headers.get('Location')!,/completed$/);});
test('CA03 user flow: denial never echoes provider error or code and never calls token endpoint',async()=>{const f=await fixture(),start=await f.start(),response=await f.callback(start.state,'error=MOCK-PRIVATE&error_description=MOCK-TOKEN');assert.equal(response.status,303);assert.match(response.headers.get('Location')!,/cancelled$/);assert(!JSON.stringify([...response.headers]).includes('MOCK'));assert.equal(f.counts().exchanges,0);});
test('CA03 user flow: channel mismatch is captured before validation and never activates',async()=>{const f=await fixture(),start=await f.start();f.setChannel('UC'+'B'.repeat(22));assert.match((await f.callback(start.state)).headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().finishes,0);assert.equal(f.counts().exchanges,1);assert(f.counts().revocations>=1);assert(!f.active());});
test('CA03 user flow: interruption during channel check leaves encrypted captured response and supports cleanup after restart',async()=>{const f=await fixture(),start=await f.start();f.setRevoke(503);f.onChannel(async()=>{throw Error('MOCK-PRIVATE-NETWORK-ERROR');});const response=await f.callback(start.state);assert.match(response.headers.get('Location')!,/not_confirmed$/);assert(f.cookie());assert(!f.active());assert.equal(f.counts().finishes,0);const ids=await readdir(path.join(f.root,'receipts'));assert(ids.length>0);for(const id of ids)for(const file of await readdir(path.join(f.root,'receipts',id))){const content=await readFile(path.join(f.root,'receipts',id,file),'utf8');assert(!content.includes('MOCK-ACCESS'));assert(!content.includes('MOCK-REFRESH'));}await f.restart();f.setRevoke(200);const recovered=await f.post({action:'recover'});assert.equal(recovered.status,200);assert.equal((await recovered.json()).provider,'complete');assert.equal(f.cookie(),'');assert.equal(f.counts().exchanges,1);assert(!f.active());});
test('CA03 user flow: cancellation during channel check prevents late activation',async()=>{const f=await fixture(),start=await f.start();let release!:()=>void,entered!:()=>void;const began=new Promise<void>(r=>{entered=r;}),wait=new Promise<void>(r=>{release=r;});f.onChannel(async()=>{entered();await wait;});const callback=f.callback(start.state);await began;try{const cancel=await f.post({action:'cancel'});assert.equal(cancel.status,200);}finally{release();}assert.match((await callback).headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().finishes,0);assert(!f.active());});
test('CA03 user flow: expiry or session change after token capture cannot activate',async()=>{for(const variant of ['expiry','session']){const f=await fixture(),start=await f.start();f.onChannel(async()=>{if(variant==='expiry')f.setNow(f.now()+300001);else f.setPrincipal({sessionId:randomUUID()});});assert.match((await f.callback(start.state)).headers.get('Location')!,/not_confirmed$/);assert.equal(f.counts().finishes,0);assert(!f.active());}});
test('CA03 user flow: unused refresh preparation can cancel without revoking active grant',async()=>{const f=await fixture(),start=await f.start();await f.callback(start.state);await f.post({action:'prepare-refresh',link:f.link});const response=await f.post({action:'cancel'});assert.equal((await response.json()).provider,'none');assert(f.active());assert.equal(f.counts().exchanges,1);assert.equal(f.counts().revocations,0);});
test('CA03 user flow: foreign links and manually supplied job/nonce cannot bypass owner/cookie checks',async()=>{const f=await fixture();for(const action of ['disconnect','collect','prepare-refresh'])assert.equal((await f.post({action,link:randomUUID()})).status,400);assert.equal((await f.post({action:'refresh',jobId:randomUUID(),browserNonce:randomBytes(32).toString('base64url')})).status,400);assert.equal((await f.post({action:'refresh'})).status,400);assert.equal(f.counts().exchanges,0);});
test('CA03 user flow: pending browser ticket must be resolved before a second start or refresh',async()=>{const f=await fixture();await f.start();const count=f.counts().ownerCalls;assert.equal((await f.post({action:'start',consent:f.consent})).status,400);assert.equal((await f.post({action:'prepare-refresh',link:f.link})).status,400);assert.equal(f.counts().ownerCalls,count);});
test('CA03 user flow: oversized JSON and unexpected fields are rejected before creating an owner job',async()=>{const f=await fixture();for(const body of [{action:'start',consent:{...f.consent,purpose:'x'.repeat(8192)}},{action:'disconnect',link:f.link,admin:true}])assert.equal((await f.post(body)).status,400);assert.equal(f.counts().ownerCalls,0);});

test('CA03 user flow: separate disconnect/collect cannot hide unfinished receipt cleanup',async()=>{const f=await fixture(),start=await f.start();await f.callback(start.state);await f.post({action:'prepare-refresh',link:f.link});const count=f.counts().ownerCalls;for(const action of ['disconnect','collect'])assert.equal((await f.post({action,link:f.link})).status,400);assert.equal(f.counts().ownerCalls,count);assert(f.active());assert.equal((await f.post({action:'cancel'})).status,200);});

test('CA03 user flow: denial/unused cancellation resolves without inventing an uncertain provider exchange',async()=>{for(const mode of ['denial','cancel']){const f=await fixture(),start=await f.start();if(mode==='denial')await f.callback(start.state,'error=access_denied');else{const result=await f.post({action:'cancel'});assert.equal((await result.json()).provider,'complete');}assert.equal(f.cookie(),'');assert.equal(f.counts().exchanges,0);assert.equal(f.counts().revocations,0);await f.restart();await f.start();assert(f.cookie());}});
