import test,{afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {fork} from 'node:child_process';
import {randomBytes,randomUUID} from 'node:crypto';
import {mkdtemp,readdir,readFile,rm,rename,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import path from 'node:path';
import {loadCreatorModule} from './helpers/creator-youtube-local-modules.mjs';
import type {CreatorResponseBinding} from '../src/lib/creator-youtube-oauth-attempt.ts';
import type {CreatorYouTubeCleanupOutcome} from '../src/lib/creator-youtube-kernel.ts';
const {CreatorYouTubeFileStore}=loadCreatorModule('creator-youtube-file-store.ts') as typeof import('../src/lib/creator-youtube-file-store.ts');
const {CreatorYouTubeKeyring}=loadCreatorModule('creator-youtube-keyring.ts') as typeof import('../src/lib/creator-youtube-keyring.ts');
const {CreatorYouTubeProviderInbox}=loadCreatorModule('creator-youtube-provider-inbox.ts') as typeof import('../src/lib/creator-youtube-provider-inbox.ts');
const roots:string[]=[];
afterEach(async()=>{for(const root of roots.splice(0)){assert.equal(path.dirname(path.resolve(root)),path.resolve(tmpdir()));assert(path.basename(root).startsWith('besc-ca03-inbox-'));await rm(root,{recursive:true,force:true});}});
function worker(config:Record<string,unknown>){
 const child=fork(new URL('./helpers/creator-youtube-inbox-worker.mjs',import.meta.url),[],{stdio:['ignore','pipe','pipe','ipc'],env:{NODE_ENV:'test',SystemRoot:process.env.SystemRoot,TEMP:process.env.TEMP,TMP:process.env.TMP,PATH:process.env.PATH}});
 const messages:Record<string,unknown>[]=[],waiting:{resolve:(v:Record<string,unknown>)=>void;reject:(e:Error)=>void}[]=[];
 let exited=false;const exit=new Promise<void>(resolve=>child.once('exit',()=>{exited=true;for(const pending of waiting.splice(0))pending.reject(Error('Inbox fixture exited'));resolve();}));
 child.on('message',(message:Record<string,unknown>)=>{const pending=waiting.shift();if(pending)pending.resolve(message);else messages.push(message);});
 child.on('error',error=>{for(const pending of waiting.splice(0))pending.reject(error);});child.send(config);
 return{child,exit,next:()=>new Promise<Record<string,unknown>>((resolve,reject)=>{const message=messages.shift();if(message)resolve(message);else if(exited)reject(Error('Inbox fixture exited'));else waiting.push({resolve,reject});}),kill:async()=>{child.kill('SIGKILL');await exit;}};
}
const answer=()=>({channel_id:'UC'+'A'.repeat(22),scopes:['https://www.googleapis.com/auth/youtube.readonly','https://www.googleapis.com/auth/yt-analytics.readonly'],access_token:'MOCK-ACCESS-SECRET',refresh_token:'MOCK-REFRESH-SECRET',expires_at:new Date(Date.now()+3600000).toISOString()});
async function fixture(){
 const root=await mkdtemp(path.join(tmpdir(),'besc-ca03-inbox-'));roots.push(root);
 const keyRoot=path.join(root,'keys'),receiptRoot=path.join(root,'receipts'),wrappingKey=randomBytes(32),ringId=randomUUID();
 const keyStore=await CreatorYouTubeFileStore.create(keyRoot),store=await CreatorYouTubeFileStore.create(receiptRoot),ring=await CreatorYouTubeKeyring.initialize(keyStore,wrappingKey,ringId);
 const binding:CreatorResponseBinding={jobId:randomUUID(),link:randomUUID(),ownerBinding:randomBytes(32).toString('hex'),browserBinding:randomBytes(32).toString('hex'),stateHash:randomBytes(32).toString('hex')};
 const inbox=new CreatorYouTubeProviderInbox(store,ring,true),reopen=async()=>new CreatorYouTubeProviderInbox(await CreatorYouTubeFileStore.create(receiptRoot),await CreatorYouTubeKeyring.open(keyStore,wrappingKey,ringId),true);
 return{root,keyRoot,receiptRoot,keyStore,store,ring,ringId,wrappingKey,binding,inbox,reopen,config:()=>({keyRoot,receiptRoot,wrappingKey:wrappingKey.toString('base64url'),ringId,binding,answer:answer()})};
}

test('CA03 receipt: defaults off before provider call or receipt write',async()=>{const f=await fixture();let called=false;await assert.rejects(new CreatorYouTubeProviderInbox(f.store,f.ring).receive(f.binding,async()=>{called=true;return answer();}),/disabled/);assert(!called);assert.deepEqual(await readdir(f.receiptRoot),[]);});
test('CA03 receipt: answer is durably sealed before the exchange wrapper returns',async()=>{const f=await fixture(),value=await f.inbox.receive(f.binding,async()=>answer());assert.equal((value as ReturnType<typeof answer>).access_token,answer().access_token);const state=await(await f.reopen()).inspect(f.binding);assert.equal(state?.status,'received');assert.equal(state?.hasAnswer,true);assert(!JSON.stringify(state).includes('MOCK-'));await f.inbox.applied(f.binding);assert.equal((await f.inbox.inspect(f.binding))?.status,'applied');});
test('CA03 receipt: four processes reserve at most one exchange for the same job',async()=>{const f=await fixture(),workers=Array.from({length:4},()=>worker({...f.config(),mode:'receive'}));try{for(const w of workers)assert.equal((await w.next()).armed,true);for(const w of workers)w.child.send({go:true});const results=await Promise.all(workers.map(w=>w.next()));assert.equal(results.filter(r=>r.result==='received').length,1);assert.equal(results.filter(r=>r.error==='fixture_response_not_confirmed').length,3);await Promise.all(workers.map(w=>w.exit));}finally{await Promise.all(workers.map(w=>w.kill()));}assert.equal((await f.inbox.inspect(f.binding))?.status,'received');});
test('CA03 receipt: existing response never causes a repeated code exchange',async()=>{const f=await fixture();let calls=0;const exchange=async()=>{calls++;return answer();};await f.inbox.receive(f.binding,exchange);await assert.rejects((await f.reopen()).receive(f.binding,exchange),/not_confirmed/);assert.equal(calls,1);});
test('CA03 receipt: termination during exchange leaves unknown outcome pending without fabricating a token',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'exchange_crash'});try{assert.equal((await w.next()).paused,'during_exchange');}finally{await w.kill();}let cleanup=0;const inbox=await f.reopen();assert.equal(await inbox.recover(f.binding,async()=>{cleanup++;return 'complete';}),'pending');assert.equal(cleanup,0);assert.equal((await inbox.inspect(f.binding))?.hasAnswer,false);await assert.rejects(inbox.receive(f.binding,async()=>answer()),/not_confirmed/);});
test('CA03 receipt: crash before answer publication keeps the uncommitted outcome open',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'capture_pre_crash'});try{assert.equal((await w.next()).paused,'before_answer_publish');}finally{await w.kill();}let cleanup=0;const inbox=await f.reopen();assert.equal(await inbox.recover(f.binding,async()=>{cleanup++;return 'complete';}),'pending');assert.equal(cleanup,0);assert.equal((await inbox.inspect(f.binding))?.hasAnswer,false);});
test('CA03 receipt: crash after publication but before acknowledgment preserves captured token for cleanup',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'capture_post_crash'});try{assert.equal((await w.next()).paused,'after_answer_publish');}finally{await w.kill();}const inbox=await f.reopen();let credential='';assert.equal(await inbox.recover(f.binding,async value=>{credential=(value as ReturnType<typeof answer>).refresh_token;return 'complete';}),'complete');assert.equal(credential,answer().refresh_token);assert.equal((await inbox.inspect(f.binding))?.status,'complete');});
test('CA03 receipt: crash after capture and before activation only enables cleanup after restart',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'after_receive_crash'});try{assert.equal((await w.next()).paused,'after_capture_before_activation');}finally{await w.kill();}const inbox=await f.reopen();assert.equal(await inbox.recover(f.binding,async()=> 'complete'),'complete');await assert.rejects(inbox.applied(f.binding),/not_confirmed/);await assert.rejects(inbox.receive(f.binding,async()=>answer()),/not_confirmed/);});
test('CA03 receipt: termination during revocation preserves intent and token for retry',async()=>{const f=await fixture();await f.inbox.receive(f.binding,async()=>answer());const w=worker({...f.config(),mode:'cleanup_crash'});try{assert.equal((await w.next()).paused,'during_cleanup');}finally{await w.kill();}assert.equal((await f.inbox.inspect(f.binding))?.status,'cleanup_pending');assert.equal(await(await f.reopen()).recover(f.binding,async()=> 'complete'),'complete');});
test('CA03 receipt: lost final cleanup acknowledgment does not replay authorization',async()=>{const f=await fixture();await f.inbox.receive(f.binding,async()=>answer());const w=worker({...f.config(),mode:'cleanup_ack_crash'});try{assert.equal((await w.next()).paused,'after_cleanup_publish');}finally{await w.kill();}const inbox=await f.reopen();assert.equal((await inbox.inspect(f.binding))?.status,'complete');let cleanup=0;assert.equal(await inbox.recover(f.binding,async()=>{cleanup++;return 'complete';}),'complete');assert.equal(cleanup,1);await assert.rejects(inbox.receive(f.binding,async()=>answer()),/not_confirmed/);});
test('CA03 receipt: applied but incomplete callback can still be safely revoked after restart',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'applied_crash'});try{assert.equal((await w.next()).paused,'after_applied_before_completion');}finally{await w.kill();}const inbox=await f.reopen();assert.equal((await inbox.inspect(f.binding))?.status,'applied');assert.equal(await inbox.recover(f.binding,async()=> 'complete'),'complete');});
test('CA03 receipt: mismatched owner/browser/state/link cannot read or clean captured credentials',async()=>{const f=await fixture();await f.inbox.receive(f.binding,async()=>answer());let called=false;for(const field of ['ownerBinding','browserBinding','stateHash','link'] as const){const binding={...f.binding,[field]:field==='link'?randomUUID():randomBytes(32).toString('hex')};await assert.rejects(f.inbox.recover(binding,async()=>{called=true;return 'complete';}),/not_confirmed/);}assert(!called);assert.equal((await f.inbox.inspect(f.binding))?.status,'received');});
test('CA03 receipt: wrong channel/scopes remain captured for cleanup but never gain an activation path',async()=>{const f=await fixture(),value={...answer(),channel_id:'UC'+'B'.repeat(22),scopes:['https://example.invalid/unwanted']};await f.inbox.receive(f.binding,async()=>value);let captured:unknown;assert.equal(await f.inbox.recover(f.binding,async v=>{captured=v;return 'pending';}),'pending');assert.equal((captured as typeof value).channel_id,value.channel_id);await assert.rejects(f.inbox.applied(f.binding),/not_confirmed/);});
test('CA03 receipt: pending, failed, blocked and uncertain cleanup remain open across restart',async()=>{for(const outcome of ['pending','failed','blocked_isolation','uncertain'] as CreatorYouTubeCleanupOutcome[]){const f=await fixture();await f.inbox.receive(f.binding,async()=>answer());assert.equal(await f.inbox.recover(f.binding,async()=>outcome),outcome);const inbox=await f.reopen();assert.equal((await inbox.inspect(f.binding))?.status,'cleanup_pending');assert.equal(await inbox.recover(f.binding,async()=> 'complete'),'complete');}});
test('CA03 receipt: provider exceptions are sanitized, persist no raw error and never permit a second exchange',async()=>{const f=await fixture();await assert.rejects(f.inbox.receive(f.binding,async()=>{throw Error('MOCK-PROVIDER-SECRET');}),/not_confirmed/);assert.equal((await f.inbox.inspect(f.binding))?.status,'uncertain');assert.equal(await f.inbox.recover(f.binding,async()=> 'complete'),'pending');await assert.rejects(f.inbox.receive(f.binding,async()=>answer()),/not_confirmed/);});
test('CA03 receipt: missing encryption key blocks provider before reservation',async()=>{const f=await fixture();await rename(path.join(f.keyRoot,f.ringId),path.join(f.keyRoot,'fixture-backup'));let called=false;await assert.rejects(f.inbox.receive(f.binding,async()=>{called=true;return answer();}),/not_confirmed/);assert(!called);assert.deepEqual(await readdir(f.receiptRoot),[]);});
test('CA03 receipt: receipt remains decryptable after data-key rotation',async()=>{const f=await fixture();await f.inbox.receive(f.binding,async()=>answer());await f.ring.rotate(randomUUID());assert.equal(await(await f.reopen()).recover(f.binding,async()=> 'complete'),'complete');});
test('CA03 receipt: late response during queued cleanup is captured but never returned for activation',async()=>{const f=await fixture();let entered!:()=>void,release!:()=>void;const started=new Promise<void>(r=>{entered=r;}),gate=new Promise<void>(r=>{release=r;});const receive=f.inbox.receive(f.binding,async()=>{entered();await gate;return answer();}).then(()=>false,()=>true);await started;try{assert.equal(await f.inbox.recover(f.binding,async()=> 'complete'),'pending');}finally{release();}assert.equal(await receive,true);assert.equal((await f.inbox.inspect(f.binding))?.hasAnswer,true);assert.equal(await f.inbox.recover(f.binding,async()=> 'complete'),'complete');});
test('CA03 receipt: largest kernel-supported credentials fit sealed storage and extra fields are discarded',async()=>{const f=await fixture(),value={...answer(),access_token:'A'.repeat(8192),refresh_token:'R'.repeat(8192),id_token:'DISCARD-THIS-EXTRA'};await f.inbox.receive(f.binding,async()=>value);let captured:Record<string,unknown>={};assert.equal(await f.inbox.recover(f.binding,async v=>{captured=v as Record<string,unknown>;return 'complete';}),'complete');assert.equal((captured.access_token as string).length,8192);assert.equal((captured.refresh_token as string).length,8192);assert(!('id_token'in captured));});
test('CA03 receipt: files and status inspection contain no plain tokens or provider extras',async()=>{const f=await fixture();await f.inbox.receive(f.binding,async()=>({...answer(),other:'DISCARD-EXTRA'}));const raw:string[]=[];for(const id of await readdir(f.receiptRoot))for(const file of await readdir(path.join(f.receiptRoot,id)))raw.push(await readFile(path.join(f.receiptRoot,id,file),'utf8'));const text=raw.join('')+JSON.stringify(await f.inbox.inspect(f.binding));for(const secret of [answer().access_token,answer().refresh_token,'DISCARD-EXTRA',f.binding.ownerBinding])assert(!text.includes(secret));});
test('CA03 receipt: failed durable capture acknowledgment is not a successful provider result',async()=>{const f=await fixture(),cas=f.store.compareAndSwap.bind(f.store);f.store.compareAndSwap=async(id,rev,next)=>{const result=await cas(id,rev,next);if(rev===1&&result)throw Error('Lost acknowledgment');return result;};await assert.rejects(f.inbox.receive(f.binding,async()=>answer()),/not_confirmed/);const inbox=await f.reopen();assert.equal((await inbox.inspect(f.binding))?.hasAnswer,true);assert.equal(await inbox.recover(f.binding,async()=> 'complete'),'complete');});
test('CA03 receipt: oversized or malformed provider responses remain unknown without raw error storage',async()=>{for(const value of [{...answer(),access_token:'A'.repeat(8193)},{error:'invalid_grant',error_description:'MOCK-PROVIDER-SECRET'},'MOCK-PROVIDER-SECRET']){const f=await fixture();await assert.rejects(f.inbox.receive(f.binding,async()=>value),/not_confirmed/);const state=await f.inbox.inspect(f.binding);assert.equal(state?.hasAnswer,false);assert.equal(state?.status,'uncertain');assert.equal(await f.inbox.recover(f.binding,async()=> 'complete'),'pending');}});
test('CA03 receipt: missing receipt never fabricates confirmed cleanup',async()=>{const f=await fixture();let called=false;assert.equal(await f.inbox.recover(f.binding,async()=>{called=true;return 'complete';}),'pending');assert(!called);assert.equal(await f.inbox.inspect(f.binding),null);});
test('CA03 receipt: corrupt ciphertext fails closed before cleanup callback',async()=>{const f=await fixture();await f.inbox.receive(f.binding,async()=>answer());const [id]=await readdir(f.receiptRoot),files=(await readdir(path.join(f.receiptRoot,id))).filter(n=>n.endsWith('.json')).sort(),file=path.join(f.receiptRoot,id,files.at(-1)!);const record=JSON.parse(await readFile(file,'utf8'));record.sealed=record.sealed.slice(0,55)+(record.sealed[55]==='A'?'B':'A')+record.sealed.slice(56);await writeFile(file,JSON.stringify(record));let called=false;await assert.rejects(f.inbox.recover(f.binding,async()=>{called=true;return 'complete';}),/not_confirmed/);assert(!called);});
