import assert from "node:assert/strict";
import test from "node:test";
import {readFileSync} from "node:fs";
import {PGlite} from "@electric-sql/pglite";
const org="10000000-0000-4000-8000-000000000001",event="30000000-0000-4000-8000-000000000001",owner="20000000-0000-4000-8000-000000000001",other="20000000-0000-4000-8000-000000000002",slot="40000000-0000-4000-8000-000000000001",bid="50000000-0000-4000-8000-000000000001",bid2="50000000-0000-4000-8000-000000000002";
const fixedSlot={id:slot,title:"TESTFIXTURE shift",kind:"shift",starts_at:"2099-10-14T08:00Z",ends_at:"2099-10-14T10:00Z",capacity:1,is_open:true};
async function fixture(){const db=new PGlite();await db.exec(readFileSync(new URL("./helpers/event-slot-fixture.sql",import.meta.url),"utf8"));await db.exec(readFileSync(new URL("../supabase/migrations/20261007205415_event_schedule.sql",import.meta.url),"utf8"));await db.exec(readFileSync(new URL("../supabase/migrations/20261014213254_event_slot_bookings.sql",import.meta.url),"utf8"));await db.exec(`set role authenticated;select set_config('request.jwt.claim.sub','${owner}',false)`);return db;}
async function rpc(db:PGlite,op:string,data:unknown){return db.query<Record<string,unknown>>(`select event_slot_owner($1,$2,$3,$4) result`,[org,event,op,JSON.stringify(data)]);}
async function setup(db:PGlite){await rpc(db,"save_slot",{...fixedSlot,id:""});await db.exec(`reset role;update event_time_slots set id='${slot}';set role authenticated`);const r=await rpc(db,"page",{published:true});return (r.rows[0] as {result:{public_id:string}}).result.public_id;}
async function pub(db:PGlite,page:string,op:string,data:unknown={}){await db.exec("reset role;set role service_role");return db.query<Record<string,unknown>>(`select event_slot_public($1,$2,$3) result`,[page,op,JSON.stringify(data)]);}
function request(id=bid,email="fixture@example.com"){return {id,slot_id:slot,name:"TESTFIXTURE persoon",email,hash:"a".repeat(64),ip_hash:"b".repeat(64),verification_url:"https://example.invalid/inschrijven/test#code=fixture"};}
test("publieke verificatie maakt exact één voorlopige agenda-inschrijving en eigenaarmelding",async()=>{const db=await fixture();try{const page=await setup(db);await pub(db,page,"request",request());await db.exec("reset role");assert.equal((await db.query<Record<string,unknown>>("select count(*) n from event_schedule_items")).rows[0].n,0);await pub(db,page,"verify",{id:bid,hash:"a".repeat(64)});await pub(db,page,"verify",{id:bid,hash:"a".repeat(64)});await db.exec("reset role");assert.equal((await db.query<Record<string,unknown>>("select status,booking_name from event_schedule_items")).rows[0].status,"draft");assert.equal((await db.query<Record<string,unknown>>("select count(*) n from notifications")).rows[0].n,1);assert.equal((await db.query<Record<string,unknown>>("select count(*) n from private.event_slot_messages")).rows[0].n,2);}finally{await db.close();}});
test("geverifieerde voorlopige aanvraag blokkeert de laatste plek; afwijzen geeft vrij",async()=>{const db=await fixture();try{const page=await setup(db);await pub(db,page,"request",request());await pub(db,page,"request",request(bid2,"second@example.com"));await pub(db,page,"verify",{id:bid,hash:"a".repeat(64)});await assert.rejects(pub(db,page,"verify",{id:bid2,hash:"a".repeat(64)}),/slot_full/);await db.exec(`reset role;set role authenticated`);await rpc(db,"decide",{id:bid,slot_id:slot,status:"rejected"});await pub(db,page,"verify",{id:bid2,hash:"a".repeat(64)});await db.exec("reset role");assert.equal((await db.query<Record<string,unknown>>("select count(*) n from event_slot_bookings where status='pending'")).rows[0].n,1);}finally{await db.close();}});
test("uitsluitend actuele eigenaar beslist; bevestigen en herhalen blijven idempotent",async()=>{const db=await fixture();try{await setup(db);await rpc(db,"book",{...request(),channel:"email"});await db.exec(`select set_config('request.jwt.claim.sub','${other}',false)`);await assert.rejects(rpc(db,"decide",{id:bid,slot_id:slot,status:"confirmed"}),/slot_owner_required/);await db.exec(`select set_config('request.jwt.claim.sub','${owner}',false)`);await rpc(db,"decide",{id:bid,slot_id:slot,status:"confirmed"});await rpc(db,"decide",{id:bid,slot_id:slot,status:"confirmed"});await db.exec("reset role");assert.equal((await db.query<Record<string,unknown>>("select status from event_schedule_items")).rows[0].status,"confirmed");assert.equal((await db.query<Record<string,unknown>>("select count(*) n from private.event_slot_messages where kind='confirmed'")).rows[0].n,1);}finally{await db.close();}});
test("directe agenda-aanpassing, anonieme RPC en boekingsinzage van andere leden zijn geblokkeerd",async()=>{const db=await fixture();try{const page=await setup(db);await rpc(db,"book",request());await assert.rejects(db.exec("update event_schedule_items set status='confirmed'"),/slot_schedule_managed/);await assert.rejects(db.exec("delete from event_schedule_items"),/slot_schedule_managed/);await db.exec(`select set_config('request.jwt.claim.sub','${other}',false)`);assert.equal((await db.query<Record<string,unknown>>("select * from event_slot_bookings")).rows.length,0);await assert.rejects(db.query<Record<string,unknown>>("select event_slot_public($1,'list','{}')",[page]),/permission denied/);await db.exec("reset role;set role anon");await assert.rejects(db.exec("select * from event_slot_bookings"),/permission denied/);}finally{await db.close();}});
test("verkeerde, verlopen links, capaciteit verlagen en slotverplaatsing worden geweigerd",async()=>{const db=await fixture();try{const page=await setup(db);await pub(db,page,"request",request());await assert.rejects(pub(db,page,"verify",{id:bid,hash:"c".repeat(64)}),/slot_verification_invalid/);await db.exec("reset role;update event_slot_bookings set verification_expires_at=now()-interval '1 minute'");await assert.rejects(pub(db,page,"verify",{id:bid,hash:"a".repeat(64)}),/slot_verification_expired/);await db.exec("reset role;update event_slot_bookings set verification_expires_at=now()+interval '1 hour'");await pub(db,page,"verify",{id:bid,hash:"a".repeat(64)});await db.exec("reset role;set role authenticated");await assert.rejects(rpc(db,"save_slot",{...fixedSlot,starts_at:"2099-10-15T08:00Z"}),/slot_has_bookings/);await assert.rejects(rpc(db,"save_slot",{...fixedSlot,capacity:0}),/slot_capacity_below_bookings/);}finally{await db.close();}});

test("categorieën van boekbare slots kunnen niet stil verdwijnen",async()=>{const db=await fixture();try{await setup(db);await db.exec("reset role");await assert.rejects(db.exec("delete from dossier_choice_options where value='shift'"),/choice_in_use/);}finally{await db.close();}});

test("verzendleases voorkomen dubbele claims en onzekere verzending wordt niet opnieuw verstuurd",async()=>{const db=await fixture();try{await setup(db);await rpc(db,"book",request());await db.exec("reset role;set role service_role");const operate=async(op:string,d:Record<string,unknown>)=>(await db.query<{result:Record<string,unknown>}>("select event_slot_message($1,$2) result",[op,JSON.stringify(d)])).rows[0].result;const d={channel:"email",worker:"fixture-worker"},m=await operate("claim",d);assert.ok(m.id);assert.deepEqual(await operate("claim",{...d,worker:"second-worker"}),{});await operate("dispatch",{...d,id:m.id,lease_token:m.lease_token});await db.exec("reset role;update private.event_slot_messages set lease_until=now()-interval '1 minute';set role service_role");assert.deepEqual(await operate("claim",d),{});await db.exec("reset role");assert.equal((await db.query<{state:string}>("select state from private.event_slot_messages")).rows[0].state,"uncertain");}finally{await db.close();}});
test("publiek overzicht toont uitsluitend beschikbare slots en geen boekers of e-mailadressen",async()=>{const db=await fixture();try{const page=await setup(db);await rpc(db,"book",request());const list=await pub(db,page,"list");const raw=JSON.stringify(list.rows);assert.match(raw,/available/);assert.doesNotMatch(raw,/fixture@example.com|TESTFIXTURE persoon|verification_hash|ip_hash/);}finally{await db.close();}});

test("nieuwe datalaag heeft RLS en geen anonieme EXECUTE op schrijffuncties",async()=>{const db=await fixture();try{await db.exec("reset role");const rows=await db.query<{relname:string;relrowsecurity:boolean}>("select relname,relrowsecurity from pg_class where relname in('event_slot_pages','event_time_slots','event_slot_bookings','event_slot_messages')");assert.equal(rows.rows.length,4);assert.ok(rows.rows.every(row=>row.relrowsecurity));const funcs=await db.query<{proname:string;anon:boolean;member:boolean}>("select proname,has_function_privilege('anon',p.oid,'EXECUTE') anon,has_function_privilege('authenticated',p.oid,'EXECUTE') member from pg_proc p where proname in('event_slot_public','event_slot_message','slot_project','slot_enqueue')");assert.equal(funcs.rows.length,4);assert.ok(funcs.rows.every(row=>!row.anon&&!row.member));}finally{await db.close();}});

test("een vol slot onthult via een heraanvraag niet of een e-mailadres al ingeschreven is",async()=>{const db=await fixture();try{const page=await setup(db);await pub(db,page,"request",request());await pub(db,page,"verify",{id:bid,hash:"a".repeat(64)});await assert.rejects(pub(db,page,"request",request(bid2,"fixture@example.com")),/slot_full/);await assert.rejects(pub(db,page,"request",request(bid2,"other@example.com")),/slot_full/);}finally{await db.close();}});
