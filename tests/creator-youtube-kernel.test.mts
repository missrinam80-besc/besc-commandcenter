import type {CreatorAttemptCipher,CreatorAttemptStore,CreatorResponsePort,CreatorResponseBinding} from '../src/lib/creator-youtube-oauth-attempt.ts';
const native=createRequire(import.meta.url),compiled={exports:{} as typeof import('../src/lib/creator-youtube-kernel.ts')};
runInNewContext(ts.transpileModule(readFileSync(new URL('../src/lib/creator-youtube-kernel.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module:compiled,exports:compiled.exports,Buffer,require:(name:string)=>name==='server-only'?{}:native(name)});
const {CreatorYouTubeKernel,creatorYouTubeScopes}=compiled.exports;
const flowCompiled={exports:{} as typeof import('../src/lib/creator-youtube-oauth-attempt.ts')};
runInNewContext(ts.transpileModule(readFileSync(new URL('../src/lib/creator-youtube-oauth-attempt.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module:flowCompiled,exports:flowCompiled.exports,Buffer,URL,require:(name:string)=>name==='server-only'?{}:native(name)});
function flowFor(kernel:InstanceType<typeof CreatorYouTubeKernel>,now:()=>number=Date.now,cipher?:CreatorAttemptCipher,responses?:CreatorResponsePort){const records=new Map<string,{revision:number;sealed:string}>();return new flowCompiled.exports.CreatorYouTubeOAuthAttempt({kernel,responses,principal:async()=>({organizationId:f.ids.org,userId:f.ids.member,sessionId:sessions.get(f.ids.member)!}),now,store:{read:async id=>records.get(id)??null,compareAndSwap:async(id,revision,next)=>{if((records.get(id)?.revision??null)!==revision)return false;records.set(id,next);return true;}}},cipher??randomBytes(32),'https://fixture.invalid/youtube/callback',true);}
async function testKeyring(){const records=new Map<string,{revision:number;sealed:string}>();const store:CreatorAttemptStore={read:async id=>records.get(id)??null,compareAndSwap:async(id,revision,next)=>{if((records.get(id)?.revision??null)!==revision)return false;records.set(id,next);return true;}};const {CreatorYouTubeKeyring}=loadCreatorModule('creator-youtube-keyring.ts') as typeof import('../src/lib/creator-youtube-keyring.ts');return{ring:await CreatorYouTubeKeyring.initialize(store,randomBytes(32),randomUUID()),records};}
async function testInbox(){const {ring}=await testKeyring(),records=new Map<string,{revision:number;sealed:string}>();const store:CreatorAttemptStore={read:async id=>records.get(id)??null,compareAndSwap:async(id,revision,next)=>{if((records.get(id)?.revision??null)!==revision)return false;records.set(id,next);return true;}};const {CreatorYouTubeProviderInbox}=loadCreatorModule('creator-youtube-provider-inbox.ts') as typeof import('../src/lib/creator-youtube-provider-inbox.ts');return{ring,store,inbox:new CreatorYouTubeProviderInbox(store,ring,true)};}
function receiptBinding(r:{jobId:string;state:string;browserNonce:string},link:string):CreatorResponseBinding{const sha=(s:string)=>createHash('sha256').update(s).digest('hex');return{jobId:r.jobId,link,ownerBinding:sha(JSON.stringify([f.ids.org,f.ids.member,sessions.get(f.ids.member)!])),browserBinding:sha(r.browserNonce),stateHash:sha(r.state)};}
let f:Awaited<ReturnType<typeof f1Database>>;const sessions=new Map<string,string>();
const channel='UC'+'A'.repeat(22),otherChannel='UC'+'B'.repeat(22);
const consent=():CreatorYouTubeConsent=>({accepted:true,purpose:'TESTFIXTURE - NIET PUBLICEREN - creator local consent',channel_id:channel,video_ids:['abcdefghijk'],start_date:'2026-01-01',end_date:'2026-01-02',valid_until:new Date(Date.now()+3600000).toISOString(),retain_until:new Date(Date.now()+7200000).toISOString()});
const token=(suffix='1'):CreatorYouTubeToken=>({channel_id:channel,scopes:[...creatorYouTubeScopes],access_token:'MOCK-ACCESS-'+suffix,refresh_token:'MOCK-REFRESH-'+suffix,expires_at:new Date(Date.now()+3600000).toISOString()});
async function actor(user:string,role='authenticated'){await f.owner();await f.actor(user,role);await f.db.exec(`select set_config('request.jwt.claims',${q(JSON.stringify({sub:user,role,session_id:sessions.get(user)}))},false)`);}
async function statement<T>(sql:string){await f.db.exec('savepoint api');try{const result=(await f.db.query<{v:T}>(sql)).rows[0].v;await f.db.exec('release savepoint api');return result;}catch(e){await f.db.exec('rollback to api');await f.db.exec('release savepoint api');throw e;}}
async function owner(op:string,link:string|null,data:unknown={},user=f.ids.member,org=f.ids.org){await actor(user);return statement<{id:string;job_id?:string|null;status?:string;provider_revocation?:string;samples?:unknown[]}>(`select public.creator_youtube_owner(${q(org)},${q(op)},${link?q(link):'null'},${j(data)}) v`);}
async function server(job:string,op:string,data:unknown={}){await actor(f.ids.admin,'service_role');return statement(`select public.creator_youtube_server(${q(job)},${q(op)},${j(data)}) v`);}
function setup(){const calls:string[]=[];const provider:CreatorYouTubePorts['provider']={isolatedProject:true,exchange:async()=>{calls.push('exchange');return token();},refresh:async()=>{calls.push('refresh');return token('2');},collect:async()=>{calls.push('collect');return[{video_id:'abcdefghijk',metric:'views',value:0,quality:'known'},{video_id:'abcdefghijk',metric:'estimatedMinutesWatched',value:null,quality:'missing'}];},revoke:async()=>{calls.push('revoke');}};const ports:CreatorYouTubePorts={owner:(op,link,data)=>owner(op,link,data),server,provider};return{kernel:new CreatorYouTubeKernel(ports,true),ports,provider,calls};}
async function active(){const s=setup();const link=(await s.kernel.consent(consent())).id;const auth=await s.kernel.beginAuthorization(link);await s.kernel.authorize(auth.jobId,auth.state,'MOCK-CODE');return{...s,link};}
async function privateCount(table:string){await f.owner();return Number((await f.db.query<{n:number}>(`select count(*)::int n from private.${table}`)).rows[0].n);}
before(async()=>{f=await f1Database();await f.owner();for(const id of [f.ids.member,f.ids.admin,f.ids.chair,f.ids.other]){const s=randomUUID();sessions.set(id,s);await f.db.exec(`update auth.users set email_confirmed_at=now() where id=${q(id)};insert into auth.sessions(id,user_id) values(${q(s)},${q(id)})`);}
 // Test-only Vault double: verifies opaque references/rights and cleanup, NOT real Vault encryption.
 await f.db.exec("create or replace function vault.create_secret(v text,n text,d text) returns uuid language plpgsql as $$declare x uuid:=gen_random_uuid();begin insert into vault.fixture_secrets values(x,v);return x;end$$;create or replace function vault.update_secret(x uuid,v text) returns void language plpgsql as $$begin update vault.fixture_secrets set decrypted_secret=v where id=x;end$$;");
});after(async()=>{await f.db.close()});beforeEach(async()=>{await f.owner();await f.db.exec('begin')});afterEach(async()=>{await f.owner();await f.db.exec('rollback')});
test('CA03: kernel defaults off before any database or provider call',async()=>{const s=setup();await assert.rejects(new CreatorYouTubeKernel(s.ports).consent(consent()),/disabled/);assert.equal(await privateCount('cy_links'),0);assert.equal(s.calls.length,0);});
test('CA03: consent is explicit, immutable and owner-derived; no implicit grant or data collection',async()=>{const s=setup();const c=consent(),link=(await s.kernel.consent(c)).id;const state=await owner('read',link);assert.equal(state.status,'pending');assert.deepEqual(state.samples,[]);assert(!JSON.stringify(state).includes('access_token'));assert.equal(s.calls.length,0);await f.owner();assert.equal((await f.db.query<{owner_id:string}>(`select owner_id from private.cy_links where id=${q(link)}`)).rows[0].owner_id,f.ids.member);});
test('CA03: missing acceptance, purpose, retention, video or broad owner fields are rejected',async()=>{const s=setup();for(const change of [{accepted:false},{purpose:''},{retain_until:undefined},{video_ids:[]},{owner_id:f.ids.admin}])await assert.rejects(s.kernel.consent({...consent(),...change} as CreatorYouTubeConsent),/not_confirmed/);assert.equal(await privateCount('cy_links'),0);});
test('CA03: admin, chair, another member and wrong organization have no private creator access',async()=>{const s=await active();for(const user of [f.ids.admin,f.ids.chair,f.ids.other]){await assert.rejects(owner('read',s.link,{},user),/not_available/);await assert.rejects(owner('withdraw',s.link,{},user),/not_available/);}await assert.rejects(owner('read',s.link,{},f.ids.member,f.ids.otherOrg),/not_available/);assert.equal((await owner('read',s.link)).status,'active');});
test('CA03: stable consent request replay is idempotent and changed scope conflicts',async()=>{const data={...consent(),request_id:randomUUID()};const a=await owner('consent',null,data);assert.equal((await owner('consent',null,data)).id,a.id);await assert.rejects(owner('consent',null,{...data,purpose:'Other purpose'}),/request_conflict/);assert.equal(await privateCount('cy_links'),1);});
test('CA03: callback state mismatch stops before code exchange',async()=>{const s=setup(),link=(await s.kernel.consent(consent())).id,auth=await s.kernel.beginAuthorization(link);await assert.rejects(s.kernel.authorize(auth.jobId,'0'.repeat(64),'MOCK-CODE'),/not_confirmed/);assert.equal(s.calls.length,0);assert.equal(await privateCount('cy_credentials'),0);await s.kernel.authorize(auth.jobId,auth.state,'MOCK-CODE');assert.equal((await owner('read',link)).status,'active');});
test('CA03: wrong channel or missing/excessive scopes never become stored credentials',async()=>{for(const change of [{channel_id:otherChannel},{scopes:[creatorYouTubeScopes[0]]},{scopes:[...creatorYouTubeScopes,'https://www.googleapis.com/auth/youtube.upload']}]){await f.db.exec('savepoint variant');const s=setup(),link=(await s.kernel.consent(consent())).id,auth=await s.kernel.beginAuthorization(link);s.provider.exchange=async()=>({...token(),...change});await assert.rejects(s.kernel.authorize(auth.jobId,auth.state,'MOCK-CODE'),/not_confirmed/);assert.equal(await privateCount('cy_credentials'),0);await f.db.exec('rollback to variant');}});
test('CA03: authorized samples preserve zero, missing, exact window and units; public/social store remains empty',async()=>{const s=await active();await s.kernel.collect(s.link);const state=await owner('read',s.link);const samples=state.samples as {metric:string;value:number|null;quality:string;start_date:string;unit:string}[];assert.equal(samples.length,2);assert(samples.some(x=>x.metric==='views'&&x.value===0&&x.quality==='known'&&x.unit==='count'));assert(samples.some(x=>x.value===null&&x.quality==='missing'&&x.unit==='minutes'));assert(samples.every(x=>x.start_date==='2026-01-01'));await f.owner();assert.equal((await f.db.query<{n:number}>('select count(*)::int n from public.social_metric_snapshots')).rows[0].n,0);const audit=JSON.stringify((await f.db.query('select * from private.cy_events')).rows);assert(!audit.includes('MOCK-ACCESS'));assert(!audit.includes('MOCK-REFRESH'));assert(!JSON.stringify(state).includes('MOCK-'));});
test('CA03: refresh rotation is persisted and omitted replacement retains the previous refresh token',async()=>{const s=await active();await s.kernel.refresh(s.link);let seen='';s.provider.refresh=async value=>{seen=value;const t=token('3');delete t.refresh_token;return t;};await s.kernel.refresh(s.link);assert.equal(seen,'MOCK-REFRESH-2');s.provider.refresh=async value=>{seen=value;return token('4');};await s.kernel.refresh(s.link);assert.equal(seen,'MOCK-REFRESH-2');});
test('CA03: raw provider errors never escape to public results',async()=>{const s=setup(),link=(await s.kernel.consent(consent())).id,auth=await s.kernel.beginAuthorization(link);s.provider.exchange=async()=>{throw Error('MOCK-ACCESS-SECRET in provider error')};await assert.rejects(s.kernel.authorize(auth.jobId,auth.state,'MOCK-CODE'),e=>typeof e==='object'&&e!==null&&'message' in e&&e.message==='creator_youtube_not_confirmed');assert.equal(await privateCount('cy_credentials'),0);});
test('CA03: local withdrawal blocks reads before remote revocation and wipes mocked token values after success',async()=>{const s=await active();await s.kernel.collect(s.link);s.provider.revoke=async()=>{const state=await owner('read',s.link);assert.equal(state.status,'revoked');assert.deepEqual(state.samples,[]);await assert.rejects(s.kernel.collect(s.link),/not_confirmed/);};assert.equal((await s.kernel.withdraw(s.link)).provider,'complete');assert.equal(await privateCount('cy_credentials'),0);await f.owner();const secrets=JSON.stringify((await f.db.query('select * from vault.fixture_secrets')).rows);assert(!secrets.includes('MOCK-'));});
test('CA03: failed provider revocation stays locally withdrawn, is not called complete and can retry',async()=>{const s=await active();s.provider.revoke=async()=>{throw Error('provider unavailable MOCK-SECRET')};assert.equal((await s.kernel.withdraw(s.link)).provider,'failed');const state=await owner('read',s.link);assert.equal(state.status,'revoked');assert.equal(state.provider_revocation,'failed');assert.deepEqual(state.samples,[]);s.provider.revoke=async()=>{};assert.equal((await s.kernel.withdraw(s.link)).provider,'complete');});
test('CA03: unverified Google-project isolation blocks provider work but never prevents local withdrawal',async()=>{const s=await active();s.provider.isolatedProject=false;const before=s.calls.length;await assert.rejects(s.kernel.refresh(s.link),/not_confirmed/);assert.equal((await s.kernel.withdraw(s.link)).provider,'blocked_isolation');assert.equal(s.calls.length,before);assert.equal((await owner('read',s.link)).status,'revoked');});
test('CA03: late authorization after withdrawal cannot reactivate; token is quarantined solely for cleanup',async()=>{const s=setup(),link=(await s.kernel.consent(consent())).id,auth=await s.kernel.beginAuthorization(link);s.provider.exchange=async()=>{assert.equal((await s.kernel.withdraw(link)).provider,'pending');return token('late');};await assert.rejects(s.kernel.authorize(auth.jobId,auth.state,'MOCK-CODE'),/not_confirmed/);const state=await owner('read',link);assert.equal(state.status,'revoked');assert.equal(state.provider_revocation,'pending');assert.deepEqual(state.samples,[]);let revoked='';s.provider.revoke=async value=>{revoked=value;};assert.equal((await s.kernel.withdraw(link)).provider,'complete');assert.equal(revoked,'MOCK-REFRESH-late');});
test('CA03: late refresh after withdrawal cannot restore access and rotated token gets cleanup',async()=>{const s=await active();s.provider.refresh=async()=>{await s.kernel.withdraw(s.link);return token('late-refresh')};await assert.rejects(s.kernel.refresh(s.link),/not_confirmed/);assert.equal((await owner('read',s.link)).status,'revoked');assert.equal((await s.kernel.withdraw(s.link)).provider,'complete');});
test('CA03: late measurement cannot be committed after withdrawal',async()=>{const s=await active();s.provider.collect=async()=>{await s.kernel.withdraw(s.link);return[{video_id:'abcdefghijk',metric:'views',value:50,quality:'known'}];};await assert.rejects(s.kernel.collect(s.link),/not_confirmed/);assert.equal(await privateCount('cy_samples'),0);});
test('CA03: request replay, direct writes and server-only ports cannot bypass boundary',async()=>{const s=await active();const ticket=await owner('begin',s.link,{kind:'collect',request_id:randomUUID()});await server(ticket.id,'finish',{rows:[]});await assert.rejects(server(ticket.id,'finish',{rows:[]}),/stale_job/);for(const role of ['anon','authenticated','service_role']){await actor(f.ids.admin,role);for(const table of ['cy_links','cy_credentials','cy_jobs','cy_samples','cy_events'])await assert.rejects(statement(`select to_jsonb(t) v from private.${table} t`),/permission denied/);}await actor(f.ids.member);await assert.rejects(statement(`select public.creator_youtube_server(${q(ticket.id)},'read','{}') v`),/permission denied/);});
test('CA03: expired consent or revoked session blocks stored data and late work',async()=>{const s=await active();const ticket=await owner('begin',s.link,{kind:'collect',request_id:randomUUID()});await f.owner();await f.db.exec(`update private.cy_links set valid_until=clock_timestamp()-interval '1 minute' where id=${q(s.link)}`);assert.deepEqual((await owner('read',s.link)).samples,[]);await assert.rejects(server(ticket.id,'finish',{rows:[]}),/stale_job/);await f.owner();await f.db.exec(`delete from auth.sessions where user_id=${q(f.ids.member)}`);await assert.rejects(owner('read',s.link),/not_available/);});
test('CA03: direct RPC cannot broaden consent or provider scopes',async()=>{await assert.rejects(owner('consent',null,{...consent(),request_id:randomUUID(),owner_id:f.ids.admin}),/invalid_input/);const s=setup(),link=(await s.kernel.consent(consent())).id,auth=await s.kernel.beginAuthorization(link);await assert.rejects(server(auth.jobId,'finish',{...token(),channel_id:otherChannel}),/mismatch/);await assert.rejects(server(auth.jobId,'finish',{...token(),scopes:[...creatorYouTubeScopes,'extra']}),/invalid_credentials/);assert.equal(await privateCount('cy_credentials'),0);});
test('CA03: direct client update/delete cannot bypass immutable purpose or audit',async()=>{await active();for(const role of ['authenticated','anon','service_role']){await actor(f.ids.admin,role);await assert.rejects(statement("update private.cy_links set status='active' returning id v"),/permission denied/);await assert.rejects(statement('delete from private.cy_events returning id v'),/permission denied/);}});
test('CA03: malformed sample batch rolls back earlier rows atomically',async()=>{const s=await active(),ticket=await owner('begin',s.link,{kind:'collect',request_id:randomUUID()});await assert.rejects(server(ticket.id,'finish',{rows:[{video_id:'abcdefghijk',metric:'views',value:10,quality:'known'},{video_id:'12345678901',metric:'views',value:20,quality:'known'}]}),/invalid_samples/);assert.equal(await privateCount('cy_samples'),0);await assert.rejects(server(ticket.id,'finish',{rows:[{video_id:'abcdefghijk',metric:'views',value:null,quality:'known'}]}),/check constraint/);assert.equal(await privateCount('cy_samples'),0);});
test('CA03: second token refresh is reserved out until first ticket completes',async()=>{const s=await active();await owner('begin',s.link,{kind:'refresh',request_id:randomUUID()});await assert.rejects(s.kernel.refresh(s.link),/not_confirmed/);assert(!s.calls.includes('refresh'));});

test('CA03 OAuth integration: sealed PKCE callback reaches actual owner/server SQL chain once',async()=>{const s=setup(),flow=flowFor(s.kernel),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link);let count=0;s.provider.exchange=async(code,_job,context)=>{count++;assert.equal(code,'MOCK-CODE');assert(context);assert.equal(createHash('sha256').update(context.codeVerifier).digest('base64url'),r.codeChallenge);assert.equal(context.redirectUri,r.redirectUri);return token();};assert.equal((await flow.callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal((await owner('read',link)).status,'active');await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal(count,1);assert.equal(await privateCount('cy_credentials'),1);});
test('CA03 OAuth integration: cancellation during exchange leaves real SQL link revoked and late token cleanup pending',async()=>{const s=setup(),flow=flowFor(s.kernel),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link);s.provider.exchange=async()=>{await flow.cancel(r.jobId,r.browserNonce);return token('cancelled-flow');};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);const state=await owner('read',link);assert.equal(state.status,'revoked');assert.deepEqual(state.samples,[]);assert.equal((await s.kernel.withdraw(link)).provider,'complete');assert.equal(await privateCount('cy_credentials'),0);});
test('CA03 OAuth integration: request expiring in provider exchange never activates SQL credentials',async()=>{let now=Date.now();const s=setup(),flow=flowFor(s.kernel,()=>now),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link);s.provider.exchange=async()=>{now+=300001;return token('expired-flow');};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal((await owner('read',link)).status,'revoked');await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='authorize'")).rows[0].n,0);assert.equal(await privateCount('cy_credentials'),0);});
test('CA03 durable integration: recovery keeps an unknown exchange pending until late token cleanup is confirmed',async()=>{let now=Date.now(),entered!:()=>void,release!:()=>void;const started=new Promise<void>(r=>{entered=r;}),gate=new Promise<void>(r=>{release=r;});const s=setup(),flow=flowFor(s.kernel,()=>now),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link);s.provider.exchange=async()=>{entered();await gate;return token('interrupted');};const outcome=flow.callback({...r,code:'MOCK-CODE'}).then(()=>false,()=>true);await started;try{now+=300001;const pending=await flow.recover(r.jobId,r.browserNonce);assert.equal(pending.status,'cleanup_pending');assert.equal(pending.provider,'pending');const state=await owner('read',link);assert.equal(state.status,'revoked');assert.equal(state.provider_revocation,'pending');assert.equal(await privateCount('cy_credentials'),0);}finally{release();}assert.equal(await outcome,true);const recovered=await flow.recover(r.jobId,r.browserNonce);assert.equal(recovered.status,'recovered');assert.equal(recovered.provider,'complete');assert.equal(await privateCount('cy_credentials'),0);await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='authorize'")).rows[0].n,0);});
test('CA03 keyring integration: rotation during callback preserves the SQL consent boundary and activates once',async()=>{const s=setup(),{ring}=await testKeyring(),flow=flowFor(s.kernel,Date.now,ring),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link);s.provider.exchange=async()=>{await ring.rotate(randomUUID());return token();};assert.equal((await flow.callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal((await owner('read',link)).status,'active');assert.equal((await ring.describe()).readableKeyIds.length,2);await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='authorize'")).rows[0].n,1);});
test('CA03 keyring integration: missing keyring blocks code exchange and leaves existing SQL consent pending',async()=>{const s=setup(),{ring,records}=await testKeyring(),flow=flowFor(s.kernel,Date.now,ring),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link);records.clear();await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal(s.calls.length,0);assert.equal((await owner('read',link)).status,'pending');assert.equal(await privateCount('cy_credentials'),0);assert.equal(records.size,0);});
test('CA03 receipt integration: durable answer exists before SQL activation and successful callback confirms receipt',async()=>{const s=setup(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link),original=s.ports.server;s.ports.server=async(job,op,data)=>{if(op==='finish'){const state=await inbox.inspect(binding);assert.equal(state?.status,'received');assert.equal(state?.hasAnswer,true);}return original(job,op,data);};assert.equal((await flow.callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal((await owner('read',link)).status,'active');assert.equal((await inbox.inspect(binding))?.status,'applied');assert.equal(s.calls.filter(c=>c==='exchange').length,1);});
test('CA03 receipt integration: interruption before activation revokes captured token without authorizing again',async()=>{const s=setup(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link),original=s.ports.server;s.ports.server=async(job,op,data)=>{if(op==='finish')throw Error('MOCK INTERRUPTION');return original(job,op,data);};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal((await owner('read',link)).status,'revoked');assert.equal((await inbox.inspect(binding))?.status,'complete');assert.equal(await privateCount('cy_credentials'),0);assert.equal(s.calls.filter(c=>c==='exchange').length,1);assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'recovered');await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='authorize'")).rows[0].n,0);});
test('CA03 receipt integration: lost SQL commit acknowledgment revokes rather than replaying activation',async()=>{const s=setup(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link),original=s.ports.server;s.ports.server=async(job,op,data)=>{const value=await original(job,op,data);if(op==='finish')throw Error('MOCK LOST ACK');return value;};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal((await owner('read',link)).status,'revoked');assert.equal((await inbox.inspect(binding))?.status,'complete');assert.equal(await privateCount('cy_credentials'),0);assert.equal(s.calls.filter(c=>c==='exchange').length,1);});
test('CA03 receipt integration: lost capture acknowledgment never activates and stored answer can be cleaned',async()=>{const s=setup(),{ring,inbox,store}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link),cas=store.compareAndSwap;store.compareAndSwap=async(id,rev,next)=>{const result=await cas(id,rev,next);if(rev===1&&result)throw Error('MOCK LOST CAPTURE ACK');return result;};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal((await owner('read',link)).status,'revoked');assert.equal((await inbox.inspect(binding))?.status,'complete');await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='authorize'")).rows[0].n,0);});
test('CA03 receipt integration: wrong channel, excess scopes and expired token are revoked but unresolved SQL stays pending',async()=>{for(const change of [{channel_id:otherChannel},{scopes:[...creatorYouTubeScopes,'extra']},{expires_at:new Date(Date.now()-60000).toISOString()}]){await f.db.exec('savepoint variant');const s=setup(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link);s.provider.exchange=async()=>({...token(),...change});await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);const state=await owner('read',link);assert.equal(state.status,'revoked');assert.equal(state.provider_revocation,'pending');assert.equal((await inbox.inspect(binding))?.status,'cleanup_pending');assert(s.calls.includes('revoke'));assert.equal(await privateCount('cy_credentials'),0);await f.db.exec('rollback to variant');}});
test('CA03 receipt integration: provider isolation withdrawn during exchange blocks activation and receipt revocation',async()=>{const s=setup(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link);s.provider.exchange=async()=>{s.provider.isolatedProject=false;return token();};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal((await owner('read',link)).status,'revoked');assert.equal((await inbox.inspect(binding))?.outcome,'blocked_isolation');assert(!s.calls.includes('revoke'));assert.equal(await privateCount('cy_credentials'),0);});
test('CA03 receipt integration: cancellation during exchange stores late answer only for cleanup and never activates',async()=>{const s=setup(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),link=(await s.kernel.consent(consent())).id,r=await flow.begin(link),binding=receiptBinding(r,link);s.provider.exchange=async()=>{assert.equal((await flow.cancel(r.jobId,r.browserNonce)).provider,'pending');return token('late-receipt');};await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal((await owner('read',link)).status,'revoked');assert.equal((await inbox.inspect(binding))?.status,'complete');assert.equal(await privateCount('cy_credentials'),0);await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='authorize'")).rows[0].n,0);});
test('CA03 refresh integration: rotated refresh token is persisted and omitted replacement is retained in the sealed answer',async()=>{const s=await active(),{ring,inbox}=await testInbox();let binding:CreatorResponseBinding|undefined;const responses:CreatorResponsePort={receive:(b,perform)=>{binding=b;return inbox.receive(b,perform);},applied:b=>inbox.applied(b),recover:(b,cleanup)=>inbox.recover(b,cleanup)},flow=flowFor(s.kernel,Date.now,ring,responses);const first=await flow.beginRefresh(s.link);assert.equal((await flow.refresh(first.jobId,first.browserNonce)).status,'completed');assert.equal(binding?.kind,'refresh');assert.equal((await inbox.inspect(binding!))?.status,'applied');let previous='';s.provider.refresh=async value=>{previous=value;const value3=token('3');delete value3.refresh_token;return value3;};const second=await flow.beginRefresh(s.link);assert.equal((await flow.refresh(second.jobId,second.browserNonce)).status,'completed');assert.equal(previous,'MOCK-REFRESH-2');const read=await owner('begin',s.link,{kind:'collect',request_id:randomUUID()}),job=await server(read.id,'read') as {credentials:{refresh_token:string}};assert.equal(job.credentials.refresh_token,'MOCK-REFRESH-2');assert.equal((await owner('read',s.link)).status,'active');});
test('CA03 refresh integration: receipt precedes SQL refresh commit and uncertain result is never refreshed twice',async()=>{const s=await active(),{ring,inbox}=await testInbox();let binding!:CreatorResponseBinding;const responses:CreatorResponsePort={receive:(b,perform)=>{binding=b;return inbox.receive(b,perform);},applied:b=>inbox.applied(b),recover:(b,cleanup)=>inbox.recover(b,cleanup)},flow=flowFor(s.kernel,Date.now,ring,responses),r=await flow.beginRefresh(s.link),original=s.ports.server;s.ports.server=async(job,op,data)=>{if(op==='finish'){assert.equal((await inbox.inspect(binding))?.status,'received');assert.equal((await inbox.inspect(binding))?.hasAnswer,true);}return original(job,op,data);};assert.equal((await flow.refresh(r.jobId,r.browserNonce)).status,'completed');await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(s.calls.filter(c=>c==='refresh').length,1);});
test('CA03 refresh integration: lost SQL acknowledgment revokes rotated credentials without another refresh',async()=>{const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),r=await flow.beginRefresh(s.link),original=s.ports.server;s.ports.server=async(job,op,data)=>{const result=await original(job,op,data);if(op==='finish')throw Error('MOCK refresh commit acknowledgment lost');return result;};await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal((await owner('read',s.link)).status,'revoked');assert.equal(await privateCount('cy_credentials'),0);assert.equal(s.calls.filter(c=>c==='refresh').length,1);assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'recovered');await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='refresh'")).rows[0].n,1);});
test('CA03 refresh integration: captured response survives missing refresh token and lost durable acknowledgment',async()=>{const s=await active(),{ring,inbox,store}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),r=await flow.beginRefresh(s.link),cas=store.compareAndSwap;let captured='';s.provider.refresh=async()=>{const value=token('no-rotation');delete value.refresh_token;return value;};const recover=s.kernel.recoverCapturedAuthorization.bind(s.kernel);s.kernel.recoverCapturedAuthorization=async(job,link,value)=>{captured=(value as {refresh_token:string}).refresh_token;return recover(job,link,value);};store.compareAndSwap=async(id,rev,next)=>{const result=await cas(id,rev,next);if(rev===1&&result)throw Error('MOCK receipt acknowledgment lost');return result;};await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(captured,'MOCK-REFRESH-1');assert.equal((await owner('read',s.link)).status,'revoked');assert.equal(await privateCount('cy_credentials'),0);await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='refresh'")).rows[0].n,0);});
test('CA03 refresh integration: cancellation during provider call cleans both old and rotated credentials without reactivation',async()=>{const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),r=await flow.beginRefresh(s.link),revoked:string[]=[];s.provider.revoke=async value=>{assert.equal((await owner('read',s.link)).status,'revoked');revoked.push(value);};s.provider.refresh=async()=>{assert.equal((await flow.cancel(r.jobId,r.browserNonce)).provider,'pending');return token('late-rotation');};await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert(revoked.includes('MOCK-REFRESH-1'));assert(revoked.includes('MOCK-REFRESH-late-rotation'));assert.equal((await owner('read',s.link)).status,'revoked');assert.equal(await privateCount('cy_credentials'),0);await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='refresh'")).rows[0].n,0);});
test('CA03 refresh integration: expired running action holds durable reservation until late response cleanup',async()=>{let now=Date.now(),entered!:()=>void,release!:()=>void;const started=new Promise<void>(r=>{entered=r;}),gate=new Promise<void>(r=>{release=r;});const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,()=>now,ring,inbox),r=await flow.beginRefresh(s.link);let begins=0;const original=s.ports.owner;s.ports.owner=async(op,link,data)=>{if(op==='begin'&&data.kind==='refresh')begins++;return original(op,link,data);};s.provider.refresh=async()=>{s.calls.push('refresh');entered();await gate;return token('after-unknown');};const outcome=flow.refresh(r.jobId,r.browserNonce).then(()=>false,()=>true);await started;try{now+=300001;assert.equal((await flow.recover(r.jobId,r.browserNonce)).provider,'pending');await assert.rejects(flow.beginRefresh(s.link),/not_confirmed/);assert.equal(begins,0);}finally{release();}assert.equal(await outcome,true);assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(s.calls.filter(c=>c==='refresh').length,1);assert.equal((await owner('read',s.link)).status,'revoked');});
test('CA03 refresh integration: unused preparation expiry preserves active grant and respects remaining SQL lease',async()=>{let now=Date.now();const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,()=>now,ring,inbox),r=await flow.beginRefresh(s.link);now+=300001;assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'expired');assert.equal((await owner('read',s.link)).status,'active');assert.equal(s.calls.filter(c=>c==='refresh'||c==='revoke').length,0);await assert.rejects(flow.beginRefresh(s.link),/not_confirmed/);await f.owner();await f.db.exec(`update private.cy_jobs set expires_at=clock_timestamp()-interval '1 second' where id=${q(r.jobId)}`);const next=await flow.beginRefresh(s.link);assert.notEqual(next.jobId,r.jobId);assert.equal((await flow.refresh(next.jobId,next.browserNonce)).status,'completed');assert.equal(s.calls.filter(c=>c==='refresh').length,1);});
test('CA03 refresh integration: invalid channel/scopes/expiry cannot update active credentials',async()=>{for(const change of [{channel_id:otherChannel},{scopes:[...creatorYouTubeScopes,'extra']},{expires_at:new Date(Date.now()-60000).toISOString()}]){await f.db.exec('savepoint refresh_variant');const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),r=await flow.beginRefresh(s.link);s.provider.refresh=async()=>({...token('invalid-rotation'),...change});await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal((await owner('read',s.link)).status,'revoked');assert.equal(await privateCount('cy_credentials'),0);await f.owner();assert.equal((await f.db.query<{n:number}>("select count(*)::int n from private.cy_events where operation='refresh'")).rows[0].n,0);await f.db.exec('rollback to refresh_variant');}});
test('CA03 refresh integration: project isolation failure after response blocks storage and revocation calls',async()=>{const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),r=await flow.beginRefresh(s.link);s.provider.refresh=async()=>{s.provider.isolatedProject=false;return token('blocked-rotation');};await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal((await owner('read',s.link)).status,'revoked');assert(!s.calls.includes('revoke'));assert.equal((await flow.recover(r.jobId,r.browserNonce)).provider,'blocked_isolation');await assert.rejects(flow.beginRefresh(s.link),/not_confirmed/);});
test('CA03 refresh integration: other owner and wrong job kind cannot invoke provider refresh',async()=>{const s=await active(),{ring,inbox}=await testInbox(),flow=flowFor(s.kernel,Date.now,ring,inbox),original=s.ports.owner;s.ports.owner=(op,link,data)=>owner(op,link,data,f.ids.admin);await assert.rejects(flow.beginRefresh(s.link),/not_confirmed/);s.ports.owner=original;const r=await flow.beginRefresh(s.link);await assert.rejects(s.kernel.authorize(r.jobId,'0'.repeat(64),'MOCK-CODE'),/not_confirmed/);assert.equal(s.calls.filter(c=>c==='refresh').length,0);assert.equal((await owner('read',s.link)).status,'active');});
