import assert from "node:assert/strict";import test from "node:test";import {readFileSync} from "node:fs";import {createRequire} from "node:module";import {runInNewContext} from "node:vm";import {createHash} from "node:crypto";import ts from "typescript";
import {slotContactSchema,slotError} from "../src/lib/event-slot-bookings.ts";
const page="10000000-0000-4000-8000-000000000001",id="20000000-0000-4000-8000-000000000001",slot="30000000-0000-4000-8000-000000000001",account="40000000-0000-4000-8000-000000000001",discord="100000000000000001";
function harness(linked=false){const calls:Record<string,unknown>[]=[],later:(()=>Promise<void>)[]=[];let mails=0;const native=createRequire(import.meta.url),compiled={exports:{} as Record<string,(state:unknown,fd:FormData)=>Promise<{ok:boolean;message:string}>>};
 const overrides:Record<string,unknown>={"next/server":{after:(fn:()=>Promise<void>)=>later.push(fn)},"next/headers":{headers:async()=>new Headers({"x-forwarded-for":"198.51.100.1, 192.0.2.5"})},"next/cache":{revalidatePath(){}},"@/lib/bot-api-upstream":{withBotUpstream:async(fn:(fetcher:typeof fetch)=>Promise<unknown>)=>fn(fetch)},"@/lib/supabase/admin":{createAdminClient:()=>({rpc:async(name:string,args:Record<string,unknown>)=>{calls.push({name,...args});return {data:{status:"pending"},error:null};}})},"@/lib/supabase/server":{createClient:async()=>({auth:{getUser:async()=>({data:{user:{id:account,email:"fixture@example.com",email_confirmed_at:"2026-01-01T00:00Z",identities:[]}},error:null})},from:()=>{const q:any={select:()=>q,eq:()=>q,maybeSingle:async()=>({data:{id:account,discord_user_id:linked?discord:null},error:null})};return q;}})},"@/lib/profile-identities":{findIdentity:()=>null,discordIdentityDetails:()=>linked?{userId:discord}:null},"@/lib/event-slot-bookings":{slotContactSchema,slotError},"@/lib/event-slot-server":{flushSlotEmails:async()=>{mails++;},slotMailReady:()=>true,slotOrigin:()=>"https://example.invalid",slotRequestHash:(ip:string)=>{assert.equal(ip,"192.0.2.5");return "b".repeat(64);},slotTokenHash:(token:string)=>createHash("sha256").update(token).digest("hex")}};
 runInNewContext(ts.transpileModule(readFileSync(new URL("../src/app/inschrijven/[page]/actions.ts",import.meta.url),"utf8"),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module:compiled,exports:compiled.exports,process:{env:{BESC_SLOT_DISCORD_NOTIFICATIONS_ENABLED:"true"}},require:(name:string)=>name in overrides?overrides[name]:native(name)});
 const fd=new FormData();for(const [key,value]of Object.entries({page,id,slot_id:slot,name:"TESTFIXTURE persoon",email:"Fixture@Example.com",channel:"email"}))fd.set(key,value);
 return {actions:compiled.exports,fd,calls,later,mails:()=>mails};
}
test("publieke actie bewaart alleen een hash in de boeking, geeft geen code terug en mailt na het antwoord",async()=>{const f=harness();const result=await f.actions.startSlotRequest({ok:false,message:""},f.fd);assert.equal(result.ok,true);assert.equal(f.calls.length,1);const d=f.calls[0].d as Record<string,string>;assert.equal(d.email,"fixture@example.com");assert.match(d.hash,/^[a-f0-9]{64}$/);assert.match(d.verification_url,/#code=[A-Za-z0-9_-]{43}$/);assert.doesNotMatch(result.message,/#code=|verification_hash/);assert.equal(f.mails(),0);assert.equal(f.later.length,1);await f.later[0]();assert.equal(f.mails(),1);});
test("los opgegeven Discordidentity verleent geen DM-kanaal; geverifieerde sessie bepaalt de ontvanger",async()=>{const f=harness();f.fd.set("channel","discord");f.fd.set("discord_user_id",discord);assert.equal((await f.actions.startSlotRequest({},f.fd)).ok,false);assert.equal(f.calls.length,0);const linked=harness(true);linked.fd.set("channel","discord");linked.fd.set("account_user_id","attacker");assert.equal((await linked.actions.startSlotRequest({},linked.fd)).ok,true);const d=linked.calls[0].d as Record<string,string>;assert.equal(d.account_user_id,account);assert.equal(d.discord_user_id,discord);});
