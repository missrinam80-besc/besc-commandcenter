import assert from "node:assert/strict";import test from "node:test";import {readFileSync} from "node:fs";import {createRequire} from "node:module";import {runInNewContext} from "node:vm";import ts from "typescript";
test("Gmail-concept en verzenden delen het annuleringssignaal met de tokenaanvraag en fetch",async()=>{
 const seen:AbortSignal[]=[],signal=new AbortController().signal,native=createRequire(import.meta.url);const compiled={exports:{} as {saveGmailDraft:(input:unknown,signal:AbortSignal)=>Promise<unknown>;sendGmailDraft:(id:string,signal:AbortSignal)=>Promise<unknown>}};
 const source=readFileSync(new URL("../src/lib/google-gmail.ts",import.meta.url),"utf8");runInNewContext(ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module:compiled,exports:compiled.exports,Buffer,process:{env:{GOOGLE_GMAIL_SENDER:"fixture@example.com"}},require:(name:string)=>name==="@/lib/google-workspace"?{googleAccessToken:async(options:{signal:AbortSignal})=>{seen.push(options.signal);options.signal.throwIfAborted();return "fixture-token";}}:native(name),fetch:async(_url:string,init:RequestInit)=>{seen.push(init.signal as AbortSignal);return Response.json({id:"fixture-result"});}});
 await compiled.exports.saveGmailDraft({to:["receiver@example.com"],subject:"TESTFIXTURE",body:"TESTFIXTURE"},signal);await compiled.exports.sendGmailDraft("fixture-draft",signal);assert.equal(seen.length,4);assert.ok(seen.every(value=>value===signal));const abort=new AbortController();abort.abort();await assert.rejects(compiled.exports.sendGmailDraft("fixture-draft",abort.signal));
});
