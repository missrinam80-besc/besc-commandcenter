import assert from "node:assert/strict";import test from "node:test";
import {deliverSlotEmail,type SlotMessage} from "../src/lib/event-slot-delivery.ts";
const message:SlotMessage={id:"fixture",lease_token:"lease",draft_id:null,recipient:"fixture@example.com",subject:"TESTFIXTURE",body:"TESTFIXTURE"};
test("mailworker legt eerst concept en dispatch vast en bevestigt pas na extern verzendresultaat",async()=>{const seen:string[]=[];const result=await deliverSlotEmail({claim:async()=>message,draft:async()=>{seen.push("draft-create");return "draft";},operation:async op=>{seen.push(op);},send:async()=>{seen.push("send-external");return "gmail-message";}});assert.equal(result,"sent");assert.deepEqual(seen,["draft-create","draft","dispatch","send-external","sent"]);});
test("mislukte leasebevestiging verzendt niets, onzeker verzenden wordt alleen als fail teruggekoppeld",async()=>{let sends=0;const seen:string[]=[];assert.equal(await deliverSlotEmail({claim:async()=>message,draft:async()=>"draft",operation:async op=>{seen.push(op);if(op==="dispatch")throw Error("lease expired");},send:async()=>{sends++;return "id";}}),"unconfirmed");assert.equal(sends,0);assert.deepEqual(seen,["draft","dispatch","fail"]);seen.length=0;await deliverSlotEmail({claim:async()=>({...message,draft_id:"existing"}),draft:async()=>{throw Error("must reuse");},operation:async op=>{seen.push(op);},send:async()=>{throw Error("response lost");}});assert.deepEqual(seen,["dispatch","fail"]);});
