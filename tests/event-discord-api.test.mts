import test from 'node:test';
import assert from 'node:assert/strict';
import {handleEventSyncRequest}from'../src/lib/event-discord-bot-api.ts';
import{hashBotKey,type BotClient}from'../src/lib/bot-api.ts';
const guild='1067893182387474432',org='11111111-1111-4111-8111-111111111111',key='bb_fixture-events.'+'a'.repeat(43);
function fixture(){let calls=0,answer:Record<string,unknown>={job:null},seen:Record<string,unknown>={};const client:BotClient={id:'fixture-events',organizationId:org,guildId:guild,keyHash:hashBotKey(key),expiresAt:'2099-01-01T00:00:00Z',revoked:false,scopes:['events:sync']};
const run=(body:unknown={guild_id:guild,worker_id:'event_fixture'},op='claim',enabled=true)=>handleEventSyncRequest(new Request('https://cc.invalid/api/v1/bot/event-sync/'+op,{method:'POST',headers:{authorization:'Bearer '+key,'content-type':'application/json'},body:JSON.stringify(body)}),{enabled,clients:()=>[client],store:()=>({operation:async(_op,data)=>{calls++;seen=data;return answer;}}),siteOrigin:'https://cc.invalid'});
return{client,run,calls:()=>calls,seen:()=>seen,answer:(v:Record<string,unknown>)=>{answer=v;}};}
test('Disabled event API makes zero upstream calls',async()=>{const f=fixture();assert.equal((await f.run(undefined,'claim',false)).status,404);assert.equal(f.calls(),0);});
test('Server derives organization, client and namespaced worker, never from caller input',async()=>{const f=fixture(),r=await f.run();assert.equal(r.status,200);assert.equal(r.headers.get('cache-control'),'no-store');assert.equal(f.seen().organization_id,org);assert.equal(f.seen().client_id,'fixture-events');assert.equal(f.seen().worker,'fixture-events:event_fixture');for(const extra of ['organization_id','client_id','worker','site_origin'])assert.equal((await f.run({guild_id:guild,worker_id:'event_fixture',[extra]:'forged'})).status,400);assert.equal(f.calls(),1);});
test('Incorrect guild, revoked credentials and missing specific scope stop before store',async()=>{const f=fixture();assert.equal((await f.run({guild_id:'333333333333333333',worker_id:'event_fixture'})).status,403);assert.equal((await f.run({guild_id:guild},'interest_targets')).status,403);f.client.revoked=true;assert.equal((await f.run()).status,401);assert.equal(f.calls(),0);});
test('Unknown operations, oversized snapshots and malformed store output fail closed',async()=>{const f=fixture();assert.equal((await f.run(undefined,'unknown')).status,400);f.client.scopes=['events:interest'];assert.equal((await f.run({guild_id:guild,publication_id:org,discord_event_id:guild,user_ids:Array(5001).fill(guild),observed_at:new Date().toISOString()},'interest_snapshot')).status,400);f.client.scopes=['events:sync'];f.answer({job:{secret:'NEVER_RETURN'}});const r=await f.run();assert.equal(r.status,503);assert.ok(!(await r.text()).includes('NEVER_RETURN'));});
