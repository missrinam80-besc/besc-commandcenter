import test from 'node:test';
import assert from 'node:assert/strict';
import {createHash,randomBytes,randomUUID} from 'node:crypto';
import {readFileSync} from 'node:fs';
import {createRequire} from 'node:module';
import {runInNewContext} from 'node:vm';
import ts from 'typescript';
import type {CreatorAttemptStore} from '../src/lib/creator-youtube-oauth-attempt.ts';
import type {CreatorYouTubeKernel} from '../src/lib/creator-youtube-kernel.ts';

const native=createRequire(import.meta.url),compiled={exports:{} as typeof import('../src/lib/creator-youtube-oauth-attempt.ts')};
runInNewContext(ts.transpileModule(readFileSync(new URL('../src/lib/creator-youtube-oauth-attempt.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module:compiled,exports:compiled.exports,Buffer,URL,require:(name:string)=>name==='server-only'?{}:native(name)});
const {CreatorYouTubeOAuthAttempt}=compiled.exports;
function fixture(){
 const records=new Map<string,{revision:number;sealed:string}>(),key=randomBytes(32),link=randomUUID();
 const store:CreatorAttemptStore={read:async id=>{const r=records.get(id);return r?{...r}:null;},compareAndSwap:async(id,expected,next)=>{const old=records.get(id);if((old?.revision??null)!==expected)return false;records.set(id,{...next});return true;}};
 let now=Date.now(),principal={organizationId:randomUUID(),userId:randomUUID(),sessionId:randomUUID()},withdrawn=false;
 const calls:{code:string;context:unknown}[]=[];
 const kernel:Pick<CreatorYouTubeKernel,'beginAuthorization'|'authorize'|'withdraw'>={beginAuthorization:async()=>({jobId:randomUUID(),state:randomBytes(32).toString('hex')}),authorize:async(_job,_state,code,context)=>{calls.push({code,context});},withdraw:async()=>{withdrawn=true;return{local:true,provider:'complete'};}};
 const ports={store,kernel,principal:async()=>principal,now:()=>now};
 const make=(enabled=true,k=key,uri='https://fixture.invalid/youtube/callback')=>new CreatorYouTubeOAuthAttempt(ports,k,uri,enabled);
 return{records,key,link,store,kernel,calls,make,setNow:(n:number)=>{now=n;},now:()=>now,setPrincipal:(p:typeof principal)=>{principal=p;},principal:()=>principal,withdrawn:()=>withdrawn};
}
const callback=(request:Awaited<ReturnType<InstanceType<typeof CreatorYouTubeOAuthAttempt>['begin']>>)=>({jobId:request.jobId,state:request.state,browserNonce:request.browserNonce,code:'MOCK-CODE'});

test('CA03 OAuth: defaults off before any principal, kernel or storage use',async()=>{const f=fixture();await assert.rejects(f.make(false).begin(f.link),/disabled/);assert.equal(f.records.size,0);assert.equal(f.calls.length,0);});
test('CA03 OAuth: configuration rejects short keys, HTTP and ambiguous redirect URIs',()=>{const f=fixture();assert.throws(()=>f.make(true,randomBytes(31)),/configuration/);for(const uri of ['http://fixture.invalid/callback','https://user@fixture.invalid/callback','https://fixture.invalid/callback?next=evil','https://fixture.invalid/callback#code'])assert.throws(()=>f.make(true,f.key,uri),/configuration/);});
test('CA03 OAuth: RFC7636 S256 verifier stays encrypted and reaches only server exchange',async()=>{const f=fixture(),flow=f.make(),request=await flow.begin(f.link);assert.equal(request.codeChallengeMethod,'S256');assert.equal(request.codeChallenge.length,43);assert(!('codeVerifier' in request));assert.equal((await flow.callback(callback(request))).status,'completed');const context=f.calls[0].context as {codeVerifier:string;redirectUri:string};assert.match(context.codeVerifier,/^[A-Za-z0-9_-]{43}$/);assert.equal(createHash('sha256').update(context.codeVerifier).digest('base64url'),request.codeChallenge);assert.equal(context.redirectUri,request.redirectUri);const raw=JSON.stringify([...f.records.values()]);for(const secret of [context.codeVerifier,request.browserNonce,request.state,f.link,'MOCK-CODE'])assert(!raw.includes(secret));});
test('CA03 OAuth: encrypted request survives a fresh coordinator with same key/store',async()=>{const f=fixture(),request=await f.make().begin(f.link);assert.equal((await f.make().callback(callback(request))).status,'completed');});
test('CA03 OAuth: each request has independent state, browser nonce and PKCE challenge',async()=>{const f=fixture(),flow=f.make(),a=await flow.begin(f.link),b=await flow.begin(f.link);for(const key of ['jobId','state','browserNonce','codeChallenge'] as const)assert.notEqual(a[key],b[key]);});
test('CA03 OAuth: wrong owner, organization or current session never exchanges code',async()=>{for(const field of ['organizationId','userId','sessionId'] as const){const f=fixture(),flow=f.make(),request=await flow.begin(f.link);f.setPrincipal({...f.principal(),[field]:randomUUID()});await assert.rejects(flow.callback(callback(request)),/not_confirmed/);assert.equal(f.calls.length,0);assert(!f.withdrawn());}});
test('CA03 OAuth: wrong state/browser/missing attempt rejects without consuming legitimate request',async()=>{const f=fixture(),flow=f.make(),request=await flow.begin(f.link);for(const change of [{state:'0'.repeat(64)},{browserNonce:randomBytes(32).toString('base64url')},{jobId:randomUUID()}])await assert.rejects(flow.callback({...callback(request),...change}),/not_confirmed/);assert.equal(f.calls.length,0);assert(!f.withdrawn());assert.equal((await flow.callback(callback(request))).status,'completed');});
test('CA03 OAuth: repeated callback never repeats provider exchange',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);await flow.callback(callback(r));await assert.rejects(flow.callback(callback(r)),/not_confirmed/);assert.equal(f.calls.length,1);});
test('CA03 OAuth: atomic claim allows only one of two simultaneous callbacks',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);const results=await Promise.allSettled([flow.callback(callback(r)),f.make().callback(callback(r))]);assert.equal(results.filter(x=>x.status==='fulfilled').length,1);assert.equal(f.calls.length,1);});
test('CA03 OAuth: denied authorization is terminal and never exchanges or persists provider error',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);assert.equal((await flow.callback({jobId:r.jobId,state:r.state,browserNonce:r.browserNonce,error:'MOCK-PROVIDER-SECRET'})).status,'cancelled');assert(f.withdrawn());assert.equal(f.calls.length,0);assert(!JSON.stringify([...f.records]).includes('MOCK-PROVIDER-SECRET'));await assert.rejects(flow.callback(callback(r)),/not_confirmed/);});
test('CA03 OAuth: exact expiry boundary withdraws and blocks code exchange',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);f.setNow(f.now()+300000);assert.equal((await flow.callback(callback(r))).status,'expired');assert(f.withdrawn());assert.equal(f.calls.length,0);await assert.rejects(flow.callback(callback(r)),/not_confirmed/);});
test('CA03 OAuth: malformed callback cannot accidentally complete or consume a valid request',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);for(const change of [{code:undefined},{error:'access_denied'},{code:''},{code:'x'.repeat(8193)}])await assert.rejects(flow.callback({...callback(r),...change}),/not_confirmed/);assert.equal(f.calls.length,0);assert.equal((await flow.callback(callback(r))).status,'completed');});
test('CA03 OAuth: cancellation requires actual binding and blocks later callback',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);await assert.rejects(flow.cancel(r.jobId,randomBytes(32).toString('base64url')),/not_confirmed/);assert(!f.withdrawn());assert.equal((await flow.cancel(r.jobId,r.browserNonce)).status,'cancelled');assert(f.withdrawn());await assert.rejects(flow.callback(callback(r)),/not_confirmed/);assert.equal(f.calls.length,0);});
test('CA03 OAuth: cancellation racing a running exchange cannot report completion',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);let entered!:()=>void,release!:()=>void;const started=new Promise<void>(resolve=>{entered=resolve;}),gate=new Promise<void>(resolve=>{release=resolve;});f.kernel.authorize=async()=>{entered();await gate;};const result=flow.callback(callback(r)).then(()=>false,()=>true);await started;await flow.cancel(r.jobId,r.browserNonce);release();assert.equal(await result,true);assert(f.withdrawn());await assert.rejects(flow.callback(callback(r)),/not_confirmed/);});
test('CA03 OAuth: session switch during exchange fails closed and requests withdrawal',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);f.kernel.authorize=async()=>{f.setPrincipal({...f.principal(),sessionId:randomUUID()});};await assert.rejects(flow.callback(callback(r)),/not_confirmed/);assert(f.withdrawn());});
test('CA03 OAuth: expiry during exchange cannot report success',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);f.kernel.authorize=async()=>{f.setNow(f.now()+300001);};await assert.rejects(flow.callback(callback(r)),/not_confirmed/);assert(f.withdrawn());});
test('CA03 OAuth: provider exception never escapes or permits replay',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link);f.kernel.authorize=async()=>{throw Error('MOCK-TOKEN-SECRET');};await assert.rejects(flow.callback(callback(r)),e=>typeof e==='object'&&e!==null&&'message'in e&&e.message==='creator_attempt_not_confirmed');assert(f.withdrawn());assert(!JSON.stringify([...f.records]).includes('MOCK-TOKEN-SECRET'));await assert.rejects(flow.callback(callback(r)),/not_confirmed/);});
test('CA03 OAuth: uncertain final storage acknowledgment never reports completed',async()=>{const f=fixture(),flow=f.make(),r=await flow.begin(f.link),cas=f.store.compareAndSwap;f.store.compareAndSwap=async(id,rev,next)=>{if(rev===2)throw Error('storage unavailable');return cas(id,rev,next);};await assert.rejects(flow.callback(callback(r)),/not_confirmed/);assert(f.withdrawn());await assert.rejects(flow.callback(callback(r)),/not_confirmed/);});
test('CA03 OAuth: tampered encrypted state, swapped IDs/revisions and wrong key reject',async()=>{for(const variant of ['tamper','id','revision','key']){const f=fixture(),flow=f.make(),r=await flow.begin(f.link),record=f.records.get(r.jobId)!;if(variant==='tamper')record.sealed=record.sealed.slice(0,40)+(record.sealed[40]==='A'?'B':'A')+record.sealed.slice(41);if(variant==='revision')record.revision++;let input=callback(r);if(variant==='id'){const id=randomUUID();f.records.set(id,record);input={...input,jobId:id};}await assert.rejects((variant==='key'?f.make(true,randomBytes(32)):flow).callback(input),/not_confirmed/);assert.equal(f.calls.length,0);assert(!f.withdrawn());}});
