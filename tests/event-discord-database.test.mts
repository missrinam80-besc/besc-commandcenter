import test,{before,after,beforeEach,afterEach}from'node:test';
import assert from'node:assert/strict';
import{randomUUID}from'node:crypto';
import{f1Database,q,j}from'./helpers/f1-database.mts';
let f:Awaited<ReturnType<typeof f1Database>>;const guild='1067893182387474432',client='fixture-event-client',remote='222222222222222222';const sessions:Record<string,string>={};
async function actor(id:string,role='authenticated'){await f.actor(id,role);await f.db.exec(`select set_config('request.jwt.claims',${q(JSON.stringify({sub:id,role,session_id:sessions[id],is_anonymous:false}))},false)`);}
async function manage(op:string,d:unknown={},eid?:string){return(await f.db.query<{v:Record<string,unknown>}>(`select public.event_discord_manage(${q(f.ids.org)},${q(eid??f.ids.event)},${q(op)},${j(d)})v`)).rows[0].v;}
async function call(op:string,d:unknown={}){return(await f.db.query<{v:Record<string,unknown>}>(`select public.event_discord_bot(${q(op)},${j({organization_id:f.ids.org,guild_id:guild,client_id:client,worker:'fixture-event-worker',site_origin:'https://cc.example.invalid',...d as object})})v`)).rows[0].v;}
async function bot(){await actor(f.ids.admin,'service_role');}
async function release(){await actor(f.ids.admin);const r=await manage('save',{expected_revision:0,enabled:true,rsvp_enabled:true,public_title:'Community event',public_description:'Vrijgegeven publieke informatie.',public_location:'Gistel'});return r.publication as {id:string;revision:number};}
async function denied(sql:string,pattern=/permission denied|event_.*required|event_actor_unavailable|event_.*unavailable|event_revision_conflict/){await f.db.exec('savepoint denied');await assert.rejects(f.db.exec(sql),pattern);await f.db.exec('rollback to denied');}
before(async()=>{f=await f1Database();await f.owner();for(const id of [f.ids.admin,f.ids.member,f.ids.other,f.ids.volunteer]){sessions[id]=randomUUID();await f.db.exec(`update auth.users set email_confirmed_at=now()where id=${q(id)};insert into auth.sessions(id,user_id)values(${q(sessions[id])},${q(id)})`);}
 await f.db.exec(`insert into public.discord_bot_servers(organization_id,guild_id,application_id,name,client_id)values(${q(f.ids.org)},${q(guild)},'111111111111111111','Fixture server',${q(client)});update public.events set title='BESC community event',description='PRIVATE CREW NOTES',status='confirmed',start_at='2035-06-01T16:00:00Z',end_at='2035-06-01T19:00:00Z'where id=${q(f.ids.event)};`);
});
after(async()=>{await f?.db.close();});beforeEach(async()=>{await f.owner();await f.db.exec('begin');await actor(f.ids.admin);await manage('configure',{expected_version:0,guild_id:guild,enabled:true,rsvp_enabled:true});});afterEach(async()=>{await f.db.exec('rollback');await f.owner();});
test('Explicit release returns only public fields, a bound job and a stable per-event link',async()=>{const p=await release();const info=(await f.db.query<{v:Record<string,unknown>}>(`select public.event_public_info(${q(p.id)})v`)).rows[0].v;assert.equal(info.title,'Community event');assert.ok(!JSON.stringify(info).includes('PRIVATE'));await bot();const r=await call('claim');const job=r.job as Record<string,unknown>;assert.equal(job.event_id,f.ids.event);assert.equal(job.publication_id,p.id);assert.equal(job.guild_id,guild);assert.ok(JSON.stringify(job.payload).includes('/events/aanmelden/'+p.id));assert.ok(!JSON.stringify(job).includes('PRIVATE'));assert.equal((await call('dispatch',{id:job.id,lease_token:job.lease_token})).authorized,true);await call('complete',{id:job.id,lease_token:job.lease_token,discord_event_id:remote});await call('complete',{id:job.id,lease_token:job.lease_token,discord_event_id:remote});assert.equal((await call('claim')).job,null);});
test('Interest never becomes coming or physical presence; each account can only change its own RSVP',async()=>{const p=await release();await bot();const job=(await call('claim')).job as Record<string,unknown>;await call('dispatch',{id:job.id,lease_token:job.lease_token});await call('complete',{id:job.id,lease_token:job.lease_token,discord_event_id:remote});await call('interest_snapshot',{publication_id:p.id,discord_event_id:remote,user_ids:['333333333333333333'],observed_at:new Date().toISOString()});await actor(f.ids.member);
const own=(op:string,d:unknown)=>`select public.event_presence_own(${q(p.id)},${q(op)},${j(d)})v`;const r=(await f.db.query<{v:{status:string;attended_at:null}}>(own('coming',{expected_version:0,expected_revision:p.revision}))).rows[0].v;assert.equal(r.status,'coming');assert.equal(r.attended_at,null);await actor(f.ids.other);assert.equal((await f.db.query<{v:null}>(own('read',{}))).rows[0].v,null);await denied(own('withdraw',{expected_version:1}));await actor(f.ids.member);await f.db.exec(own('withdraw',{expected_version:1}));await actor(f.ids.admin);const context=await manage('read');const pub=context.publication as Record<string,unknown>;assert.equal(pub.interested_count,1);assert.equal(pub.coming_count,0);assert.equal(pub.attended_count,0);});
test('Revocation after dispatch records the observed effect and then queues withdrawal without a second create',async()=>{const p=await release();await bot();const job=(await call('claim')).job as Record<string,unknown>;await call('dispatch',{id:job.id,lease_token:job.lease_token});await actor(f.ids.admin);await manage('withdraw',{expected_revision:p.revision});await bot();assert.equal((await call('claim')).job,null);await call('complete',{id:job.id,lease_token:job.lease_token,discord_event_id:remote});const withdrawal=(await call('claim')).job as Record<string,unknown>;assert.equal(withdrawal.operation,'withdraw');assert.equal(withdrawal.discord_event_id,remote);});
test('A source change cancels an old undispatched revision and cannot dispatch stale event times',async()=>{await release();await bot();const old=(await call('claim')).job as Record<string,unknown>;await f.owner();await f.db.exec(`update public.events set start_at='2035-06-01T17:00:00Z'where id=${q(f.ids.event)}`);await bot();assert.equal((await call('dispatch',{id:old.id,lease_token:old.lease_token})).authorized,false);await call('fail',{id:old.id,lease_token:old.lease_token,error_code:'not_dispatched'});const newer=(await call('claim')).job as Record<string,unknown>;assert.notEqual(newer.revision,old.revision);});
test('Expired dispatched work stays uncertain and cannot be reclaimed as a new create',async()=>{await release();await bot();const job=(await call('claim')).job as Record<string,unknown>;await call('dispatch',{id:job.id,lease_token:job.lease_token});await f.owner();await f.db.exec(`update private.event_discord_jobs set lease_until=now()-interval '1 minute'where id=${q(job.id)}`);await bot();assert.equal((await call('claim')).job,null);assert.equal(((await call('inspect',{id:job.id,lease_token:job.lease_token})).job as Record<string,unknown>).id,job.id);});
test('Private tables have no client grants, managers need live sessions, and bot binding cannot switch guild',async()=>{await release();for(const role of ['anon','authenticated','service_role']){await actor(f.ids.admin,role);for(const t of ['event_discord_settings','event_discord_publications','event_discord_jobs','event_presence','event_discord_interest'])await denied('select * from private.'+t);}
await actor(f.ids.volunteer);await denied(`select public.event_discord_manage(${q(f.ids.org)},${q(f.ids.event)},'read','{}')`);await actor(f.ids.admin);await f.owner();await f.db.exec(`delete from auth.sessions where id=${q(sessions[f.ids.admin])}`);await actor(f.ids.admin);await denied(`select public.event_discord_manage(${q(f.ids.org)},${q(f.ids.event)},'read','{}')`);await bot();await denied(`select public.event_discord_bot('claim',${j({organization_id:f.ids.org,guild_id:'999999999999999999',client_id:client,worker:'fixture-event-worker'})})`);});
test('Disabling the organization closes public access but still delivers withdrawal of its existing event',async()=>{
 const p=await release();await bot();const job=(await call('claim')).job as Record<string,unknown>;await call('dispatch',{id:job.id,lease_token:job.lease_token});await call('complete',{id:job.id,lease_token:job.lease_token,discord_event_id:remote});
 await actor(f.ids.admin);await manage('configure',{expected_version:1,guild_id:guild,enabled:false,rsvp_enabled:false});await actor(f.ids.member,'anon');assert.equal((await f.db.query<{v:null}>(`select public.event_public_info(${q(p.id)})v`)).rows[0].v,null);
 await bot();const withdrawal=(await call('claim')).job as Record<string,unknown>;assert.equal(withdrawal.operation,'withdraw');assert.equal((await call('dispatch',{id:withdrawal.id,lease_token:withdrawal.lease_token})).authorized,true);
});
test('An RSVP cannot become physical attendance before the event; withdrawal preserves later staff confirmation',async()=>{
 const p=await release();await actor(f.ids.member);await f.db.exec(`select public.event_presence_own(${q(p.id)},'coming',${j({expected_version:0,expected_revision:p.revision})})`);
 await actor(f.ids.admin);await denied(`select public.event_discord_manage(${q(f.ids.org)},${q(f.ids.event)},'presence',${j({user_id:f.ids.member,expected_version:1,audience:'crew',attended:true})})`,/event_invalid_presence/);
 await f.owner();await f.db.exec(`update public.events set start_at=now()-interval '1 hour',end_at=now()+interval '1 hour',status='live'where id=${q(f.ids.event)}`);await actor(f.ids.admin);await manage('presence',{user_id:f.ids.member,expected_version:1,audience:'crew',attended:true});
 await actor(f.ids.member);const r=(await f.db.query<{v:{status:string;attended_at:string}}>(`select public.event_presence_own(${q(p.id)},'withdraw',${j({expected_version:2})})v`)).rows[0].v;assert.equal(r.status,'withdrawn');assert.ok(r.attended_at);
});
test('Functional accounts cannot represent a physical participant',async()=>{
 const p=await release();await f.owner();await f.db.exec(`update public.community_people set person_type='functional_account'where account_user_id=${q(f.ids.member)}`);await actor(f.ids.member);
 await denied(`select public.event_presence_own(${q(p.id)},'coming',${j({expected_version:0,expected_revision:p.revision})})`,/event_person_required/);
});
test('Restricted source bindings immediately close the public projection and prevent subsequent publication',async()=>{
 const p=await release();await f.owner();await f.db.exec(`update public.document_registry set restricted_governance=true where id=${q(f.ids.proof)};insert into public.document_registry_sources(organization_id,table_name,record_id,field_name,document_id)values(${q(f.ids.org)},'events',${q(f.ids.event)},'fixture_source',${q(f.ids.proof)})`);
 await actor(f.ids.member,'anon');assert.equal((await f.db.query<{v:null}>(`select public.event_public_info(${q(p.id)})v`)).rows[0].v,null);
 await actor(f.ids.admin);await denied(`select public.event_discord_manage(${q(f.ids.org)},${q(f.ids.event)},'save',${j({expected_revision:p.revision,enabled:true,rsvp_enabled:true,public_title:'A',public_description:'B',public_location:'C'})})`,/event_manager_required|event_not_upcoming/);
 await bot();assert.equal((await call('claim')).job,null);
});
test('Older interest observations cannot replace a newer complete snapshot',async()=>{
 const p=await release();await bot();const job=(await call('claim')).job as Record<string,unknown>;await call('dispatch',{id:job.id,lease_token:job.lease_token});await call('complete',{id:job.id,lease_token:job.lease_token,discord_event_id:remote});
 const observed=Date.now();await call('interest_snapshot',{publication_id:p.id,discord_event_id:remote,user_ids:['333333333333333333'],observed_at:new Date(observed).toISOString()});await call('interest_snapshot',{publication_id:p.id,discord_event_id:remote,user_ids:[],observed_at:new Date(observed-1000).toISOString()});
 await actor(f.ids.admin);assert.equal(((await manage('read')).publication as Record<string,unknown>).interested_count,1);
});
