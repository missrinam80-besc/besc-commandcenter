import test,{afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {fork} from 'node:child_process';
import {randomBytes,randomUUID} from 'node:crypto';
import {mkdtemp,readFile,readdir,rm,appendFile,rename} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import path from 'node:path';
import {loadCreatorModule} from './helpers/creator-youtube-local-modules.mjs';
import type {CreatorYouTubeKernel,CreatorYouTubeCleanupOutcome} from '../src/lib/creator-youtube-kernel.ts';
const {CreatorYouTubeFileStore}=loadCreatorModule('creator-youtube-file-store.ts') as typeof import('../src/lib/creator-youtube-file-store.ts');
const {CreatorYouTubeKeyring}=loadCreatorModule('creator-youtube-keyring.ts') as typeof import('../src/lib/creator-youtube-keyring.ts');
const {CreatorYouTubeProviderInbox}=loadCreatorModule('creator-youtube-provider-inbox.ts') as typeof import('../src/lib/creator-youtube-provider-inbox.ts');
const {CreatorYouTubeOAuthAttempt}=loadCreatorModule('creator-youtube-oauth-attempt.ts') as typeof import('../src/lib/creator-youtube-oauth-attempt.ts');
const roots:string[]=[];
afterEach(async()=>{for(const root of roots.splice(0)){assert.equal(path.dirname(path.resolve(root)),path.resolve(tmpdir()));assert(path.basename(root).startsWith('besc-ca03-refresh-'));await rm(root,{recursive:true,force:true});}});
function worker(config:Record<string,unknown>){
 const child=fork(new URL('./helpers/creator-youtube-refresh-worker.mjs',import.meta.url),[],{stdio:['ignore','pipe','pipe','ipc'],env:{NODE_ENV:'test',SystemRoot:process.env.SystemRoot,TEMP:process.env.TEMP,TMP:process.env.TMP,PATH:process.env.PATH}});
 const messages:Record<string,unknown>[]=[],waiting:{resolve:(v:Record<string,unknown>)=>void;reject:(e:Error)=>void}[]=[];
 let exited=false;const exit=new Promise<void>(resolve=>child.once('exit',()=>{exited=true;for(const pending of waiting.splice(0))pending.reject(Error('Refresh fixture exited'));resolve();}));
 child.on('message',(message:Record<string,unknown>)=>{const pending=waiting.shift();if(pending)pending.resolve(message);else messages.push(message);});
 child.on('error',error=>{for(const pending of waiting.splice(0))pending.reject(error);});child.send(config);
 return{child,exit,next:()=>new Promise<Record<string,unknown>>((resolve,reject)=>{const message=messages.shift();if(message)resolve(message);else if(exited)reject(Error('Refresh fixture exited'));else waiting.push({resolve,reject});}),kill:async()=>{child.kill('SIGKILL');await exit;}};
}
const answer=()=>({channel_id:'UC'+'A'.repeat(22),scopes:['https://www.googleapis.com/auth/youtube.readonly','https://www.googleapis.com/auth/yt-analytics.readonly'],access_token:'MOCK-REFRESHED-ACCESS',refresh_token:'MOCK-ROTATED-REFRESH',expires_at:new Date(Date.now()+3600000).toISOString()});
async function fixture(){
 const root=await mkdtemp(path.join(tmpdir(),'besc-ca03-refresh-'));roots.push(root);
 const keyRoot=path.join(root,'keys'),attemptRoot=path.join(root,'attempts'),receiptRoot=path.join(root,'receipts'),counter=path.join(root,'fixture-provider-count'),ringId=randomUUID(),wrappingKey=randomBytes(32);
 const keyStore=await CreatorYouTubeFileStore.create(keyRoot),store=await CreatorYouTubeFileStore.create(attemptRoot),receiptStore=await CreatorYouTubeFileStore.create(receiptRoot),ring=await CreatorYouTubeKeyring.initialize(keyStore,wrappingKey,ringId),responses=new CreatorYouTubeProviderInbox(receiptStore,ring,true);
 let now=Date.now(),began=0,withdrawals=0,cleanups=0,principal={organizationId:randomUUID(),userId:randomUUID(),sessionId:randomUUID()};
 const kernel:Pick<CreatorYouTubeKernel,'beginAuthorization'|'authorize'|'withdraw'|'beginRefresh'|'refreshPrepared'|'recoverCapturedAuthorization'>={beginAuthorization:async()=>({jobId:randomUUID(),state:randomBytes(32).toString('hex')}),authorize:async()=>{throw Error('No authorization expected');},beginRefresh:async()=>{began++;return{jobId:randomUUID()};},refreshPrepared:async(_id,guard,receive)=>{await receive!(async()=>{await appendFile(counter,'refresh\n');return answer();});await guard!();},withdraw:async()=>{withdrawals++;return{local:true,provider:'complete'};},recoverCapturedAuthorization:async()=>{cleanups++;return 'complete';}};
 const make=(cipher=ring,inbox=responses,enabled=true)=>new CreatorYouTubeOAuthAttempt({store,kernel,responses:inbox,principal:async()=>principal,now:()=>now},cipher,'https://fixture.invalid/youtube/callback',enabled);
 const reopen=async()=>{const cipher=await CreatorYouTubeKeyring.open(keyStore,wrappingKey,ringId),inbox=new CreatorYouTubeProviderInbox(await CreatorYouTubeFileStore.create(receiptRoot),cipher,true);return make(cipher,inbox);};
 return{root,keyRoot,attemptRoot,receiptRoot,counter,ringId,wrappingKey,ring,store,responses,kernel,link:randomUUID(),make,reopen,began:()=>began,withdrawals:()=>withdrawals,cleanups:()=>cleanups,setNow:(n:number)=>{now=n;},now:()=>now,setPrincipal:(p:typeof principal)=>{principal=p;},principal:()=>principal,count:async()=>{try{return(await readFile(counter,'utf8')).trim().split('\n').filter(Boolean).length;}catch{return 0;}},config:()=>({keyRoot,attemptRoot,receiptRoot,counter,wrappingKey:wrappingKey.toString('base64url'),ringId,principal,now,answer:answer()})};
}

test('CA03 refresh: defaults off and unconfigured journal cannot reserve a refresh',async()=>{const f=await fixture();await assert.rejects(f.make(f.ring,f.responses,false).beginRefresh(f.link),/disabled/);assert.equal(f.began(),0);const flow=new CreatorYouTubeOAuthAttempt({store:f.store,kernel:f.kernel,principal:async()=>f.principal(),now:f.now},randomBytes(32),'https://fixture.invalid/youtube/callback',true);await assert.rejects(flow.beginRefresh(f.link),/not_confirmed/);assert.equal(f.began(),0);});
test('CA03 refresh: normal refresh is sealed and completed, then a new refresh can be prepared',async()=>{const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link);assert.deepEqual(Object.keys(r).sort(),['browserNonce','jobId']);assert.equal((await flow.refresh(r.jobId,r.browserNonce)).status,'completed');assert.equal(await f.count(),1);const next=await flow.beginRefresh(f.link);assert.notEqual(next.jobId,r.jobId);await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(await f.count(),1);});
test('CA03 refresh: unresolved action blocks another refresh before and after lease expiry',async()=>{const f=await fixture(),flow=f.make();await flow.beginRefresh(f.link);await assert.rejects(flow.beginRefresh(f.link),/not_confirmed/);f.setNow(f.now()+300001);await assert.rejects((await f.reopen()).beginRefresh(f.link),/not_confirmed/);assert.equal(f.began(),1);assert.equal(await f.count(),0);});
test('CA03 refresh: wrong owner, organization, session or browser cannot execute refresh',async()=>{for(const field of ['userId','organizationId','sessionId'] as const){const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link),original=f.principal();f.setPrincipal({...original,[field]:randomUUID()});await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(await f.count(),0);f.setPrincipal(original);await assert.rejects(flow.refresh(r.jobId,randomBytes(32).toString('base64url')),/not_confirmed/);assert.equal(await f.count(),0);}});
test('CA03 refresh: authorization and refresh actions cannot be confused',async()=>{const f=await fixture(),flow=f.make(),a=await flow.begin(f.link);await assert.rejects(flow.refresh(a.jobId,a.browserNonce),/not_confirmed/);const r=await flow.beginRefresh(f.link);await assert.rejects(flow.callback({...r,state:'0'.repeat(64),code:'MOCK-CODE'}),/not_confirmed/);assert.equal(await f.count(),0);});
test('CA03 refresh: two processes execute the prepared refresh only once',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),workers=Array.from({length:2},()=>worker({...f.config(),mode:'concurrent',jobId:r.jobId,browserNonce:r.browserNonce}));try{for(const w of workers)assert.equal((await w.next()).armed,true);for(const w of workers)w.child.send({go:true});const results=await Promise.all(workers.map(w=>w.next()));assert.equal(results.filter(v=>(v.result as {status?:string}|undefined)?.status==='completed').length,1);assert.equal(results.filter(v=>v.error).length,1);await Promise.all(workers.map(w=>w.exit));}finally{await Promise.all(workers.map(w=>w.kill()));}assert.equal(await f.count(),1);});
test('CA03 refresh: restart after preparation keeps exactly the same job usable once',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),flow=await f.reopen();assert.equal((await flow.refresh(r.jobId,r.browserNonce)).status,'completed');assert.equal(await f.count(),1);await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);});
test('CA03 refresh: process killed during provider request stays pending and blocks a replacement refresh',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'exchange_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'during_refresh');}finally{await w.kill();}f.setNow(f.now()+300001);const flow=await f.reopen();assert.equal((await flow.recover(r.jobId,r.browserNonce)).provider,'pending');await assert.rejects(flow.beginRefresh(f.link),/not_confirmed/);await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(f.began(),1);assert.equal(await f.count(),1);});
test('CA03 refresh: crash before response publication remains unknown without replay',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'capture_pre_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'before_refresh_capture');}finally{await w.kill();}f.setNow(f.now()+300001);const flow=await f.reopen();assert.equal((await flow.recover(r.jobId,r.browserNonce)).provider,'pending');await assert.rejects(flow.beginRefresh(f.link),/not_confirmed/);assert.equal(await f.count(),1);});
test('CA03 refresh: published response survives lost acknowledgment and is cleaned without replay',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'capture_post_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'after_refresh_capture');}finally{await w.kill();}f.setNow(f.now()+300001);const flow=await f.reopen();assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.cleanups(),1);assert.equal(await f.count(),1);await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);});
test('CA03 refresh: crash after capture before commit permits cleanup only',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'after_capture_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'after_capture_before_refresh_commit');}finally{await w.kill();}f.setNow(f.now()+300001);assert.equal((await(await f.reopen()).recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(await f.count(),1);});
test('CA03 refresh: crash after receipt applied before action completion revokes rather than resumes',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'applied_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'after_refresh_applied');}finally{await w.kill();}f.setNow(f.now()+300001);assert.equal((await(await f.reopen()).recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.cleanups(),1);assert.equal(await f.count(),1);});
test('CA03 refresh: crash during captured-token cleanup leaves retryable sealed answer',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'cleanup_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'during_refresh_cleanup');}finally{await w.kill();}assert.equal((await(await f.reopen()).recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.cleanups(),1);assert.equal(await f.count(),1);});
test('CA03 refresh: completed refresh survives lost slot release acknowledgment without revocation',async()=>{const f=await fixture(),r=await f.make().beginRefresh(f.link),w=worker({...f.config(),mode:'release_ack_crash',jobId:r.jobId,browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'after_slot_release');}finally{await w.kill();}const flow=await f.reopen();assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'completed');assert.equal(f.withdrawals(),0);assert.equal(f.cleanups(),0);assert.equal(await f.count(),1);const next=await flow.beginRefresh(f.link);assert.notEqual(next.jobId,r.jobId);assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'completed');await assert.rejects(flow.beginRefresh(f.link),/not_confirmed/);});
test('CA03 refresh: unresolved captured-token cleanup continues to hold the link reservation',async()=>{for(const outcome of ['pending','failed','blocked_isolation','uncertain'] as CreatorYouTubeCleanupOutcome[]){const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link);f.kernel.refreshPrepared=async(_id,_guard,receive)=>{await receive!(async()=>answer());throw Error('MOCK interruption');};f.kernel.recoverCapturedAuthorization=async()=>outcome;await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal((await flow.recover(r.jobId,r.browserNonce)).provider,outcome);await assert.rejects(flow.beginRefresh(f.link),/not_confirmed/);assert.equal(f.began(),1);}});
test('CA03 refresh: unused expired action can be released without withdrawing the existing grant',async()=>{const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link);f.setNow(f.now()+300000);assert.equal((await flow.refresh(r.jobId,r.browserNonce)).status,'expired');assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'expired');assert.equal(f.withdrawals(),0);assert.equal(await f.count(),0);assert.notEqual((await flow.beginRefresh(f.link)).jobId,r.jobId);});
test('CA03 refresh: key rotation between preparation and provider result preserves recovery',async()=>{const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link);await f.ring.rotate(randomUUID());assert.equal((await(await f.reopen()).refresh(r.jobId,r.browserNonce)).status,'completed');assert.equal(await f.count(),1);});
test('CA03 refresh: no plain provider credentials or nonce are written to action/receipt files',async()=>{const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link);await flow.refresh(r.jobId,r.browserNonce);const contents:string[]=[];for(const root of [f.attemptRoot,f.receiptRoot])for(const id of await readdir(root))for(const name of await readdir(path.join(root,id)))contents.push(await readFile(path.join(root,id,name),'utf8'));const raw=contents.join('');for(const secret of [answer().access_token,answer().refresh_token,r.browserNonce,f.principal().userId])assert(!raw.includes(secret));});
test('CA03 refresh: cancelling an unused preparation does not revoke the active grant',async()=>{const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link);assert.equal((await flow.cancel(r.jobId,r.browserNonce)).provider,'none');assert.equal(f.withdrawals(),0);assert.equal(f.cleanups(),0);assert.equal(await f.count(),0);await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);});
test('CA03 refresh: missing keyring after preparation blocks provider without rewriting the action',async()=>{const f=await fixture(),flow=f.make(),r=await flow.beginRefresh(f.link),before=await f.store.read(r.jobId);await rename(path.join(f.keyRoot,f.ringId),path.join(f.keyRoot,'fixture-backup'));await assert.rejects(flow.refresh(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(await f.count(),0);assert.equal(f.withdrawals(),0);assert.deepEqual(await f.store.read(r.jobId),before);});
test('CA03 refresh: refresh and authorization receipts have independent authenticated namespaces',async()=>{const f=await fixture(),binding={jobId:randomUUID(),link:f.link,ownerBinding:randomBytes(32).toString('hex'),browserBinding:randomBytes(32).toString('hex'),stateHash:randomBytes(32).toString('hex')};await f.responses.receive(binding,async()=>answer());assert.equal(await f.responses.inspect({...binding,kind:'refresh'}),null);let called=false;assert.equal(await f.responses.recover({...binding,kind:'refresh'},async()=>{called=true;return 'complete';}),'pending');assert(!called);assert.equal((await f.responses.inspect(binding))?.status,'received');});
