import test,{afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {fork} from 'node:child_process';
import {randomBytes,randomUUID} from 'node:crypto';
import {mkdtemp,readdir,readFile,rm,writeFile,mkdir,symlink} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import path from 'node:path';
import {loadCreatorModule} from './helpers/creator-youtube-local-modules.mjs';
import type {CreatorAttemptStore} from '../src/lib/creator-youtube-oauth-attempt.ts';
import type {CreatorYouTubeKernel} from '../src/lib/creator-youtube-kernel.ts';
const {CreatorYouTubeFileStore}=loadCreatorModule('creator-youtube-file-store.ts') as typeof import('../src/lib/creator-youtube-file-store.ts');
const {CreatorYouTubeOAuthAttempt}=loadCreatorModule('creator-youtube-oauth-attempt.ts') as typeof import('../src/lib/creator-youtube-oauth-attempt.ts');
const roots:string[]=[];
async function directory(){const root=await mkdtemp(path.join(tmpdir(),'besc-ca03-durable-'));roots.push(root);return root;}
afterEach(async()=>{for(const root of roots.splice(0)){assert.equal(path.dirname(path.resolve(root)),path.resolve(tmpdir()));assert(path.basename(root).startsWith('besc-ca03-durable-'));await rm(root,{recursive:true,force:true});}});
function worker(config:Record<string,unknown>){
 const child=fork(new URL('./helpers/creator-youtube-durable-worker.mjs',import.meta.url),[],{stdio:['ignore','pipe','pipe','ipc'],env:{NODE_ENV:'test',SystemRoot:process.env.SystemRoot,TEMP:process.env.TEMP,TMP:process.env.TMP,PATH:process.env.PATH}});
 const messages:Record<string,unknown>[]=[],waiting:{resolve:(v:Record<string,unknown>)=>void;reject:(e:Error)=>void}[]=[];
 let exited=false;const exit=new Promise<void>(resolve=>child.once('exit',()=>{exited=true;for(const pending of waiting.splice(0))pending.reject(Error('Fixture process exited before response'));resolve();}));
 child.on('message',(message:Record<string,unknown>)=>{const pending=waiting.shift();if(pending)pending.resolve(message);else messages.push(message);});
 child.on('error',error=>{for(const pending of waiting.splice(0))pending.reject(error);});
 child.send(config);
 return{child,exit,next:()=>new Promise<Record<string,unknown>>((resolve,reject)=>{const message=messages.shift();if(message)resolve(message);else if(exited)reject(Error('Fixture exited'));else waiting.push({resolve,reject});}),kill:async()=>{child.kill('SIGKILL');await exit;}};
}
async function fixture(){
 const root=await directory(),key=randomBytes(32),id=randomUUID(),link=randomUUID(),state=randomBytes(32).toString('hex'),principal={organizationId:randomUUID(),userId:randomUUID(),sessionId:randomUUID()};
 let now=Date.now(),exchanges=0,withdrawals=0,provider:'complete'|'pending'|'failed'|'blocked_isolation'='complete';
 const kernel:Pick<CreatorYouTubeKernel,'beginAuthorization'|'authorize'|'withdraw'>={beginAuthorization:async()=>({jobId:id,state}),authorize:async()=>{exchanges++;},withdraw:async()=>{withdrawals++;return{local:true,provider};}};
 const make=(store:CreatorAttemptStore)=>new CreatorYouTubeOAuthAttempt({store,kernel,principal:async()=>principal,now:()=>now},key,'https://fixture.invalid/youtube/callback',true);
 const store=await CreatorYouTubeFileStore.create(root),flow=make(store);
 return{root,id,link,key,principal,kernel,store,flow,make,now:()=>now,setNow:(n:number)=>{now=n;},setProvider:(p:typeof provider)=>{provider=p;},exchanges:()=>exchanges,withdrawals:()=>withdrawals,config:()=>({root,id,link,state,principal,key:key.toString('base64url'),now})};
}

test('CA03 durable: disk revision persists across fresh stores and stale CAS never overwrites',async()=>{const root=await directory(),id=randomUUID(),a=await CreatorYouTubeFileStore.create(root),b=await CreatorYouTubeFileStore.create(root);assert.equal(await a.read(id),null);assert(await a.compareAndSwap(id,null,{revision:1,sealed:'A'.repeat(80)}));assert.equal((await b.read(id))?.revision,1);assert(!await b.compareAndSwap(id,null,{revision:1,sealed:'B'.repeat(80)}));assert(await b.compareAndSwap(id,1,{revision:2,sealed:'C'.repeat(80)}));assert(!await a.compareAndSwap(id,1,{revision:2,sealed:'D'.repeat(80)}));assert.equal((await a.read(id))?.sealed,'C'.repeat(80));});
test('CA03 durable: four separate processes elect one revision writer for create and update',async()=>{const root=await directory(),id=randomUUID();for(const expected of [null,1]){const workers=Array.from({length:4},(_,i)=>worker({mode:'cas',root,id,expected,sealed:String.fromCharCode(65+i).repeat(80)}));try{for(const w of workers)assert.equal((await w.next()).armed,true);for(const w of workers)w.child.send({go:true});const outcomes=await Promise.all(workers.map(w=>w.next()));assert.equal(outcomes.filter(v=>v.result===true).length,1);assert(outcomes.every(v=>!v.error));await Promise.all(workers.map(w=>w.exit));}finally{await Promise.all(workers.map(w=>w.kill()));}}const store=await CreatorYouTubeFileStore.create(root);assert.equal((await store.read(id))?.revision,2);});
test('CA03 durable: process killed before atomic publication leaves no committed request',async()=>{const root=await directory(),id=randomUUID(),w=worker({mode:'prepublish_crash',root,id});try{assert.equal((await w.next()).paused,'before_publish');}finally{await w.kill();}const store=await CreatorYouTubeFileStore.create(root);assert.equal(await store.read(id),null);assert(await store.compareAndSwap(id,null,{revision:1,sealed:'B'.repeat(80)}));assert.equal((await store.read(id))?.sealed,'B'.repeat(80));});
test('CA03 durable: process killed after atomic publication preserves the unacknowledged revision',async()=>{const root=await directory(),id=randomUUID(),w=worker({mode:'postpublish_crash',root,id});try{assert.equal((await w.next()).paused,'after_publish');}finally{await w.kill();}const store=await CreatorYouTubeFileStore.create(root);assert.equal((await store.read(id))?.revision,1);assert(!await store.compareAndSwap(id,null,{revision:1,sealed:'B'.repeat(80)}));});
test('CA03 durable: begin in one process can complete after restart; disk contains only sealed request data',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'begin'});const response=await w.next();await w.exit;assert(!response.error);const r=response.result as {jobId:string;state:string;browserNonce:string};const flow=f.make(await CreatorYouTubeFileStore.create(f.root));assert.equal((await flow.callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal(f.exchanges(),1);const files=await readdir(path.join(f.root,f.id));const raw=(await Promise.all(files.map(name=>readFile(path.join(f.root,f.id,name),'utf8')))).join('');for(const secret of [r.state,r.browserNonce,'MOCK-CODE',f.link,f.principal.userId])assert(!raw.includes(secret));});
test('CA03 durable: killed provider exchange recovers after expiry without exchanging its code again',async()=>{const f=await fixture(),r=await f.flow.begin(f.link),w=worker({...f.config(),mode:'exchange_crash',callback:{...r,code:'MOCK-CODE'}});try{assert.equal((await w.next()).paused,'provider_exchange');}finally{await w.kill();}const flow=f.make(await CreatorYouTubeFileStore.create(f.root));await assert.rejects(flow.recover(r.jobId,r.browserNonce),/not_confirmed/);f.setNow(f.now()+300001);assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.exchanges(),0);assert.equal(f.withdrawals(),1);await assert.rejects(flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);});
test('CA03 durable: intent survives termination during withdrawal and a fresh process finishes cleanup',async()=>{const f=await fixture(),r=await f.flow.begin(f.link),w=worker({...f.config(),mode:'withdraw_crash',browserNonce:r.browserNonce});try{assert.equal((await w.next()).paused,'provider_withdrawal');}finally{await w.kill();}const next=worker({...f.config(),mode:'recover',browserNonce:r.browserNonce});const response=await next.next();await next.exit;assert(!response.error);assert.equal((response.result as {status:string}).status,'recovered');assert.equal(f.exchanges(),0);await assert.rejects(f.flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);});
test('CA03 durable: completed state survives termination before storage acknowledgment and recovery does not revoke it',async()=>{const f=await fixture(),r=await f.flow.begin(f.link),w=worker({...f.config(),mode:'ack_crash',callback:{...r,code:'MOCK-CODE'}});try{assert.equal((await w.next()).paused,'completed_before_ack');}finally{await w.kill();}assert.equal((await f.make(await CreatorYouTubeFileStore.create(f.root)).recover(r.jobId,r.browserNonce)).status,'completed');assert.equal(f.withdrawals(),0);assert.equal(f.exchanges(),0);await assert.rejects(f.flow.callback({...r,code:'MOCK-CODE'}),/not_confirmed/);});
test('CA03 durable: failed/pending/blocked provider cleanup stays retryable and never complete',async()=>{for(const provider of ['failed','pending','blocked_isolation'] as const){const f=await fixture(),r=await f.flow.begin(f.link);f.setProvider(provider);assert.equal((await f.flow.cancel(r.jobId,r.browserNonce)).provider,provider);const flow=f.make(await CreatorYouTubeFileStore.create(f.root));const result=await flow.recover(r.jobId,r.browserNonce);assert.equal(result.status,'cleanup_pending');assert.equal(result.provider,provider);f.setProvider('complete');assert.equal((await flow.recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.exchanges(),0);}});
test('CA03 durable: unknown withdrawal outcome persists and fresh retry never replays authorization',async()=>{const f=await fixture(),r=await f.flow.begin(f.link);f.kernel.withdraw=async()=>{throw Error('MOCK-PROVIDER-SECRET');};assert.equal((await f.flow.cancel(r.jobId,r.browserNonce)).provider,'uncertain');f.kernel.withdraw=async()=>({local:true,provider:'complete'});assert.equal((await f.make(await CreatorYouTubeFileStore.create(f.root)).recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.exchanges(),0);});
test('CA03 durable: even completed cleanup is rechecked for late quarantined credentials',async()=>{const f=await fixture(),r=await f.flow.begin(f.link);await f.flow.cancel(r.jobId,r.browserNonce);f.setProvider('pending');assert.equal((await f.flow.recover(r.jobId,r.browserNonce)).provider,'pending');f.setProvider('complete');assert.equal((await f.flow.recover(r.jobId,r.browserNonce)).provider,'complete');assert.equal(f.exchanges(),0);});
test('CA03 durable: recovery preserves browser/owner binding and cannot interrupt a live pending request',async()=>{const f=await fixture(),r=await f.flow.begin(f.link);await assert.rejects(f.flow.recover(r.jobId,randomBytes(32).toString('base64url')),/not_confirmed/);await assert.rejects(f.flow.recover(r.jobId,r.browserNonce),/not_confirmed/);assert.equal(f.withdrawals(),0);assert.equal((await f.flow.callback({...r,code:'MOCK-CODE'})).status,'completed');});
test('CA03 durable: malformed revisions, traversal, corrupt JSON and gaps fail closed',async()=>{const root=await directory(),store=await CreatorYouTubeFileStore.create(root);await assert.rejects(store.read('../outside'),/storage_unavailable/);await assert.rejects(store.compareAndSwap(randomUUID(),null,{revision:2,sealed:'A'.repeat(80)}),/storage_unavailable/);const id=randomUUID();await mkdir(path.join(root,id));await writeFile(path.join(root,id,'0000000000000002.json'),'{}');await assert.rejects(store.read(id),/storage_unavailable/);const other=randomUUID();await mkdir(path.join(root,other));await writeFile(path.join(root,other,'0000000000000001.json'),'not json');await assert.rejects(store.read(other),/storage_unavailable/);});
test('CA03 durable: request directory symlink cannot redirect encrypted records elsewhere',async()=>{const root=await directory(),outside=await directory(),store=await CreatorYouTubeFileStore.create(root),id=randomUUID();await symlink(outside,path.join(root,id),process.platform==='win32'?'junction':'dir');await assert.rejects(store.compareAndSwap(id,null,{revision:1,sealed:'A'.repeat(80)}),/storage_unavailable/);assert.deepEqual(await readdir(outside),[]);});
