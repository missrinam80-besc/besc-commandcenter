import test,{afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createRequire} from 'node:module';
import {runInNewContext} from 'node:vm';
import React,{act} from 'react';
import {createRoot} from 'react-dom/client';
import {JSDOM} from 'jsdom';
import ts from 'typescript';
import type {CreatorYouTubeConnect as Component} from '../src/components/creator-youtube-connect.tsx';
const native=createRequire(import.meta.url),compiled={exports:{} as {CreatorYouTubeConnect:typeof Component}};
runInNewContext(ts.transpileModule(readFileSync(new URL('../src/components/creator-youtube-connect.tsx',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022,jsx:ts.JsxEmit.ReactJSX,esModuleInterop:true}}).outputText,{module:compiled,exports:compiled.exports,URL,require:native});
const {CreatorYouTubeConnect}=compiled.exports;
const consent={purpose:'TESTFIXTURE - NIET PUBLICEREN',channel_id:'UC'+'A'.repeat(22),video_ids:['A'.repeat(11)],start_date:'2026-11-01',end_date:'2026-11-06',valid_until:'2026-12-01T00:00:00Z',retain_until:'2026-12-15T00:00:00Z'};
const undo:(()=>Promise<void>)[]=[];
afterEach(async()=>{for(const cleanup of undo.splice(0).reverse())await cleanup();});
async function mount(overrides:Partial<React.ComponentProps<typeof Component>>={}){
 const dom=new JSDOM('<!doctype html><html><body><main id="root"></main></body></html>'),saved=new Map<string,PropertyDescriptor|undefined>();
 for(const [key,value]of Object.entries({window:dom.window,document:dom.window.document,navigator:dom.window.navigator,HTMLElement:dom.window.HTMLElement,IS_REACT_ACT_ENVIRONMENT:true})){saved.set(key,Object.getOwnPropertyDescriptor(globalThis,key));Object.defineProperty(globalThis,key,{value,writable:true,configurable:true});}
 const root=createRoot(dom.window.document.getElementById('root')!);
 undo.push(async()=>{await act(async()=>root.unmount());dom.window.close();for(const [key,descriptor]of saved){if(descriptor)Object.defineProperty(globalThis,key,descriptor);else Reflect.deleteProperty(globalThis,key);}});
 const calls:Record<string,unknown>[]=[],navigated:string[]=[];
 const props:React.ComponentProps<typeof Component>={configured:true,connected:false,pending:false,link:'00000000-0000-4000-8000-000000000001',consent,action:async input=>{calls.push(input);return{status:'prepared',authorizationUrl:'https://accounts.google.com/o/oauth2/v2/auth?state=MOCK'};},navigate:url=>{navigated.push(url);},...overrides};
 await act(async()=>root.render(React.createElement(CreatorYouTubeConnect,props)));
 const button=(label:string)=>{const el=[...dom.window.document.querySelectorAll('button')].find(b=>b.textContent===label);assert(el,'Button '+label);return el;};
 return{dom,calls,navigated,button,text:()=>dom.window.document.body.textContent!,click:async(label:string)=>{await act(async()=>button(label).click());},accept:async()=>{await act(async()=>dom.window.document.querySelector('input')!.click());}};
}
test('CA03 creator UI: default unavailable cannot request permission or navigate',async()=>{const f=await mount({configured:undefined});assert(f.text().includes('nog niet beschikbaar'));assert(f.button('Toestemming geven en naar Google').disabled);await f.accept();await f.click('Toestemming geven en naar Google');assert.equal(f.calls.length,0);assert.equal(f.navigated.length,0);});
test('CA03 creator UI: shows exact consent selection and dates, requires explicit checkbox',async()=>{const f=await mount();for(const value of [consent.purpose,consent.channel_id,consent.video_ids[0],consent.start_date,consent.end_date,consent.valid_until,consent.retain_until])assert(f.text().includes(value));assert(f.text().includes('niets gepubliceerd'));assert(f.text().includes('met een campagne te delen'));await f.click('Toestemming geven en naar Google');assert.equal(f.calls.length,0);await f.accept();await f.click('Toestemming geven en naar Google');assert.equal(f.calls.length,1);assert.equal((f.calls[0].consent as {accepted:boolean}).accepted,true);assert.equal(f.navigated.length,1);assert(f.text().includes('pas actief na bevestigde terugkeer'));});
test('CA03 creator UI: malicious destination is blocked and secret provider message is not shown',async()=>{const f=await mount({action:async()=>({status:'prepared',authorizationUrl:'https://evil.invalid/steal?token=MOCK-PRIVATE'})});await f.accept();await f.click('Toestemming geven en naar Google');assert.equal(f.navigated.length,0);assert(!f.text().includes('MOCK-PRIVATE'));assert(f.text().includes('Niet bevestigd'));assert(f.button('Aanvraag herstellen'));});
test('CA03 creator UI: synchronous double click claims only one request while work is pending',async()=>{let release!:(value:{status:string;authorizationUrl:string})=>void,count=0;const wait=new Promise<{status:string;authorizationUrl:string}>(r=>{release=r;}),f=await mount({action:async()=>{count++;return wait;}});await f.accept();await act(async()=>{const b=f.button('Toestemming geven en naar Google');b.click();b.click();});assert.equal(count,1);await act(async()=>release({status:'prepared',authorizationUrl:'https://accounts.google.com/o/oauth2/v2/auth'}));});
test('CA03 creator UI: refresh prepares browser ticket in a separate action before provider refresh',async()=>{const calls:string[]=[],f=await mount({connected:true,action:async input=>{calls.push(input.action as string);return{status:input.action==='prepare-refresh'?'prepared':'completed'};}});await f.click('Toegang vernieuwen');assert.deepEqual(calls,['prepare-refresh','refresh']);assert(f.text().includes('Toegang veilig vernieuwd'));});
test('CA03 creator UI: failed preparation never refreshes or retries and exposes recovery',async()=>{const calls:string[]=[],f=await mount({connected:true,action:async input=>{calls.push(input.action as string);throw Error('MOCK-PRIVATE');}});await f.click('Toegang vernieuwen');assert.deepEqual(calls,['prepare-refresh']);assert(f.text().includes('koppelingsstatus is niet bevestigd'));assert(!f.text().includes('MOCK-PRIVATE'));assert(f.button('Toegang vernieuwen').disabled);assert(f.button('Aanvraag herstellen'));});
test('CA03 creator UI: local withdrawal remains distinct from unfinished Google revocation',async()=>{const f=await mount({connected:true,action:async()=>({status:'disconnected',provider:'failed'})});await f.click('Koppeling intrekken');assert(f.text().includes('Toegang lokaal ingetrokken'));assert(f.text().includes('Google is nog niet bevestigd'));assert(!f.text().includes('Je kanaal is gekoppeld.'));});
test('CA03 creator UI: unused refresh cancellation keeps existing connection, unresolved recovery stays visible',async()=>{const f=await mount({connected:true,pending:true,action:async()=>({status:'cancelled',provider:'none'})});await f.click('Aanvraag annuleren');assert(f.text().includes('Je kanaal is gekoppeld.'));const g=await mount({pending:true,action:async()=>({status:'cleanup_pending',provider:'failed'})});await g.click('Aanvraag herstellen');assert(g.button('Aanvraag herstellen'));assert(!g.text().includes('afgehandeld.'));});

test('CA03 creator UI: pending SQL closure retains recovery even with never-started proof',async()=>{const f=await mount({pending:true,action:async()=>({status:'cancelled',provider:'pending',exchangeNotStarted:true})});await f.click('Aanvraag annuleren');assert(f.text().includes('gestopt vóór tokenwisseling'));assert(f.text().includes('serveropvolging is nog niet bevestigd'));assert(!f.text().includes('afgehandeld.'));assert(f.button('Aanvraag herstellen'));});

test('CA03 creator UI: confirmed unstarted closure needs no Google revocation and releases the request',async()=>{const f=await mount({pending:true,action:async()=>({status:'cancelled',provider:'none',exchangeNotStarted:true})});await f.click('Aanvraag annuleren');assert(f.text().includes('afgesloten zonder tokenwisseling'));assert(f.text().includes('geen Google-intrekking nodig'));assert(f.button('Toestemming geven en naar Google'));});
