import test from 'node:test';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {loadCreatorModule} from './helpers/creator-youtube-local-modules.mjs';
import type {CreatorGoogleTransport} from '../src/lib/creator-youtube-google.ts';
import type {CreatorYouTubePorts} from '../src/lib/creator-youtube-kernel.ts';
const kernel=loadCreatorModule('creator-youtube-kernel.ts') as typeof import('../src/lib/creator-youtube-kernel.ts');
const {CreatorYouTubeGoogle}=loadCreatorModule('creator-youtube-google.ts',{'./creator-youtube-kernel':kernel}) as typeof import('../src/lib/creator-youtube-google.ts');
const channel='UC'+'A'.repeat(22),other='UC'+'B'.repeat(22),video='A'.repeat(11),second='B'.repeat(11);
const config={clientId:'MOCK.apps.googleusercontent.com',clientSecret:'MOCK-CLIENT-SECRET',redirectUri:'https://fixture.invalid/auth/creator-youtube/callback',isolatedProject:true};
const now=Date.now(),context={codeVerifier:'A'.repeat(43),redirectUri:config.redirectUri};
const job=()=>({id:randomUUID(),kind:'authorize' as const,channel_id:channel,video_ids:[video,second],start_date:'2026-11-01',end_date:'2026-11-06',state_hash:null,credentials:null});
const token=()=>({access_token:'MOCK-ACCESS',refresh_token:'MOCK-REFRESH',token_type:'Bearer',scope:kernel.creatorYouTubeScopes.join(' '),expires_in:3600});
const report=()=>({columnHeaders:[{name:'video',columnType:'DIMENSION',dataType:'STRING'},...['views','estimatedMinutesWatched','averageViewDuration'].map(name=>({name,columnType:'METRIC',dataType:name==='views'?'INTEGER':'FLOAT'}))],rows:[[video,0,1.5,null]]});
function fixture(overrides:Partial<typeof config>={},timeout=1000){
 const calls:{url:string;init:RequestInit}[]=[],replies:((url:string,init:RequestInit)=>Promise<Response>|Response)[]=[];
 const transport:CreatorGoogleTransport=async(url,init)=>{calls.push({url,init});const reply=replies.shift();assert(reply,'No unexpected provider request');return reply(url,init);};
 const make=(enabled=true)=>new CreatorYouTubeGoogle({...config,...overrides},transport,()=>now,enabled,timeout);
 return{calls,replies,make,json:(value:unknown,status=200)=>replies.push(()=>new Response(JSON.stringify(value),{status,headers:{'Content-Type':'application/json'}}))};
}
test('CA03 Google: default disabled and unverified isolation make no transport requests',async()=>{const f=fixture();const off=new CreatorYouTubeGoogle(config,async()=>{throw Error('Unexpected transport');},()=>now);await assert.rejects(off.exchange('MOCK',job(),context),/unavailable/);for(const operation of [(p:InstanceType<typeof CreatorYouTubeGoogle>)=>p.refresh('MOCK',job()),(p:InstanceType<typeof CreatorYouTubeGoogle>)=>p.revoke('MOCK')])await assert.rejects(operation(fixture({isolatedProject:false}).make()),/unavailable/);assert.equal(f.calls.length,0);});
test('CA03 Google: fixed authorization endpoint with offline scopes, state and S256; no secret in URL',()=>{const f=fixture(),url=new URL(f.make().authorizationUrl({state:'a'.repeat(64),codeChallenge:'A'.repeat(43),codeChallengeMethod:'S256',redirectUri:config.redirectUri}));assert.equal(url.origin,'https://accounts.google.com');assert.equal(url.searchParams.get('scope'),kernel.creatorYouTubeScopes.join(' '));for(const [key,value]of Object.entries({access_type:'offline',include_granted_scopes:'false',response_type:'code',code_challenge_method:'S256'}))assert.equal(url.searchParams.get(key),value);assert(!url.href.includes(config.clientSecret));assert.equal(f.calls.length,0);});
test('CA03 Google: invalid configuration and substituted redirect cannot reach transport',()=>{const f=fixture();for(const redirectUri of ['http://fixture.invalid/callback','https://user@fixture.invalid/callback','https://fixture.invalid/callback?next=evil'])assert.throws(()=>new CreatorYouTubeGoogle({...config,redirectUri},async()=>new Response(),()=>now));assert.throws(()=>f.make().authorizationUrl({state:'a'.repeat(64),codeChallenge:'A'.repeat(43),codeChallengeMethod:'S256',redirectUri:'https://evil.invalid/callback'}));});
test('CA03 Google: code exchange returns credentials before any channel read; POST body contains verifier',async()=>{const f=fixture();f.json(token());const result=await f.make().exchange('MOCK-CODE',job(),context);assert.equal(f.calls.length,1);const call=f.calls[0],body=new URLSearchParams(call.init.body as string);assert.equal(call.url,'https://oauth2.googleapis.com/token');assert.equal(call.init.method,'POST');assert.equal(call.init.redirect,'error');assert.equal(call.init.cache,'no-store');assert.equal(call.init.credentials,'omit');assert.equal(body.get('code_verifier'),context.codeVerifier);assert.equal(body.get('client_secret'),config.clientSecret);assert(!call.url.includes('MOCK'));assert.equal(result.channel_id,'');assert.equal(result.access_token,'MOCK-ACCESS');assert.equal(result.expires_at,new Date(now+3600000).toISOString());});
test('CA03 Google: only verified owned channel can become normalized activation value',async()=>{for(const id of [channel,other]){const f=fixture();f.json(token());const raw=await f.make().exchange('MOCK',job(),context);f.json({items:[{id}]});if(id===channel)assert.equal((await f.make().validate(raw,job())).channel_id,channel);else await assert.rejects(f.make().validate(raw,job()),/not_confirmed/);assert.match(f.calls[1].url,/mine=true/);assert.equal((f.calls[1].init.headers as Record<string,string>).Authorization,'Bearer MOCK-ACCESS');}});
test('CA03 Google: multiple, missing or paginated owned channel results fail closed',async()=>{for(const value of [{items:[]},{items:[{id:channel},{id:other}]},{items:[{id:channel}],nextPageToken:'MORE'}]){const f=fixture();f.json(token());const raw=await f.make().exchange('MOCK',job(),context);f.json(value);await assert.rejects(f.make().validate(raw,job()));}});
test('CA03 Google: missing/extra scopes, wrong token type and invalid lifetime preserve credentials but cannot activate',async()=>{for(const change of [{scope:undefined},{scope:token().scope+' https://www.googleapis.com/auth/youtube'},{token_type:'MAC'},{expires_in:0},{expires_in:'3600'},{refresh_token:''}]){const f=fixture();f.json({...token(),...change});const raw=await f.make().exchange('MOCK',job(),context);assert.equal(raw.access_token,'MOCK-ACCESS');await assert.rejects(f.make().validate(raw,job()));assert.equal(f.calls.length,1);}});
test('CA03 Google: refresh omitting scope inherits fixed previously validated scopes; replacement stays optional',async()=>{const f=fixture();f.json({...token(),scope:undefined,refresh_token:undefined});const value=await f.make().refresh('MOCK-OLD',job());assert.equal(value.refresh_token,undefined);assert.equal(JSON.stringify(value.scopes),JSON.stringify(kernel.creatorYouTubeScopes));assert.equal(new URLSearchParams(f.calls[0].init.body as string).get('refresh_token'),'MOCK-OLD');});
test('CA03 Google: failed token HTTP with credentials is captured as invalid instead of activated',async()=>{const f=fixture();f.json({...token(),error_description:'MOCK-SECRET-ERROR'},400);const raw=await f.make().exchange('MOCK',job(),context);assert.equal(raw.access_token,'MOCK-ACCESS');assert.equal(raw.refresh_token,'MOCK-REFRESH');assert(!JSON.stringify(raw).includes('MOCK-SECRET-ERROR'));await assert.rejects(f.make().validate(raw,job()));});
test('CA03 Google: provider errors and invalid JSON are generic, without retry',async()=>{for(const reply of [new Response(JSON.stringify({error_description:'MOCK-PRIVATE'}),{status:400}),new Response('MOCK-PRIVATE'),new Response('x'.repeat(65537))]){const f=fixture();f.replies.push(()=>reply);await assert.rejects(f.make().exchange('MOCK',job(),context),{message:'creator_google_not_confirmed'});assert.equal(f.calls.length,1);}});
test('CA03 Google: transport timeout and interrupted response body fail closed without replay',async()=>{const f=fixture({},20);let signal:AbortSignal|undefined;f.replies.push((_u,init)=>{signal=init.signal!;return new Promise<Response>(()=>undefined);});await assert.rejects(f.make().exchange('MOCK',job(),context));assert(signal?.aborted);assert.equal(f.calls.length,1);const g=fixture({},20);let cancelled=false;g.replies.push(()=>new Response(new ReadableStream({pull(){return new Promise<void>(()=>undefined);},cancel(){cancelled=true;}})));await assert.rejects(g.make().exchange('MOCK',job(),context));assert.equal(g.calls.length,1);assert(cancelled);});
test('CA03 Google: redirect response never forwards bearer or client credentials',async()=>{const f=fixture();f.json({},302);await assert.rejects(f.make().exchange('MOCK',job(),context));assert.equal(f.calls.length,1);assert.equal(f.calls[0].init.redirect,'error');});
test('CA03 Google: selected report uses bounded dates/video filters, preserves zero and marks omitted videos missing',async()=>{const f=fixture();f.json({items:[{id:channel}]});f.json(report());const rows=await f.make().collect('MOCK-ACCESS',job());assert.equal(rows.length,6);assert.equal(rows[0].value,0);assert.equal(rows[0].quality,'known');assert.equal(rows[2].quality,'missing');assert.equal(rows[3].quality,'missing');const url=new URL(f.calls[1].url);assert.equal(url.searchParams.get('ids'),'channel=='+channel);assert.equal(url.searchParams.get('filters'),`video==${video},${second}`);assert.equal(url.searchParams.get('startDate'),'2026-11-01');assert(!url.href.includes('MOCK-ACCESS'));});
test('CA03 Google: wrong headers, alien/duplicate videos and invalid measurements never become samples',async()=>{for(const modify of [(v:ReturnType<typeof report>)=>{v.columnHeaders[1].name='likes';},(v:ReturnType<typeof report>)=>{v.rows[0][0]='C'.repeat(11);},(v:ReturnType<typeof report>)=>{v.rows.push([...v.rows[0]]);},(v:ReturnType<typeof report>)=>{v.rows[0][1]=-1;},(v:ReturnType<typeof report>)=>{v.rows[0][2]=1e15;},(v:ReturnType<typeof report>)=>{v.rows[0][1]='12';}]){const f=fixture(),value=report();modify(value);f.json({items:[{id:channel}]});f.json(value);await assert.rejects(f.make().collect('MOCK',job()));}});
test('CA03 Google: no report request after channel mismatch or invalid selection',async()=>{const f=fixture();f.json({items:[{id:other}]});await assert.rejects(f.make().collect('MOCK',job()));assert.equal(f.calls.length,1);const g=fixture();await assert.rejects(g.make().collect('MOCK',{...job(),video_ids:[video,video]}));assert.equal(g.calls.length,0);});
test('CA03 Google: revocation uses POST body only and only 200 confirms success',async()=>{for(const status of [200,204,400,503]){const f=fixture();f.replies.push(()=>new Response(null,{status}));if(status===200)await f.make().revoke('MOCK-REFRESH');else await assert.rejects(f.make().revoke('MOCK-REFRESH'));assert.equal(f.calls.length,1);assert.equal(f.calls[0].url,'https://oauth2.googleapis.com/revoke');assert.equal(new URLSearchParams(f.calls[0].init.body as string).get('token'),'MOCK-REFRESH');}});
test('CA03 Google: adapter cannot be called through unjournaled compatibility authorization or refresh',async()=>{const f=fixture(),j=job(),state='a'.repeat(64);const {createHash}=await import('node:crypto');j.state_hash=createHash('sha256').update(state).digest('hex') as never;const ports:CreatorYouTubePorts={owner:async()=>({id:j.id}),server:async()=>j,provider:f.make()};const k=new kernel.CreatorYouTubeKernel(ports,true);await assert.rejects(k.authorize(j.id,state,'MOCK',context));j.kind='refresh' as never;j.credentials={access_token:'MOCK',refresh_token:'MOCK',expires_at:new Date(now+3600000).toISOString()} as never;await assert.rejects(k.refreshPrepared(j.id));assert.equal(f.calls.length,0);});
