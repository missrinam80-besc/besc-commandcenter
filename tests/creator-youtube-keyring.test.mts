import test,{afterEach} from 'node:test';
import assert from 'node:assert/strict';
import {fork} from 'node:child_process';
import {randomBytes,randomUUID} from 'node:crypto';
import {mkdtemp,readdir,readFile,rename,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import path from 'node:path';
import {loadCreatorModule} from './helpers/creator-youtube-local-modules.mjs';
import type {CreatorYouTubeKernel} from '../src/lib/creator-youtube-kernel.ts';
const {CreatorYouTubeFileStore}=loadCreatorModule('creator-youtube-file-store.ts') as typeof import('../src/lib/creator-youtube-file-store.ts');
const {CreatorYouTubeKeyring}=loadCreatorModule('creator-youtube-keyring.ts') as typeof import('../src/lib/creator-youtube-keyring.ts');
const {CreatorYouTubeOAuthAttempt}=loadCreatorModule('creator-youtube-oauth-attempt.ts') as typeof import('../src/lib/creator-youtube-oauth-attempt.ts');
const roots:string[]=[];
async function directory(){const root=await mkdtemp(path.join(tmpdir(),'besc-ca03-keyring-'));roots.push(root);return root;}
afterEach(async()=>{for(const root of roots.splice(0)){assert.equal(path.dirname(path.resolve(root)),path.resolve(tmpdir()));assert(path.basename(root).startsWith('besc-ca03-keyring-'));await rm(root,{recursive:true,force:true});}});
function worker(config:Record<string,unknown>){
 const child=fork(new URL('./helpers/creator-youtube-keyring-worker.mjs',import.meta.url),[],{stdio:['ignore','pipe','pipe','ipc'],env:{NODE_ENV:'test',SystemRoot:process.env.SystemRoot,TEMP:process.env.TEMP,TMP:process.env.TMP,PATH:process.env.PATH}});
 const messages:Record<string,unknown>[]=[],waiting:{resolve:(v:Record<string,unknown>)=>void;reject:(e:Error)=>void}[]=[];
 let exited=false;const exit=new Promise<void>(resolve=>child.once('exit',()=>{exited=true;for(const pending of waiting.splice(0))pending.reject(Error('Keyring fixture exited'));resolve();}));
 child.on('message',(message:Record<string,unknown>)=>{const pending=waiting.shift();if(pending)pending.resolve(message);else messages.push(message);});
 child.on('error',error=>{for(const pending of waiting.splice(0))pending.reject(error);});child.send(config);
 return{child,exit,next:()=>new Promise<Record<string,unknown>>((resolve,reject)=>{const message=messages.shift();if(message)resolve(message);else if(exited)reject(Error('Keyring fixture exited'));else waiting.push({resolve,reject});}),kill:async()=>{child.kill('SIGKILL');await exit;}};
}
async function fixture(legacy?:Uint8Array){
 const root=await directory(),keyRoot=path.join(root,'keys'),attemptRoot=path.join(root,'attempts'),wrappingKey=randomBytes(32),ringId=randomUUID();
 const keyStore=await CreatorYouTubeFileStore.create(keyRoot),attemptStore=await CreatorYouTubeFileStore.create(attemptRoot);
 const ring=await CreatorYouTubeKeyring.initialize(keyStore,wrappingKey,ringId,legacy);
 let began=0,exchanges=0,withdrawals=0,now=Date.now();
 const principal={organizationId:randomUUID(),userId:randomUUID(),sessionId:randomUUID()},id=randomUUID(),link=randomUUID(),state=randomBytes(32).toString('hex');
 const kernel:Pick<CreatorYouTubeKernel,'beginAuthorization'|'authorize'|'withdraw'>={beginAuthorization:async()=>{began++;return{jobId:id,state};},authorize:async()=>{exchanges++;},withdraw:async()=>{withdrawals++;return{local:true,provider:'complete'};}};
 const make=(cipher:Awaited<ReturnType<typeof CreatorYouTubeKeyring.open>>|Uint8Array=ring)=>new CreatorYouTubeOAuthAttempt({store:attemptStore,kernel,principal:async()=>principal,now:()=>now},cipher,'https://fixture.invalid/youtube/callback',true);
 const reopen=()=>CreatorYouTubeKeyring.open(keyStore,wrappingKey,ringId);
 return{root,keyRoot,attemptRoot,keyStore,attemptStore,wrappingKey,ringId,ring,kernel,id,link,state,principal,make,reopen,began:()=>began,exchanges:()=>exchanges,withdrawals:()=>withdrawals,setNow:(n:number)=>{now=n;},now:()=>now,config:()=>({keyRoot,attemptRoot,wrappingKey:wrappingKey.toString('base64url'),ringId,id,link,state,principal,now})};
}
function envelope(sealed:string){const bytes=Buffer.from(sealed,'base64url');assert.equal(bytes.subarray(0,8).toString(),'BESCYT02');return JSON.parse(bytes.subarray(8).toString());}
function changeEnvelope(sealed:string,change:Record<string,unknown>){return Buffer.concat([Buffer.from('BESCYT02'),Buffer.from(JSON.stringify({...envelope(sealed),...change}))]).toString('base64url');}

test('CA03 keyring: initialization is explicit, reopening survives restart and metadata contains no material',async()=>{const f=await fixture(),description=await f.ring.describe(),reopened=await f.reopen();assert.equal((await reopened.describe()).activeKeyId,description.activeKeyId);assert.equal(description.readableKeyIds.length,1);assert.equal(description.legacyReadable,false);assert(!JSON.stringify(description).includes('material'));assert(!JSON.stringify(f.ring).includes(f.wrappingKey.toString('base64url')));await assert.rejects(CreatorYouTubeKeyring.initialize(f.keyStore,f.wrappingKey,f.ringId),/unavailable/);assert.equal((await f.ring.describe()).revision,1);});
test('CA03 keyring: missing ring never initializes replacement or touches an existing request',async()=>{const f=await fixture(),r=await f.make().begin(f.link),before=await f.attemptStore.read(r.jobId);await rename(path.join(f.keyRoot,f.ringId),path.join(f.keyRoot,'fixture-backup'));await assert.rejects(f.reopen(),/unavailable/);await assert.rejects(f.make().callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal(f.exchanges(),0);assert.equal(f.withdrawals(),0);assert.deepEqual(await f.attemptStore.read(r.jobId),before);assert.equal(await f.keyStore.read(f.ringId),null);});
test('CA03 keyring: missing/wrong wrapping key rejects without generating keys or provider activity',async()=>{const f=await fixture(),before=await f.keyStore.read(f.ringId);for(const key of [undefined,randomBytes(31),randomBytes(32)])await assert.rejects(CreatorYouTubeKeyring.open(f.keyStore,key as Uint8Array,f.ringId),/unavailable/);assert.deepEqual(await f.keyStore.read(f.ringId),before);assert.equal(f.began(),0);assert.equal(f.exchanges(),0);});
test('CA03 keyring: previously opened coordinator rechecks a missing keyring before beginning a new job',async()=>{const f=await fixture(),flow=f.make();await rename(path.join(f.keyRoot,f.ringId),path.join(f.keyRoot,'fixture-backup'));await assert.rejects(flow.begin(f.link),/not_confirmed/);assert.equal(f.began(),0);assert.equal(await f.attemptStore.read(f.id),null);});
test('CA03 keyring: rotation writes a new key ID and old ciphertext stays readable after reopen',async()=>{const f=await fixture(),id=randomUUID(),old=await f.ring.seal(id,1,'TESTFIXTURE OLD'),oldKey=envelope(old).keyId;const rotated=await f.ring.rotate(randomUUID());assert.notEqual(rotated.activeKeyId,oldKey);const next=await f.ring.seal(id,2,'TESTFIXTURE NEW');assert.equal(envelope(next).keyId,rotated.activeKeyId);const ring=await f.reopen();assert.equal(await ring.open(id,1,old),'TESTFIXTURE OLD');assert.equal(await ring.open(id,2,next),'TESTFIXTURE NEW');assert.equal((await ring.describe()).readableKeyIds.length,2);});
test('CA03 keyring: cached coordinator selects the current active key on its next write',async()=>{const f=await fixture(),cached=f.make(),r=await cached.begin(f.link),before=await f.attemptStore.read(r.jobId),old=envelope(before!.sealed).keyId;const rotated=await(await f.reopen()).rotate(randomUUID());assert.notEqual(rotated.activeKeyId,old);assert.equal((await cached.callback({...r,code:'MOCK-CODE'})).status,'completed');const record=await f.attemptStore.read(r.jobId);assert.equal(envelope(record!.sealed).keyId,rotated.activeKeyId);assert.equal(f.exchanges(),1);});
test('CA03 keyring: rotating while authorization runs preserves binding and completes using the new active key',async()=>{const f=await fixture(),flow=f.make(),r=await flow.begin(f.link);let active='';f.kernel.authorize=async()=>{active=(await f.ring.rotate(randomUUID())).activeKeyId;};assert.equal((await flow.callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal(envelope((await f.attemptStore.read(r.jobId))!.sealed).keyId,active);});
test('CA03 keyring: rotation is idempotent and replay never reactivates an older key',async()=>{const f=await fixture(),a=randomUUID(),first=await f.ring.rotate(a),second=await f.ring.rotate(randomUUID()),replay=await(await f.reopen()).rotate(a);assert.equal(replay.keyId,first.keyId);assert.equal(replay.activeKeyId,second.activeKeyId);assert.equal(replay.replay,true);assert.equal(replay.revision,3);});
test('CA03 keyring: simultaneous processes with same rotation ID commit exactly one new key',async()=>{const f=await fixture(),requestId=randomUUID(),workers=Array.from({length:4},()=>worker({...f.config(),mode:'rotate',requestId}));try{for(const w of workers)assert.equal((await w.next()).armed,true);for(const w of workers)w.child.send({go:true});const results=await Promise.all(workers.map(w=>w.next()));assert(results.every(r=>!r.error));assert.equal(new Set(results.map(r=>(r.result as {keyId:string}).keyId)).size,1);assert.equal(results.filter(r=>(r.result as {replay:boolean}).replay===false).length,1);await Promise.all(workers.map(w=>w.exit));}finally{await Promise.all(workers.map(w=>w.kill()));}assert.equal((await f.ring.describe()).revision,2);assert.equal((await f.ring.describe()).readableKeyIds.length,2);});
test('CA03 keyring: different simultaneous rotations retain both old and new readable keys',async()=>{const f=await fixture(),id=randomUUID(),old=await f.ring.seal(id,1,'TESTFIXTURE BEFORE'),workers=Array.from({length:2},()=>worker({...f.config(),mode:'rotate',requestId:randomUUID()}));try{for(const w of workers)assert.equal((await w.next()).armed,true);for(const w of workers)w.child.send({go:true});const results=await Promise.all(workers.map(w=>w.next()));assert(results.every(r=>!r.error));assert.equal(new Set(results.map(r=>(r.result as {keyId:string}).keyId)).size,2);await Promise.all(workers.map(w=>w.exit));}finally{await Promise.all(workers.map(w=>w.kill()));}assert.equal((await f.ring.describe()).readableKeyIds.length,3);assert.equal(await f.ring.open(id,1,old),'TESTFIXTURE BEFORE');});
test('CA03 keyring: termination before publishing rotation preserves old key and allows explicit retry',async()=>{const f=await fixture(),id=randomUUID(),old=await f.ring.seal(id,1,'TESTFIXTURE BEFORE'),requestId=randomUUID(),w=worker({...f.config(),mode:'rotate_pre_crash',requestId});try{assert.equal((await w.next()).paused,'before_rotation_publish');}finally{await w.kill();}const ring=await f.reopen();assert.equal((await ring.describe()).revision,1);assert.equal(await ring.open(id,1,old),'TESTFIXTURE BEFORE');assert.equal((await ring.rotate(requestId)).replay,false);});
test('CA03 keyring: termination after publication preserves rotation; same request retries without new key',async()=>{const f=await fixture(),id=randomUUID(),old=await f.ring.seal(id,1,'TESTFIXTURE BEFORE'),requestId=randomUUID(),w=worker({...f.config(),mode:'rotate_post_crash',requestId});try{assert.equal((await w.next()).paused,'after_rotation_publish');}finally{await w.kill();}const ring=await f.reopen(),replay=await ring.rotate(requestId);assert.equal(replay.replay,true);assert.equal(replay.revision,2);assert.equal((await ring.describe()).readableKeyIds.length,2);assert.equal(await ring.open(id,1,old),'TESTFIXTURE BEFORE');});
test('CA03 keyring: request begun in another process stays readable after that process exits and key rotates',async()=>{const f=await fixture(),w=worker({...f.config(),mode:'begin'});const message=await w.next();await w.exit;assert(!message.error);const r=message.result as {jobId:string;state:string;browserNonce:string};await f.ring.rotate(randomUUID());assert.equal((await f.make(await f.reopen()).callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal(f.exchanges(),1);});
test('CA03 keyring: legacy requests require explicitly imported old key and upgrade on next authorized write',async()=>{const legacy=randomBytes(32),f=await fixture(legacy),r=await f.make(legacy).begin(f.link),old=(await f.attemptStore.read(r.jobId))!.sealed;assert.notEqual(Buffer.from(old,'base64url').subarray(0,8).toString(),'BESCYT02');const rotated=await f.ring.rotate(randomUUID());assert.equal((await f.make(await f.reopen()).callback({...r,code:'MOCK-CODE'})).status,'completed');assert.equal(envelope((await f.attemptStore.read(r.jobId))!.sealed).keyId,rotated.activeKeyId);assert.equal((await f.ring.describe()).legacyReadable,true);});
test('CA03 keyring: no implicit legacy fallback when previous key was not imported',async()=>{const f=await fixture(),legacy=randomBytes(32),r=await f.make(legacy).begin(f.link),before=await f.attemptStore.read(r.jobId);await assert.rejects(f.make().callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal(f.exchanges(),0);assert.deepEqual(await f.attemptStore.read(r.jobId),before);});
test('CA03 keyring: absent old data key rejects existing request without overwriting it',async()=>{const f=await fixture(),r=await f.make().begin(f.link),before=await f.attemptStore.read(r.jobId),otherRoot=path.join(f.root,'empty-replacement');const replacement=await CreatorYouTubeKeyring.initialize(await CreatorYouTubeFileStore.create(otherRoot),f.wrappingKey,f.ringId);await assert.rejects(f.make(replacement).callback({...r,code:'MOCK-CODE'}),/not_confirmed/);assert.equal(f.exchanges(),0);assert.equal(f.withdrawals(),0);assert.deepEqual(await f.attemptStore.read(r.jobId),before);});
test('CA03 keyring: cipher key ID, content, attempt ID, revision and ring context are authenticated',async()=>{const f=await fixture(),id=randomUUID(),sealed=await f.ring.seal(id,1,'TESTFIXTURE PRIVATE');const oldKey=envelope(sealed).keyId;const rotated=await f.ring.rotate(randomUUID());for(const changed of [changeEnvelope(sealed,{keyId:rotated.activeKeyId}),changeEnvelope(sealed,{keyId:randomUUID()}),changeEnvelope(sealed,{ciphertext:'A'.repeat(16)})])await assert.rejects(f.ring.open(id,1,changed),/unavailable/);assert.notEqual(oldKey,rotated.activeKeyId);await assert.rejects(f.ring.open(randomUUID(),1,sealed),/unavailable/);await assert.rejects(f.ring.open(id,2,sealed),/unavailable/);const another=await CreatorYouTubeKeyring.initialize(f.keyStore,f.wrappingKey,randomUUID());await assert.rejects(another.open(id,1,sealed),/unavailable/);});
test('CA03 keyring: neither wrapping key nor imported data key appears in files or metadata',async()=>{const legacy=randomBytes(32),f=await fixture(legacy),r=await f.make().begin(f.link);await f.ring.rotate(randomUUID());await f.make().callback({...r,code:'MOCK-CODE'});const contents:string[]=[];for(const [root,id]of [[f.keyRoot,f.ringId],[f.attemptRoot,f.id]])for(const name of await readdir(path.join(root,id)))contents.push(await readFile(path.join(root,id,name),'utf8'));const raw=contents.join('')+JSON.stringify(await f.ring.describe())+JSON.stringify(f.ring);for(const secret of [f.wrappingKey.toString('base64url'),legacy.toString('base64url'),r.state,r.browserNonce,'MOCK-CODE',f.principal.userId])assert(!raw.includes(secret));});
test('CA03 keyring: wrapped keyring tampering fails closed and cannot be silently overwritten',async()=>{const f=await fixture(),record=(await f.keyStore.read(f.ringId))!,bytes=Buffer.from(record.sealed,'base64url');bytes[30]^=1;assert(await f.keyStore.compareAndSwap(f.ringId,1,{revision:2,sealed:bytes.toString('base64url')}));const before=await f.keyStore.read(f.ringId);await assert.rejects(f.reopen(),/unavailable/);await assert.rejects(f.ring.rotate(randomUUID()),/unavailable/);assert.deepEqual(await f.keyStore.read(f.ringId),before);});
test('CA03 keyring: cleanup pending before rotation can be resumed with a fresh keyring',async()=>{const f=await fixture(),flow=f.make(),r=await flow.begin(f.link);f.kernel.withdraw=async()=>({local:true,provider:'pending'});assert.equal((await flow.cancel(r.jobId,r.browserNonce)).provider,'pending');await f.ring.rotate(randomUUID());f.kernel.withdraw=async()=>({local:true,provider:'complete'});assert.equal((await f.make(await f.reopen()).recover(r.jobId,r.browserNonce)).status,'recovered');assert.equal(f.exchanges(),0);});
test('CA03 keyring: key limit fails closed without destroying any earlier readable key',async()=>{const f=await fixture(),id=randomUUID(),old=await f.ring.seal(id,1,'TESTFIXTURE FIRST');for(let i=1;i<32;i++)await f.ring.rotate(randomUUID());await assert.rejects(f.ring.rotate(randomUUID()),/unavailable/);assert.equal((await f.ring.describe()).readableKeyIds.length,32);assert.equal(await f.ring.open(id,1,old),'TESTFIXTURE FIRST');});
